{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/source-domain.schema.json",
  "title": "Cross-cutting source and rulebook objects",
  "$defs": {
    "registered_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "registered_source_id", "created_at", "jurisdiction", "material_family", "owner_ref", "policy_state", "intended_uses", "fact_authorities", "endpoint_refs", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.registered-source"},
        "schema_version": {"const": "1.0.0"},
        "registered_source_id": {"type": "string", "pattern": "^src_[0-9a-f]{48}$"},
        "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "jurisdiction": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "material_family": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "owner_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "policy_state": {"type": "string", "enum": ["CONFIGURED", "DISABLED", "UNDECIDED"]},
        "intended_uses": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "fact_authorities": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "endpoint_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "immutable": {"const": true}
      }
    },
    "source_endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "source_endpoint_id", "created_at", "source_ref", "endpoint_kind", "locator", "connector_contract_ref", "policy_state", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.source-endpoint"},
        "schema_version": {"const": "1.0.0"},
        "source_endpoint_id": {"type": "string", "pattern": "^sep_[0-9a-f]{48}$"},
        "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "source_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "endpoint_kind": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "locator": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "connector_contract_ref": {"$ref": "common.schema.json#/$defs/contract_reference"},
        "policy_state": {"type": "string", "enum": ["CONFIGURED", "DISABLED", "UNDECIDED"]},
        "immutable": {"const": true}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "observation_id", "observed_at", "observation_cutoff", "source_ref", "endpoint_ref", "result_code", "snapshot_refs", "failure_codes", "reason_codes", "idempotency", "external_effects", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.observation"},
        "schema_version": {"const": "1.0.0"},
        "observation_id": {"type": "string", "pattern": "^obs_[0-9a-f]{48}$"},
        "observed_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "observation_cutoff": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "source_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "endpoint_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "result_code": {"$ref": "common.schema.json#/$defs/result_code"},
        "snapshot_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "failure_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/failure_code"}},
        "reason_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reason_code"}},
        "idempotency": {"$ref": "common.schema.json#/$defs/idempotency_binding"},
        "external_effects": {"const": "NONE"},
        "immutable": {"const": true}
      }
    },
    "source_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "source_snapshot_id", "captured_at", "source_ref", "observation_ref", "artifacts", "snapshot_fingerprint", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.source-snapshot"},
        "schema_version": {"const": "1.0.0"},
        "source_snapshot_id": {"type": "string", "pattern": "^snp_[0-9a-f]{48}$"},
        "captured_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "source_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "artifacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/artifact_inventory_entry"}},
        "snapshot_fingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
        "immutable": {"const": true}
      }
    },
    "connector_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "pipeline_run_ref", "work_item_ref", "observation_ref", "observation_cutoff", "source_ref", "source_version", "endpoint_ref", "endpoint_version", "rulebook_ref", "rulebook_version", "previous_observation_ref", "previous_snapshot_ref", "method", "allowed_host", "allowed_path_prefix", "redirect_hosts", "authentication_class", "media_types", "max_bytes", "max_pages", "max_items", "time_budget_seconds", "complete_inventory_required", "required_capture_roles", "retry_profile", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.connector-request"},
        "schema_version": {"const": "1.0.0"},
        "pipeline_run_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "work_item_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "observation_cutoff": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "source_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "source_version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "endpoint_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "endpoint_version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "rulebook_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "rulebook_version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "previous_observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "previous_snapshot_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "method": {"type": "string", "enum": ["GET", "HEAD"]},
        "allowed_host": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "allowed_path_prefix": {"type": "string", "pattern": "^/[^\\s]*$"},
        "redirect_hosts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "authentication_class": {"type": "string", "enum": ["MANAGED_SECRET", "NONE"]},
        "media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "max_bytes": {"type": "integer", "minimum": 1},
        "max_pages": {"type": "integer", "minimum": 1},
        "max_items": {"type": "integer", "minimum": 1},
        "time_budget_seconds": {"type": "integer", "minimum": 1},
        "complete_inventory_required": {"type": "boolean"},
        "required_capture_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "retry_profile": {"$ref": "#/$defs/retry_profile"},
        "immutable": {"const": true}
      }
    },
    "retry_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_ceiling", "max_elapsed_seconds", "backoff_seconds", "jitter_seed", "honor_retry_after"],
      "properties": {
        "attempt_ceiling": {"type": "integer", "minimum": 1},
        "max_elapsed_seconds": {"type": "integer", "minimum": 1},
        "backoff_seconds": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "jitter_seed": {"type": "integer"},
        "honor_retry_after": {"type": "boolean"}
      }
    },
    "watcher_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "observation_ref", "result_code", "affected_boundary", "attempt_count", "attempt_evidence_refs", "downstream_effects", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.watcher-result"},
        "schema_version": {"const": "1.0.0"},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "result_code": {"type": "string", "enum": ["INCOMPLETE_OBSERVATION", "POSSIBLE_CHANGE", "SOURCE_CONTRACT_CHANGED", "SOURCE_UNAVAILABLE", "SUPPORTED_NO_CHANGE", "UNSAFE_RESPONSE"]},
        "affected_boundary": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "attempt_count": {"type": "integer", "minimum": 1},
        "attempt_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "downstream_effects": {"const": "NONE"},
        "immutable": {"const": true}
      }
    },
    "scraper_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "observation_ref", "result_code", "member_ids", "cursors", "declared_total", "restart_count", "attempt_count", "attempt_evidence_refs", "evidence_package_ref", "downstream_effects", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.scraper-result"},
        "schema_version": {"const": "1.0.0"},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "result_code": {"type": "string", "enum": ["PARTIAL_CAPTURE", "SNAPSHOT_PRESERVED", "SOURCE_CONTRACT_CHANGED", "SOURCE_UNAVAILABLE", "SUPPORTED_NO_CHANGE_AFTER_CAPTURE", "UNSAFE_RESPONSE"]},
        "member_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "cursors": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "declared_total": {"type": "integer", "minimum": 0},
        "restart_count": {"type": "integer", "minimum": 0},
        "attempt_count": {"type": "integer", "minimum": 1},
        "attempt_evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "evidence_package_ref": {"anyOf": [{"$ref": "common.schema.json#/$defs/reference"}, {"type": "null"}]},
        "downstream_effects": {"const": "NONE"},
        "immutable": {"const": true}
      }
    },
    "vault_object_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vault_role", "logical_key", "version_id", "fingerprint", "byte_length", "read_back_verified", "retention_profile_ref"],
      "properties": {
        "vault_role": {"type": "string", "enum": ["PRIMARY", "RECOVERY"]},
        "logical_key": {"type": "string", "pattern": "^(objects/sha256/[0-9a-f]{2}/[0-9a-f]{62}|packages/[a-z0-9][a-z0-9._-]{0,127}/[a-z][a-z0-9]{2}_[0-9a-f]{48}/[0-9a-f]{64}\\.json)$"},
        "version_id": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "fingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
        "byte_length": {"type": "integer", "minimum": 0},
        "read_back_verified": {"const": true},
        "retention_profile_ref": {"$ref": "common.schema.json#/$defs/reference"}
      }
    },
    "transport_metadata_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^(?!authorization$|cookie$|proxy-authorization$|set-cookie$)[a-z0-9-]+$"},
        "value": {"type": "string"}
      }
    },
    "evidence_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "artifact_id", "artifact_version_id", "artifact_class", "source_ref", "observation_ref", "observation_cutoff", "acquired_at", "acquisition_method", "source_locator", "declared_media_type", "detected_media_type", "content_encoding", "character_encoding", "transport_metadata", "fingerprint", "byte_length", "primary_receipt", "recovery_receipt", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.evidence-object"},
        "schema_version": {"const": "1.0.0"},
        "artifact_id": {"type": "string", "pattern": "^art_[0-9a-f]{48}$"},
        "artifact_version_id": {"type": "string", "pattern": "^evi_[0-9a-f]{48}$"},
        "artifact_class": {"type": "string", "enum": ["ACQUISITION_ATTEMPT", "HOSTILE_ISOLATED", "PACKAGE_MANIFEST", "SOURCE_CONTENT", "SOURCE_METADATA"]},
        "source_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "observation_cutoff": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "acquired_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "acquisition_method": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "source_locator": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "declared_media_type": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "detected_media_type": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "content_encoding": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "character_encoding": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "transport_metadata": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/transport_metadata_entry"}},
        "fingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
        "byte_length": {"type": "integer", "minimum": 0},
        "primary_receipt": {"$ref": "#/$defs/vault_object_receipt"},
        "recovery_receipt": {"$ref": "#/$defs/vault_object_receipt"},
        "immutable": {"const": true}
      }
    },
    "evidence_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "package_id", "package_kind", "observation_ref", "artifact_refs", "manifest_fingerprint", "primary_manifest_receipt", "recovery_manifest_receipt", "complete", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.evidence-package"},
        "schema_version": {"const": "1.0.0"},
        "package_id": {"type": "string", "pattern": "^pkg_[0-9a-f]{48}$"},
        "package_kind": {"type": "string", "enum": ["ACQUISITION_ATTEMPT", "SOURCE_SNAPSHOT"]},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "artifact_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "manifest_fingerprint": {"$ref": "common.schema.json#/$defs/fingerprint"},
        "primary_manifest_receipt": {"$ref": "#/$defs/vault_object_receipt"},
        "recovery_manifest_receipt": {"$ref": "#/$defs/vault_object_receipt"},
        "complete": {"const": true},
        "immutable": {"const": true}
      }
    },
    "acquisition_outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "observation_ref", "watcher_result_ref", "scraper_result_ref", "evidence_package_ref", "source_snapshot_ref", "issue_ref", "disposition", "downstream_authorization", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.acquisition-outcome"},
        "schema_version": {"const": "1.0.0"},
        "observation_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "watcher_result_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "scraper_result_ref": {"anyOf": [{"$ref": "common.schema.json#/$defs/reference"}, {"type": "null"}]},
        "evidence_package_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "source_snapshot_ref": {"anyOf": [{"$ref": "common.schema.json#/$defs/reference"}, {"type": "null"}]},
        "issue_ref": {"anyOf": [{"$ref": "common.schema.json#/$defs/reference"}, {"type": "null"}]},
        "disposition": {"type": "string", "enum": ["COMPLETE_NO_CHANGE", "COVERAGE_GAP", "QUARANTINE", "SNAPSHOT_PRESERVED", "SOURCE_CONTRACT_REVIEW"]},
        "downstream_authorization": {"type": "string", "enum": ["LEGAL_PROCESSING_ELIGIBLE", "NONE"]},
        "immutable": {"const": true}
      }
    },
    "source_contract_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "source_contract_review_id", "opened_at", "source_ref", "evidence_refs", "state", "review_code", "unresolved_questions", "resolution_refs", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.source-contract-review"},
        "schema_version": {"const": "1.0.0"},
        "source_contract_review_id": {"type": "string", "pattern": "^scr_[0-9a-f]{48}$"},
        "opened_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "source_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "state": {"type": "string", "enum": ["OPEN", "RESOLVED_CHANGED", "RESOLVED_SUPPORTED", "RESOLVED_UNSUPPORTED", "SUPERSEDED"]},
        "review_code": {"$ref": "common.schema.json#/$defs/review_code"},
        "unresolved_questions": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/non_empty_string"}},
        "resolution_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "immutable": {"const": true}
      }
    },
    "source_rulebook_package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "source_rulebook_package_id", "package_version", "created_at", "effective_observation_cutoff", "jurisdiction", "material_family", "legal_desk_owner_ref", "release_scope_readiness", "contracts", "files", "impact_declaration_ref", "unresolved_policy_codes", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.source-rulebook-package"},
        "schema_version": {"const": "1.0.0"},
        "source_rulebook_package_id": {"type": "string", "pattern": "^rbp_[0-9a-f]{48}$"},
        "package_version": {"$ref": "common.schema.json#/$defs/schema_version"},
        "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "effective_observation_cutoff": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "jurisdiction": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "material_family": {"$ref": "common.schema.json#/$defs/non_empty_string"},
        "legal_desk_owner_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "release_scope_readiness": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/release_scope_readiness"}},
        "contracts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/contract_reference"}},
        "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/artifact_inventory_entry"}},
        "impact_declaration_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "unresolved_policy_codes": {"type": "array", "uniqueItems": true, "items": {"const": "POLICY_UNDECIDED"}},
        "immutable": {"const": true}
      }
    },
    "release_scope_readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_scope_ref", "state", "blocker_refs"],
      "properties": {
        "release_scope_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "state": {"type": "string", "enum": ["DECISION_READY", "NOT_READY"]},
        "blocker_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}}
      }
    },
    "rulebook_conformance_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "attestation_id", "created_at", "rulebook_ref", "build_ref", "suite_refs", "result_code", "failure_codes", "reproducible", "attester_refs", "external_effects", "immutable"],
      "properties": {
        "schema_id": {"const": "asklegal.rulebook-conformance-attestation"},
        "schema_version": {"const": "1.0.0"},
        "attestation_id": {"type": "string", "pattern": "^rba_[0-9a-f]{48}$"},
        "created_at": {"$ref": "common.schema.json#/$defs/utc_timestamp"},
        "rulebook_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "build_ref": {"$ref": "common.schema.json#/$defs/reference"},
        "suite_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "result_code": {"$ref": "common.schema.json#/$defs/result_code"},
        "failure_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/failure_code"}},
        "reproducible": {"type": "boolean"},
        "attester_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/reference"}},
        "external_effects": {"const": "NONE"},
        "immutable": {"const": true}
      }
    }
  }
}
