      "severity": "HIGH",
      "subjects": ["sql-server"],
      "statement": "Replacing the credential file and restarting does not rotate the SA password; the old value continues to authenticate and the service reports no error",
      "required_procedure": "ALTER_LOGIN_IN_DATABASE",
      "procedure_proved": true
    },
    {
      "finding_id": "CREDENTIAL_FILE_REQUIRES_MATCHING_CONTAINER_UID",
      "severity": "MEDIUM",
      "subjects": ["sql-server", "vault-primary", "vault-recovery"],
      "statement": "The delivered credential file is mode 0400 owned by the systemd service account, so the container process must run under the same numeric UID to read it",
      "required_procedure": "ALIGN_HOST_AND_CONTAINER_UID",
      "procedure_proved": false
    }
