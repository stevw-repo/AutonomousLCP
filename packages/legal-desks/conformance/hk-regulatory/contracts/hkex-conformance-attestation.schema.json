{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-conformance-attestation.schema.json",
  "title": "External HKEX Regulatory Rulebook Conformance Attestation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "attestation_id",
    "attestation_kind",
    "jurisdiction",
    "material_family",
    "rule_id",
    "evidence",
    "final_result",
    "capability_claims",
    "real_source_evaluation",
    "source_access_authorized",
    "release_creation_authorized",
    "approval_authorized",
    "pinecone_authorized",
    "deployment_authorized",
    "activation_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.conformance-attestation"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "attestation_id": {
      "type": "string",
      "pattern": "^rba_[0-9a-f]{48}$"
    },
    "attestation_kind": {
      "const": "REGULATORY_RULEBOOK_CONFORMANCE"
    },
    "jurisdiction": {
      "const": "HK"
    },
    "material_family": {
      "const": "REGULATORY_MATERIALS"
    },
    "rule_id": {
      "const": "HKREG-CONFORMANCE-ATTESTATION-001"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulebook_package",
        "suite",
        "processing_build",
        "dependency_lock",
        "conformance_runner",
        "contract_set",
        "contract_set_fingerprint",
        "case_results",
        "reproducibility",
        "architecture"
      ],
      "properties": {
        "rulebook_package": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "package_id",
            "package_version",
            "package_fingerprint"
          ],
          "properties": {
            "package_id": {
              "type": "string",
              "minLength": 1
            },
            "package_version": {
              "type": "string",
              "minLength": 1
            },
            "package_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "suite": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "universe",
            "universe_fingerprint",
            "case_count",
            "coverage_cell_count",
            "pair_count"
          ],
          "properties": {
            "universe": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "byte_size",
                "fingerprint"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                },
                "byte_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "universe_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "case_count": {
              "const": 284
            },
            "coverage_cell_count": {
              "const": 284
            },
            "pair_count": {
              "const": 57
            }
          }
        },
        "processing_build": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "members",
            "inventory_fingerprint"
          ],
          "properties": {
            "members": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "byte_size",
                  "fingerprint"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                  },
                  "byte_size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "fingerprint": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            },
            "inventory_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "dependency_lock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byte_size",
            "fingerprint"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "conformance_runner": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byte_size",
            "fingerprint"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "contract_set": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "byte_size",
            "fingerprint"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
            },
            "byte_size": {
              "type": "integer",
              "minimum": 1
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "contract_set_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "case_results": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "case_count",
            "members",
            "result_set_fingerprint"
          ],
          "properties": {
            "case_count": {
              "const": 284
            },
            "members": {
              "type": "array",
              "minItems": 284,
              "maxItems": 284,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "case_id",
                  "result"
                ],
                "properties": {
                  "case_id": {
                    "type": "string",
                    "pattern": "^HKREG-(?:DEC|DET)-[A-Z]{3}-[0-9]{3}$"
                  },
                  "result": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "path",
                      "byte_size",
                      "fingerprint"
                    ],
                    "properties": {
                      "path": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                      },
                      "byte_size": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "fingerprint": {
                        "type": "string",
                        "pattern": "^sha256:[0-9a-f]{64}$"
                      }
                    }
                  }
                }
              }
            },
            "result_set_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "reproducibility": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "isolated_run_count",
            "runs",
            "byte_identical"
          ],
          "properties": {
            "isolated_run_count": {
              "const": 2
            },
            "runs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "prefixItems": [
                {
                  "allOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "run_id",
                        "case_count",
                        "result_set_fingerprint",
                        "tree_fingerprint"
                      ],
                      "properties": {
                        "run_id": {
                          "enum": [
                            "ISOLATED_RUN_1",
                            "ISOLATED_RUN_2"
                          ]
                        },
                        "case_count": {
                          "const": 284
                        },
                        "result_set_fingerprint": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "tree_fingerprint": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      }
                    },
                    {
                      "properties": {
                        "run_id": {
                          "const": "ISOLATED_RUN_1"
                        }
                      }
                    }
                  ]
                },
                {
                  "allOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "run_id",
                        "case_count",
                        "result_set_fingerprint",
                        "tree_fingerprint"
                      ],
                      "properties": {
                        "run_id": {
                          "enum": [
                            "ISOLATED_RUN_1",
                            "ISOLATED_RUN_2"
                          ]
                        },
                        "case_count": {
                          "const": 284
                        },
                        "result_set_fingerprint": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        },
                        "tree_fingerprint": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      }
                    },
                    {
                      "properties": {
                        "run_id": {
                          "const": "ISOLATED_RUN_2"
                        }
                      }
                    }
                  ]
                }
              ],
              "items": false
            },
            "byte_identical": {
              "const": true
            }
          }
        },
        "architecture": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool",
            "policy",
            "applications",
            "packages",
            "dependency_edges",
            "capability_ports",
            "policy_fingerprint",
            "report_fingerprint",
            "result"
          ],
          "properties": {
            "tool": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "byte_size",
                "fingerprint"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                },
                "byte_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "policy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "byte_size",
                "fingerprint"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
                },
                "byte_size": {
                  "type": "integer",
                  "minimum": 1
                },
                "fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              }
            },
            "applications": {
              "type": "integer",
              "minimum": 1
            },
            "packages": {
              "type": "integer",
              "minimum": 1
            },
            "dependency_edges": {
              "type": "integer",
              "minimum": 1
            },
            "capability_ports": {
              "type": "integer",
              "minimum": 1
            },
            "policy_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "report_fingerprint": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "result": {
              "const": "PASS"
            }
          }
        }
      }
    },
    "final_result": {
      "const": "PASS"
    },
    "capability_claims": {
      "const": [
        "BUILD_COMPATIBILITY"
      ]
    },
    "real_source_evaluation": {
      "const": false
    },
    "source_access_authorized": {
      "const": false
    },
    "release_creation_authorized": {
      "const": false
    },
    "approval_authorized": {
      "const": false
    },
    "pinecone_authorized": {
      "const": false
    },
    "deployment_authorized": {
      "const": false
    },
    "activation_authorized": {
      "const": false
    },
    "external_effects": {
      "const": "NONE"
    }
  }
}
