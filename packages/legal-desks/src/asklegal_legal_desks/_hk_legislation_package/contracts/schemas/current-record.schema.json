{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://contracts.asklegal.local/v1/hk-legislation-current-record.schema.json",
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "scope_id":{"const":"rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95"},
    "record_id":{"type":"string","pattern":"^rec_[0-9a-f]{48}$"},
    "legal_disposition":{"enum":["SEARCHABLE_CURRENT","WAITING_ROOM","EVIDENCE_ONLY","HISTORICAL","QUARANTINE"]},
    "metadata":{"type":"object","additionalProperties":false,"required":["text","country","jurisdiction","type","source","authority_note"],"properties":{"text":{"type":"string","minLength":1},"country":{"const":"Hong Kong"},"jurisdiction":{"const":"Hong Kong"},"type":{"const":"Legislation"},"source":{"const":"HKeL"},"authority_note":{"type":"string","minLength":1}}},
    "record":{"type":"object","additionalProperties":false,"required":["id","metadata"],"properties":{"id":{"$ref":"#/$defs/record_id"},"metadata":{"$ref":"#/$defs/metadata"}}},
    "nullable_record":{"oneOf":[{"$ref":"#/$defs/record"},{"type":"null"}]},
    "nullable_record_id":{"oneOf":[{"$ref":"#/$defs/record_id"},{"type":"null"}]},
    "nullable_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
    "reason_code":{"enum":["HKLEG_CURRENT_REC_EXACT_RECORD_REUSED","HKLEG_CURRENT_REC_CHANGED_RECORD_CREATED","HKLEG_CURRENT_REC_NON_SEARCHABLE_EXCLUDED","HKLEG_CURRENT_REC_CONTINUING_SUPPORT_MISSING","HKLEG_CURRENT_REC_PREDECESSOR_REQUIRED","HKLEG_CURRENT_REC_EXACT_REUSE_REQUIRED","HKLEG_CURRENT_REC_IMMUTABLE_ID_MUTATION","HKLEG_CURRENT_REC_NEW_ID_REQUIRED"]},
    "reason_code_catalogue":{"type":"object","additionalProperties":false,"required":["catalogue_id","version","status","reason_codes"],"properties":{"catalogue_id":{"const":"asklegal.hk-legislation.current-record.reason-codes"},"version":{"const":"1.0.0"},"status":{"const":"FROZEN_PARTIAL"},"reason_codes":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["code","meaning","processing_outcome"],"properties":{"code":{"$ref":"#/$defs/reason_code"},"meaning":{"type":"string","minLength":1},"processing_outcome":{"enum":["PASS","BLOCK","QUARANTINE"]}}}}}},
    "rule":{"type":"object","additionalProperties":false,"required":["rule_id","version","stage","predecessor_rule_id","successor_rule_id","exact_reuse_fields","identity_rule"],"properties":{"rule_id":{"const":"HKLEG-CURRENT-REC-001"},"version":{"const":"1.0.0"},"stage":{"const":"ORDINARY_CURRENT_RECORD_REUSE_OR_CREATE"},"predecessor_rule_id":{"const":"HKLEG-CURRENT-DISP-001"},"successor_rule_id":{"const":"HKLEG-CURRENT-REL-001"},"exact_reuse_fields":{"const":["text","country","jurisdiction","type","source","authority_note"]},"identity_rule":{"const":"REUSE_ONLY_ON_EXACT_PAYLOAD_ELSE_NEW_REGISTER_ID"}}},
    "input":{"type":"object","additionalProperties":false,"required":["cutoff","scope_id","object_id","location_id","legal_disposition","continuing_legal_support","new_identity_register_allocated","predecessor_record","candidate_record"],"properties":{"cutoff":{"const":"2026-08-17T00:00:00Z"},"scope_id":{"$ref":"#/$defs/scope_id"},"object_id":{"type":"string","minLength":1},"location_id":{"type":"string","minLength":1},"legal_disposition":{"$ref":"#/$defs/legal_disposition"},"continuing_legal_support":{"type":"boolean"},"new_identity_register_allocated":{"type":"boolean"},"predecessor_record":{"$ref":"#/$defs/nullable_record"},"candidate_record":{"$ref":"#/$defs/nullable_record"}}},
    "fixture":{"type":"object","additionalProperties":false,"required":["fixture_id","title","synthetic","status","input_fingerprint","input","expected_artifact"],"properties":{"fixture_id":{"type":"string","pattern":"^HKLEG-CURRENT-REC-FIX-00[1-8]$"},"title":{"type":"string","minLength":1},"synthetic":{"const":true},"status":{"const":"FROZEN_PARTIAL"},"input_fingerprint":{"$ref":"#/$defs/sha256"},"input":{"$ref":"#/$defs/input"},"expected_artifact":{"type":"object","additionalProperties":false,"required":["path","fingerprint"],"properties":{"path":{"type":"string","pattern":"^expected/current-record/HKLEG-CURRENT-REC-FIX-00[1-8]\\.json$"},"fingerprint":{"$ref":"#/$defs/sha256"}}}}},
    "fixture_catalogue":{"type":"object","additionalProperties":false,"required":["catalogue_id","version","status","accepted_complete_universe","fixtures"],"properties":{"catalogue_id":{"const":"asklegal.hk-legislation.current-record.fixtures"},"version":{"const":"1.0.0"},"status":{"const":"FROZEN_PARTIAL"},"accepted_complete_universe":{"const":false},"fixtures":{"type":"array","minItems":8,"maxItems":8,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["fixture_id","path","fixture_fingerprint","expected_path","expected_fingerprint"],"properties":{"fixture_id":{"type":"string","pattern":"^HKLEG-CURRENT-REC-FIX-00[1-8]$"},"path":{"type":"string","pattern":"^fixtures/deterministic/HKLEG-CURRENT-REC-FIX-00[1-8]\\.json$"},"fixture_fingerprint":{"$ref":"#/$defs/sha256"},"expected_path":{"type":"string","pattern":"^expected/current-record/HKLEG-CURRENT-REC-FIX-00[1-8]\\.json$"},"expected_fingerprint":{"$ref":"#/$defs/sha256"}}}}}},
    "decision":{"type":"object","additionalProperties":false,"required":["fixture_id","rule_id","processing_outcome","legal_disposition","coverage_effect","source_contract_review_required","reason_codes","rule_trace","record_action","candidate_record","serving_payload_fingerprint","predecessor_record_id","affected_scope_ids","record_output","next_action"],"properties":{"fixture_id":{"type":"string","pattern":"^HKLEG-CURRENT-REC-FIX-00[1-8]$"},"rule_id":{"const":"HKLEG-CURRENT-REC-001"},"processing_outcome":{"enum":["PASS","BLOCK","QUARANTINE"]},"legal_disposition":{"$ref":"#/$defs/legal_disposition"},"coverage_effect":{"const":"NONE"},"source_contract_review_required":{"const":false},"reason_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/reason_code"}},"rule_trace":{"const":["HKLEG-CURRENT-REC-001"]},"record_action":{"enum":["REUSED","CREATED","NONE"]},"candidate_record":{"$ref":"#/$defs/nullable_record"},"serving_payload_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"predecessor_record_id":{"$ref":"#/$defs/nullable_record_id"},"affected_scope_ids":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/scope_id"}},"record_output":{"enum":["REUSED","CANDIDATE","NONE"]},"next_action":{"enum":["RUN_HKLEG_CURRENT_REL_001","PRESERVE_NON_SEARCHABLE_ACCOUNTING","COMPLETE_LEGAL_SUPPORT","OPEN_INITIAL_BASELINE","REUSE_PREDECESSOR_RECORD_ID","QUARANTINE_IDENTITY_MUTATION","REQUEST_NEW_REGISTER_IDENTITY"]}}}
  }
