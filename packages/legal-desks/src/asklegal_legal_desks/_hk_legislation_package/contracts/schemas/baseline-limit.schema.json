{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-limit.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {"enum": ["rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95", "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e", "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"]},
    "assertion_code": {"enum": ["HISTORICAL_LEGAL_EVENT", "HISTORICAL_EFFECTIVE_DATE", "IDENTITY_OR_CONTINUITY_RELATIONSHIP", "COMPLETE_HISTORICAL_EVENT_CHAIN"]},
    "reason_code": {"enum": ["HKLEG_BASE_LIMIT_PRESENT_STATE_ONLY", "HKLEG_BASE_LIMIT_HISTORICAL_EVENT_FORBIDDEN", "HKLEG_BASE_LIMIT_EFFECTIVE_DATE_FORBIDDEN", "HKLEG_BASE_LIMIT_CONTINUITY_FORBIDDEN", "HKLEG_BASE_LIMIT_COMPLETE_HISTORY_FORBIDDEN"]},
    "assertion_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "assertion_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-limit.assertion-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"},
        "assertion_codes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "forbidden_without_exact_evidence"], "properties": {"code": {"$ref": "#/$defs/assertion_code"}, "forbidden_without_exact_evidence": {"const": true}}}}
      }
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-limit.reason-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}}}}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "predecessor_rule_id", "branch_precedence", "successor_rule_id", "forbidden_assertion_codes"],
      "properties": {
        "rule_id": {"const": "HKLEG-BASE-LIMIT-001"}, "version": {"const": "1.0.0"}, "stage": {"const": "FIRST_BASELINE_PRESENT_STATE_ASSERTION_LIMIT"}, "predecessor_rule_id": {"const": "HKLEG-BASE-STATE-001"},
        "branch_precedence": {"const": ["HISTORICAL_EVENT_FORBIDDEN", "EFFECTIVE_DATE_FORBIDDEN", "CONTINUITY_FORBIDDEN", "COMPLETE_HISTORY_FORBIDDEN", "PRESENT_STATE_ONLY"]},
        "successor_rule_id": {"const": "HKLEG-BASE-ID-001"},
        "forbidden_assertion_codes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/assertion_code"}}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["cutoff", "legal_object_id", "legal_location_id", "scope_id", "official_version_id", "predecessor_result", "proposed_historical_assertion_codes"],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"}, "legal_object_id": {"const": "SYN-HKLEG-OBJ-001"}, "legal_location_id": {"const": "SYN-HKLEG-LOC-001"}, "scope_id": {"$ref": "#/$defs/scope_id"}, "official_version_id": {"const": "SYN-HKLEG-VER-001"},
        "predecessor_result": {"const": {"rule_id": "HKLEG-BASE-STATE-001", "processing_outcome": "PASS", "present_state": "OPERATIVE_CURRENT", "historical_assertion_scope": "PENDING_LIMIT_RULE"}},
        "proposed_historical_assertion_codes": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/assertion_code"}}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-LIMIT-FIX-00[1-5]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"}, "rule_id": {"const": "HKLEG-BASE-LIMIT-001"}, "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/baseline-limit/HKLEG-BASE-LIMIT-FIX-00[1-5]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-limit.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false},
        "fixtures": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-LIMIT-FIX-00[1-5]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-LIMIT-FIX-00[1-5]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/baseline-limit/HKLEG-BASE-LIMIT-FIX-00[1-5]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "historical_assertion_scope", "rejected_assertion_codes", "affected_scope_ids", "record_output", "next_action"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-LIMIT-FIX-00[1-5]$"}, "rule_id": {"const": "HKLEG-BASE-LIMIT-001"}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}, "legal_disposition": {"const": "NOT_APPLICABLE"}, "coverage_effect": {"const": "NONE"}, "source_contract_review_required": {"const": false}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"const": ["HKLEG-BASE-LIMIT-001"]}, "historical_assertion_scope": {"enum": ["PRESENT_STATE_ONLY", "NONE"]}, "rejected_assertion_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/assertion_code"}}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}}, "record_output": {"const": "NONE"}, "next_action": {"enum": ["RUN_HKLEG_BASE_ID_001", "REMOVE_UNSUPPORTED_HISTORICAL_ASSERTIONS"]}
      }
    }
  }
}
