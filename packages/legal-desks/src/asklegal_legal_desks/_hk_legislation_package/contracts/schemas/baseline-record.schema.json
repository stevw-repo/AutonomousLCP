{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-record.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {"enum": ["rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95", "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e", "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"]},
    "search_record_id": {"type": "string", "pattern": "^rec_[0-9a-f]{48}$"},
    "legal_disposition": {"enum": ["SEARCHABLE_CURRENT", "WAITING_ROOM", "EVIDENCE_ONLY", "HISTORICAL", "QUARANTINE"]},
    "reason_code": {"enum": ["HKLEG_BASE_REC_CANDIDATE_CREATED", "HKLEG_BASE_REC_NON_SEARCHABLE_EXCLUDED", "HKLEG_BASE_REC_LEGACY_ID_FORBIDDEN", "HKLEG_BASE_REC_BILINGUAL_CONTENT_INCOMPLETE", "HKLEG_BASE_REC_RENDERING_NON_CANONICAL", "HKLEG_BASE_REC_AUTHORITY_NOTE_UNAPPROVED"]},
    "language_block": {"type": "object", "additionalProperties": false, "required": ["instrument_title", "citation", "locator", "heading", "text"], "properties": {"instrument_title": {"type": "string", "minLength": 1}, "citation": {"type": "string", "minLength": 1}, "locator": {"type": "string", "minLength": 1}, "heading": {"type": ["string", "null"], "minLength": 1}, "text": {"type": "string", "minLength": 1}}},
    "content": {"type": "object", "additionalProperties": false, "required": ["english", "traditional_chinese"], "properties": {"english": {"$ref": "#/$defs/language_block"}, "traditional_chinese": {"$ref": "#/$defs/language_block"}}},
    "metadata": {"type": "object", "additionalProperties": false, "required": ["text", "country", "jurisdiction", "type", "source", "authority_note"], "properties": {"text": {"type": "string", "minLength": 1}, "country": {"const": "Hong Kong"}, "jurisdiction": {"const": "Hong Kong"}, "type": {"const": "Legislation"}, "source": {"const": "HKeL"}, "authority_note": {"const": "None"}}},
    "serving_record": {"type": "object", "additionalProperties": false, "required": ["id", "metadata"], "properties": {"id": {"$ref": "#/$defs/search_record_id"}, "metadata": {"$ref": "#/$defs/metadata"}}},
    "reason_code_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "reason_codes"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-record.reason-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "reason_codes": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}}}}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "version", "stage", "predecessor_rule_id", "branch_precedence", "successor_rule_id", "serving_record_schema_ref", "renderer_contract", "metadata_profile"], "properties": {"rule_id": {"const": "HKLEG-BASE-REC-001"}, "version": {"const": "1.0.0"}, "stage": {"const": "FIRST_BASELINE_CANDIDATE_RECORD"}, "predecessor_rule_id": {"const": "HKLEG-BASE-DISP-001"}, "branch_precedence": {"const": ["NON_SEARCHABLE_EXCLUDED", "LEGACY_ID_FORBIDDEN", "BILINGUAL_CONTENT_INCOMPLETE", "RENDERING_NON_CANONICAL", "AUTHORITY_NOTE_UNAPPROVED", "CANDIDATE_CREATED"]}, "successor_rule_id": {"const": "HKLEG-BASE-REL-001"}, "serving_record_schema_ref": {"const": "schemas/serving-domain.schema.json#/$defs/serving_record"}, "renderer_contract": {"const": "ADR-0021-CANONICAL-BILINGUAL"}, "metadata_profile": {"const": {"country": "Hong Kong", "jurisdiction": "Hong Kong", "type": "Legislation", "source": "HKeL"}}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["cutoff", "legal_object_id", "legal_location_reference", "scope_id", "legal_disposition", "identity_origin", "search_record_id", "bilingual_alignment", "renderer_conformance", "authority_note", "authority_note_approved", "content"], "properties": {"cutoff": {"const": "2026-08-17T00:00:00Z"}, "legal_object_id": {"const": "SYN-HKLEG-OBJ-001"}, "legal_location_reference": {"const": "SYN-HKLEG-LOC-001"}, "scope_id": {"$ref": "#/$defs/scope_id"}, "legal_disposition": {"$ref": "#/$defs/legal_disposition"}, "identity_origin": {"enum": ["REGISTER_ALLOCATED", "LEGACY_CARRY_FORWARD", "NOT_APPLICABLE"]}, "search_record_id": {"oneOf": [{"$ref": "#/$defs/search_record_id"}, {"type": "null"}]}, "bilingual_alignment": {"enum": ["COMPLETE", "INCOMPLETE"]}, "renderer_conformance": {"enum": ["EXACT", "NON_CANONICAL"]}, "authority_note": {"type": "string", "minLength": 1}, "authority_note_approved": {"type": "boolean"}, "content": {"$ref": "#/$defs/content"}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-REC-FIX-00[1-6]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"}, "rule_id": {"const": "HKLEG-BASE-REC-001"}, "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"}, "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/baseline-record/HKLEG-BASE-REC-FIX-00[1-6]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}}},
    "fixture_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-record.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false}, "fixtures": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-REC-FIX-00[1-6]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-REC-FIX-00[1-6]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/baseline-record/HKLEG-BASE-REC-FIX-00[1-6]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "candidate_record", "serving_payload_fingerprint", "affected_scope_ids", "record_output", "next_action"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-REC-FIX-00[1-6]$"}, "rule_id": {"const": "HKLEG-BASE-REC-001"}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}, "legal_disposition": {"$ref": "#/$defs/legal_disposition"}, "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]}, "source_contract_review_required": {"const": false}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"const": ["HKLEG-BASE-REC-001"]}, "candidate_record": {"oneOf": [{"$ref": "#/$defs/serving_record"}, {"type": "null"}]}, "serving_payload_fingerprint": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}}, "record_output": {"enum": ["CANDIDATE", "NONE"]}, "next_action": {"enum": ["RUN_HKLEG_BASE_REL_001", "PRESERVE_NON_SEARCHABLE_ACCOUNTING", "REQUEST_NEW_REGISTER_IDENTITY", "COMPLETE_BILINGUAL_CONTENT", "QUARANTINE_RENDERING", "USE_APPROVED_AUTHORITY_NOTE"]}}}
  }
}
