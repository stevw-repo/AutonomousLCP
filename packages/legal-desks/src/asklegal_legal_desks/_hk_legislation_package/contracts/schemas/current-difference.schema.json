{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-current-difference.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "nullable_text": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "scope_id": {"const": "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95"},
    "rule_id": {"enum": ["HKLEG-CURRENT-DIFF-001", "HKLEG-CURRENT-DIFF-002"]},
    "reason_code": {"enum": ["HKLEG_CURRENT_DIFF_OBSERVABLE_DIFFERENCE_CLASSIFIED", "HKLEG_CURRENT_DIFF_EXACT_UNCHANGED_REUSE_ELIGIBLE", "HKLEG_CURRENT_DIFF_CONTINUING_SUPPORT_NOT_PROVED", "HKLEG_CURRENT_DIFF_INITIAL_BASELINE_REQUIRED"]},
    "difference_class": {"enum": ["EXACT_UNCHANGED", "EVIDENCE_BUNDLE_CHANGED", "PAYLOAD_CHANGED", "STRUCTURE_CHANGED", "LOCATION_REFERENCE_CHANGED", "MULTIPLE_OBSERVABLE_DIFFERENCES", "OBJECT_ADDED"]},
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-difference.reason-codes"},
        "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}}}}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "establishes", "record_output", "forbidden_inferences"],
      "properties": {
        "rule_id": {"$ref": "#/$defs/rule_id"}, "version": {"const": "1.0.0"},
        "stage": {"enum": ["OBSERVABLE_BUNDLE_COMPARISON", "EXACT_UNCHANGED_REUSE_GATE"]},
        "establishes": {"enum": ["OBSERVABLE_DIFFERENCE_CLASS", "REUSE_ELIGIBILITY"]},
        "record_output": {"const": "NONE"},
        "forbidden_inferences": {"const": ["LEGAL_IDENTITY", "LEGAL_STATUS", "REPEAL", "CONTINUITY"]}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["cutoff", "scope_id", "object_id", "predecessor_release_present", "predecessor_object_present", "current_bundle_fingerprint", "predecessor_bundle_fingerprint", "current_payload_fingerprint", "predecessor_payload_fingerprint", "current_structure_fingerprint", "predecessor_structure_fingerprint", "current_location_id", "predecessor_location_id", "continuing_support_proved"],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"}, "scope_id": {"$ref": "#/$defs/scope_id"},
        "object_id": {"type": "string", "minLength": 1}, "predecessor_release_present": {"type": "boolean"}, "predecessor_object_present": {"type": "boolean"},
        "current_bundle_fingerprint": {"$ref": "#/$defs/sha256"}, "predecessor_bundle_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "current_payload_fingerprint": {"$ref": "#/$defs/sha256"}, "predecessor_payload_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "current_structure_fingerprint": {"$ref": "#/$defs/sha256"}, "predecessor_structure_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "current_location_id": {"type": "string", "minLength": 1}, "predecessor_location_id": {"$ref": "#/$defs/nullable_text"},
        "continuing_support_proved": {"type": "boolean"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-DIFF-FIX-00[1-7]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/current-difference/HKLEG-CURRENT-DIFF-FIX-00[1-7]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-difference.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false},
        "fixtures": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-DIFF-FIX-00[1-7]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-CURRENT-DIFF-FIX-00[1-7]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/current-difference/HKLEG-CURRENT-DIFF-FIX-00[1-7]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "difference_class", "record_selection", "identity_or_status_inference", "affected_object_ids", "affected_scope_ids", "record_output", "next_action"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-DIFF-FIX-00[1-7]$"}, "rule_id": {"$ref": "#/$defs/rule_id"}, "processing_outcome": {"enum": ["PASS", "BLOCK"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"}, "coverage_effect": {"const": "NONE"}, "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/rule_id"}},
        "difference_class": {"oneOf": [{"$ref": "#/$defs/difference_class"}, {"type": "null"}]}, "record_selection": {"enum": ["NONE", "REUSE_ELIGIBLE", "REBUILD_REQUIRED"]}, "identity_or_status_inference": {"const": "NONE"},
        "affected_object_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}},
        "record_output": {"const": "NONE"}, "next_action": {"enum": ["RUN_HKLEG_CURRENT_CAUSE_001", "RUN_HKLEG_CURRENT_RELEASE_ACCOUNTING_001", "RESOLVE_CONTINUING_SUPPORT", "RUN_HKLEG_BASE_OBS_001"]}
      }
    }
  }
}
