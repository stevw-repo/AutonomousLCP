{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-bilingual-alignment-map.schema.json",
  "$defs": {
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "local_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"$ref": "#/$defs/local_id"},
        "ref_id": {"$ref": "#/$defs/local_id"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "alignment_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_group_id",
        "legal_location_ref",
        "en_source_unit_ids",
        "zh_hant_source_unit_ids",
        "mapping_evidence_ref"
      ],
      "properties": {
        "alignment_group_id": {"$ref": "#/$defs/local_id"},
        "legal_location_ref": {"$ref": "#/$defs/reference"},
        "en_source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/local_id"}
        },
        "zh_hant_source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/local_id"}
        },
        "mapping_evidence_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "bilingual_alignment_map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract_version", "legal_item_ref", "groups"],
      "properties": {
        "$schema": {"const": "https://contracts.asklegal.local/v1/hk-legislation-bilingual-alignment-map.schema.json"},
        "contract_version": {"const": "1.0.0"},
        "legal_item_ref": {"$ref": "#/$defs/reference"},
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/alignment_group"}
        }
      }
    }
  },
  "$ref": "#/$defs/bilingual_alignment_map"
}
