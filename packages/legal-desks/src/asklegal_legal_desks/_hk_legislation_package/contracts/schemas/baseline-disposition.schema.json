{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-disposition.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {"enum": ["rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95", "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e", "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"]},
    "basis": {"enum": ["PRESENT_OPERATIVE_SUPPORTED", "VALIDLY_ENACTED_NOT_OPERATIVE", "PRESENT_EFFECT_REPRESENTED_ELSEWHERE", "CEASED_OR_SUPERSEDED_PROVED", "UNRESOLVED_MATERIAL_FACT", "OPERATIVE_EVENT_WITHOUT_CURRENT_CONSOLIDATION", "UNSUPPORTED_SIGNAL_ONLY"]},
    "reason_code": {"enum": ["HKLEG_BASE_DISP_SEARCHABLE_CURRENT_SUPPORTED", "HKLEG_BASE_DISP_WAITING_ROOM_SUPPORTED", "HKLEG_BASE_DISP_EVIDENCE_ONLY_SUPPORTED", "HKLEG_BASE_DISP_HISTORICAL_SUPPORTED", "HKLEG_BASE_DISP_QUARANTINE_REQUIRED", "HKLEG_BASE_DISP_CURRENT_CONSOLIDATION_GAP", "HKLEG_BASE_DISP_SINGLE_SIGNAL_INSUFFICIENT"]},
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-disposition.reason-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "reason_codes": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}}}}}
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["rule_id", "version", "stage", "predecessor_rule_id", "branch_precedence", "successor_rule_id", "primary_dispositions"],
      "properties": {"rule_id": {"const": "HKLEG-BASE-DISP-001"}, "version": {"const": "1.0.0"}, "stage": {"const": "FIRST_BASELINE_PRIMARY_DISPOSITION"}, "predecessor_rule_id": {"const": "HKLEG-BASE-ID-001"}, "branch_precedence": {"const": ["CURRENT_CONSOLIDATION_GAP", "SINGLE_SIGNAL_INSUFFICIENT", "QUARANTINE_REQUIRED", "SEARCHABLE_CURRENT", "WAITING_ROOM", "EVIDENCE_ONLY", "HISTORICAL"]}, "successor_rule_id": {"const": "HKLEG-BASE-REC-001"}, "primary_dispositions": {"const": ["SEARCHABLE_CURRENT", "WAITING_ROOM", "EVIDENCE_ONLY", "HISTORICAL", "QUARANTINE"]}}
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["cutoff", "legal_object_id", "legal_location_reference", "scope_id", "disposition_basis", "identity_checkpoint"],
      "properties": {"cutoff": {"const": "2026-08-17T00:00:00Z"}, "legal_object_id": {"const": "SYN-HKLEG-OBJ-001"}, "legal_location_reference": {"const": "SYN-HKLEG-LOC-001"}, "scope_id": {"$ref": "#/$defs/scope_id"}, "disposition_basis": {"$ref": "#/$defs/basis"}, "identity_checkpoint": {"enum": ["GREENFIELD_ALLOCATION_REQUESTED", "IDENTITY_UNRESOLVED", "NOT_APPLICABLE_TO_BLOCKED_PATH"]}}
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"],
      "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-DISP-FIX-00[1-7]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"}, "rule_id": {"const": "HKLEG-BASE-DISP-001"}, "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"}, "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/baseline-disposition/HKLEG-BASE-DISP-FIX-00[1-7]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}}
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-disposition.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false}, "fixtures": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-DISP-FIX-00[1-7]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-DISP-FIX-00[1-7]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/baseline-disposition/HKLEG-BASE-DISP-FIX-00[1-7]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}}
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "affected_scope_ids", "record_output", "next_action"],
      "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-DISP-FIX-00[1-7]$"}, "rule_id": {"const": "HKLEG-BASE-DISP-001"}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}, "legal_disposition": {"enum": ["SEARCHABLE_CURRENT", "WAITING_ROOM", "EVIDENCE_ONLY", "HISTORICAL", "QUARANTINE", "NOT_APPLICABLE"]}, "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]}, "source_contract_review_required": {"const": false}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"const": ["HKLEG-BASE-DISP-001"]}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}}, "record_output": {"const": "NONE"}, "next_action": {"enum": ["RUN_HKLEG_BASE_REC_001", "PRESERVE_NON_SEARCHABLE_ACCOUNTING", "PRESERVE_QUARANTINE", "APPLY_HKLEG_CURRENT_EVENT_001", "COMPLETE_LEGAL_TESTS"]}}
    }
  }
}
