{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-current-publication.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "issue_kind": {"enum": ["ORDINARY", "EXTRAORDINARY"]},
    "material_class": {"enum": ["LEGAL_SUPPLEMENT_1", "LEGAL_SUPPLEMENT_2", "LEGAL_SUPPLEMENT_3", "MAIN_GAZETTE_NOTICE", "OTHER_SUPPLEMENT"]},
    "publication_claim": {"enum": ["ORDINANCE_ENACTMENT", "SUBSIDIARY_LEGISLATION", "LEGAL_NOTICE", "BILL_INVENTORY", "OTHER_DISCOVERY"]},
    "reason_code": {
      "enum": [
        "HKLEG_CURRENT_PUBLICATION_ORDINANCE_ENACTMENT_PROVED",
        "HKLEG_CURRENT_PUBLICATION_SUBSIDIARY_LEGISLATION_PROVED",
        "HKLEG_CURRENT_PUBLICATION_NOTICE_PROVED",
        "HKLEG_CURRENT_PUBLICATION_LEGAL_SUPPLEMENT_3_INVENTORY_ONLY",
        "HKLEG_CURRENT_PUBLICATION_OTHER_SUPPLEMENT_DISCOVERY_ONLY",
        "HKLEG_CURRENT_PUBLICATION_EVIDENCE_INCOMPLETE",
        "HKLEG_CURRENT_PUBLICATION_BILINGUAL_EVIDENCE_INCOMPLETE",
        "HKLEG_CURRENT_PUBLICATION_SOURCE_CLASS_CONFLICT",
        "HKLEG_CURRENT_PUBLICATION_AFTER_CUTOFF",
        "HKLEG_CURRENT_PUBLICATION_EVIDENCE_CONFLICT"
      ]
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-publication.reason-codes"},
        "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome"],
            "properties": {
              "code": {"$ref": "#/$defs/reason_code"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "establishes", "authority_rule", "extraordinary_rule", "identity_rule", "legal_effect_rule", "text_rule"],
      "properties": {
        "rule_id": {"const": "HKLEG-CURRENT-PUBLICATION-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "GAZETTE_PUBLICATION_AND_ENACTMENT_CLASSIFICATION"},
        "establishes": {"const": "PUBLICATION_FACT_AND_NEXT_EVIDENCE_ROUTE_ONLY"},
        "authority_rule": {"const": "EXACT_GLD_ARTIFACT_AND_FACT_SPECIFIC_GAZETTE_CLASS"},
        "extraordinary_rule": {"const": "TIMING_ONLY_DOES_NOT_CHANGE_MATERIAL_AUTHORITY"},
        "identity_rule": {"const": "NO_IDENTITY_OR_CONTINUITY_INFERENCE"},
        "legal_effect_rule": {"const": "PUBLICATION_IS_NOT_COMMENCEMENT_OR_CURRENT_LAW"},
        "text_rule": {"const": "NO_OFFICIAL_VERSION_OR_SEARCH_RECORD_OUTPUT"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": [
        "cutoff", "source_id", "gazette_issue_kind", "gazette_material_class", "publication_claim",
        "subject_reference", "issue_id", "supplement_or_notice_id", "instrument_or_notice_number",
        "publication_date", "artifact_fingerprint", "source_metadata_fingerprint",
        "english_material_fingerprint", "traditional_chinese_material_fingerprint",
        "enabling_authority_fingerprint", "evidence_complete", "evidence_authentic",
        "evidence_conflicts", "bilingual_material_complete", "claim_matches_material_class"
      ],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "source_id": {"const": "HK-LEG-GLD-EGAZETTE"},
        "gazette_issue_kind": {"$ref": "#/$defs/issue_kind"},
        "gazette_material_class": {"$ref": "#/$defs/material_class"},
        "publication_claim": {"$ref": "#/$defs/publication_claim"},
        "subject_reference": {"type": "string", "minLength": 1},
        "issue_id": {"type": "string", "minLength": 1},
        "supplement_or_notice_id": {"type": "string", "minLength": 1},
        "instrument_or_notice_number": {"type": "string", "minLength": 1},
        "publication_date": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "artifact_fingerprint": {"$ref": "#/$defs/sha256"},
        "source_metadata_fingerprint": {"$ref": "#/$defs/sha256"},
        "english_material_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "traditional_chinese_material_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "enabling_authority_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_complete": {"type": "boolean"},
        "evidence_authentic": {"type": "boolean"},
        "evidence_conflicts": {"type": "boolean"},
        "bilingual_material_complete": {"type": "boolean"},
        "claim_matches_material_class": {"type": "boolean"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-PUB-FIX-(00[1-9]|01[0-3])$"},
        "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/current-publication/HKLEG-CURRENT-PUB-FIX-(00[1-9]|01[0-3])\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-publication.fixtures"},
        "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-PUB-FIX-(00[1-9]|01[0-3])$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-CURRENT-PUB-FIX-(00[1-9]|01[0-3])\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/current-publication/HKLEG-CURRENT-PUB-FIX-(00[1-9]|01[0-3])\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect",
        "source_contract_review_required", "reason_codes", "rule_trace", "publication_fact_output", "source_id",
        "gazette_issue_kind", "gazette_material_class", "publication_claim", "subject_reference",
        "issue_id", "supplement_or_notice_id", "instrument_or_notice_number", "publication_date",
        "artifact_fingerprint", "source_metadata_fingerprint", "english_material_fingerprint",
        "traditional_chinese_material_fingerprint", "enabling_authority_fingerprint",
        "publication_history_action", "commencement_output", "legal_effect_output", "identity_output",
        "continuity_inference", "official_version_output", "record_output", "next_action"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-PUB-FIX-(00[1-9]|01[0-3])$"},
        "rule_id": {"const": "HKLEG-CURRENT-PUBLICATION-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"enum": ["NOT_APPLICABLE", "EVIDENCE_ONLY", "QUARANTINE"]},
        "coverage_effect": {"const": "NONE"}, "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}},
        "rule_trace": {"const": ["HKLEG-CURRENT-PUBLICATION-001"]},
        "publication_fact_output": {"enum": ["ORDINANCE_ENACTMENT_AND_PUBLICATION", "SUBSIDIARY_LEGISLATION_PUBLICATION", "NOTICE_PUBLICATION", "EXCLUDED_BILL_INVENTORY", "DISCOVERY_ONLY", "NONE"]},
        "source_id": {"const": "HK-LEG-GLD-EGAZETTE"},
        "gazette_issue_kind": {"$ref": "#/$defs/issue_kind"},
        "gazette_material_class": {"$ref": "#/$defs/material_class"},
        "publication_claim": {"$ref": "#/$defs/publication_claim"},
        "subject_reference": {"type": "string", "minLength": 1}, "issue_id": {"type": "string", "minLength": 1},
        "supplement_or_notice_id": {"type": "string", "minLength": 1}, "instrument_or_notice_number": {"type": "string", "minLength": 1},
        "publication_date": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "artifact_fingerprint": {"$ref": "#/$defs/sha256"}, "source_metadata_fingerprint": {"$ref": "#/$defs/sha256"},
        "english_material_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "traditional_chinese_material_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "enabling_authority_fingerprint": {"$ref": "#/$defs/nullable_sha256"},
        "publication_history_action": {"enum": ["APPEND_PUBLICATION_EVENT", "RETAIN_INVENTORY_OBSERVATION", "PRESERVE_UNCHANGED"]},
        "commencement_output": {"const": "NONE"}, "legal_effect_output": {"const": "NONE"},
        "identity_output": {"const": "NONE"}, "continuity_inference": {"const": "NONE"},
        "official_version_output": {"const": "NONE"}, "record_output": {"const": "NONE"},
        "next_action": {"enum": ["ROUTE_NEW_ITEM_TO_IDENTITY_AND_EVIDENCE", "RUN_FACT_SPECIFIC_NOTICE_EVENT_RULE", "ACCOUNT_EXCLUDED_LEGAL_SUPPLEMENT_3", "RETAIN_DISCOVERY_ONLY", "RESOLVE_PUBLICATION_EVIDENCE", "RESOLVE_BILINGUAL_PUBLICATION_EVIDENCE", "QUARANTINE_PUBLICATION_CLASSIFICATION", "WAIT_FOR_PUBLICATION_CUTOFF", "QUARANTINE_PUBLICATION_EVIDENCE"]}
      }
    }
  }
}
