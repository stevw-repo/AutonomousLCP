{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-current-text-event.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullable_text": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "scope_id": {
      "enum": [
        "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95",
        "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e",
        "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"
      ]
    },
    "event_type": {"enum": ["AMENDMENT", "EXPRESS_CORRECTION", "EDITORIAL_AMENDMENT"]},
    "reason_code": {
      "enum": [
        "HKLEG_CURRENT_TEXT_EVENT_AMENDMENT_CURRENT_BUNDLE_AVAILABLE",
        "HKLEG_CURRENT_TEXT_EVENT_AMENDMENT_CONSOLIDATION_MISSING",
        "HKLEG_CURRENT_TEXT_EVENT_AMENDMENT_PENDING",
        "HKLEG_CURRENT_TEXT_EVENT_EXPRESS_CORRECTION_CURRENT_BUNDLE_AVAILABLE",
        "HKLEG_CURRENT_TEXT_EVENT_EXPRESS_CORRECTION_CONSOLIDATION_MISSING",
        "HKLEG_CURRENT_TEXT_EVENT_EXPRESS_CORRECTION_PENDING",
        "HKLEG_CURRENT_TEXT_EVENT_EDITORIAL_CURRENT_BUNDLE_AVAILABLE",
        "HKLEG_CURRENT_TEXT_EVENT_EDITORIAL_CONSOLIDATION_MISSING",
        "HKLEG_CURRENT_TEXT_EVENT_EDITORIAL_PENDING",
        "HKLEG_CURRENT_TEXT_EVENT_EVIDENCE_INCOMPLETE",
        "HKLEG_CURRENT_TEXT_EVENT_OPERATION_MAPPING_INCOMPLETE",
        "HKLEG_CURRENT_TEXT_EVENT_BILINGUAL_OPERATION_CONFLICT",
        "HKLEG_CURRENT_TEXT_EVENT_RESULTING_TEXT_CONFLICT",
        "HKLEG_CURRENT_TEXT_EVENT_EVIDENCE_CONFLICT",
        "HKLEG_CURRENT_TEXT_EVENT_AFFECTED_SET_INVALID"
      ]
    },
    "reason_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-text-event.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome"],
            "properties": {
              "code": {"$ref": "#/$defs/reason_code"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "version", "stage", "establishes", "record_output",
        "official_version_output", "identity_rule", "history_rule", "text_rule", "source_rule"
      ],
      "properties": {
        "rule_id": {"const": "HKLEG-CURRENT-TEXT-EVENT-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "TEXT_CHANGING_LEGAL_EVENT"},
        "establishes": {"const": "EVIDENCE_BOUND_EVENT_AND_CONSOLIDATION_ROUTE"},
        "record_output": {"const": "NONE"},
        "official_version_output": {"const": "NONE"},
        "identity_rule": {"const": "KEEP_PRINCIPAL_AND_SOURCE_EVENT_IDENTITIES_SEPARATE"},
        "history_rule": {"const": "APPEND_EVENT_WITHOUT_OVERWRITING_PRIOR_EVENT_HISTORY"},
        "text_rule": {"const": "NEVER_PATCH_PRIOR_TEXT_OR_CONSTRUCT_RESULTING_TEXT"},
        "source_rule": {"const": "GAZETTE_FOR_AMENDMENT_OR_EXPRESS_CORRECTION_EDITORIAL_RECORD_FOR_EDITORIAL_AMENDMENT"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cutoff", "scope_id", "affected_object_id", "source_event_object_id",
        "event_type", "cause_source_id", "publication_date", "effective_date",
        "event_instrument_fingerprint", "event_evidence_fingerprints",
        "event_evidence_complete", "event_evidence_authentic", "event_evidence_conflicts",
        "operation_set_fingerprint", "operation_mapping_complete", "bilingual_operations_aligned",
        "event_operative_at_cutoff", "all_location_ids", "affected_location_ids",
        "affected_location_scope", "matching_resulting_hkel_bundle_available",
        "resulting_bundle_reflects_event", "prior_event_history_fingerprint"
      ],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "affected_object_id": {"type": "string", "minLength": 1},
        "source_event_object_id": {"type": "string", "minLength": 1},
        "event_type": {"$ref": "#/$defs/event_type"},
        "cause_source_id": {"enum": ["HK-LEG-GLD-EGAZETTE", "HK-LEG-HKEL-EDITORIAL-RECORDS"]},
        "publication_date": {"$ref": "#/$defs/nullable_text"},
        "effective_date": {"$ref": "#/$defs/nullable_text"},
        "event_instrument_fingerprint": {"$ref": "#/$defs/sha256"},
        "event_evidence_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "event_evidence_complete": {"type": "boolean"},
        "event_evidence_authentic": {"type": "boolean"},
        "event_evidence_conflicts": {"type": "boolean"},
        "operation_set_fingerprint": {"$ref": "#/$defs/sha256"},
        "operation_mapping_complete": {"type": "boolean"},
        "bilingual_operations_aligned": {"type": "boolean"},
        "event_operative_at_cutoff": {"type": "boolean"},
        "all_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_location_scope": {"enum": ["WHOLE_INSTRUMENT", "EXACT_LOCATIONS"]},
        "matching_resulting_hkel_bundle_available": {"type": "boolean"},
        "resulting_bundle_reflects_event": {"type": "boolean"},
        "prior_event_history_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-TEXT-EVENT-FIX-(00[1-9]|01[0-6])$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/current-text-event/HKLEG-CURRENT-TEXT-EVENT-FIX-(00[1-9]|01[0-6])\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-text-event.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-TEXT-EVENT-FIX-(00[1-9]|01[0-6])$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-CURRENT-TEXT-EVENT-FIX-(00[1-9]|01[0-6])\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/current-text-event/HKLEG-CURRENT-TEXT-EVENT-FIX-(00[1-9]|01[0-6])\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect",
        "source_contract_review_required", "reason_codes", "rule_trace", "event_fact_output",
        "event_type", "selection_result", "affected_object_ids", "source_event_object_id",
        "affected_scope_ids", "cause_source_id", "publication_date", "effective_date",
        "event_instrument_fingerprint", "event_evidence_fingerprints", "operation_set_fingerprint",
        "event_operative_at_cutoff", "affected_location_ids", "affected_location_scope",
        "prior_event_history_fingerprint", "event_history_action",
        "identity_or_continuity_inference", "official_version_output", "record_output", "next_action"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-TEXT-EVENT-FIX-(00[1-9]|01[0-6])$"},
        "rule_id": {"const": "HKLEG-CURRENT-TEXT-EVENT-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"enum": ["NOT_APPLICABLE", "WAITING_ROOM", "QUARANTINE"]},
        "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]},
        "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}},
        "rule_trace": {"const": ["HKLEG-CURRENT-TEXT-EVENT-001"]},
        "event_fact_output": {"enum": ["NONE", "LEGAL_STATUS_EVENT"]},
        "event_type": {"$ref": "#/$defs/event_type"},
        "selection_result": {"enum": ["ORDINARY_CURRENT_BUNDLE_REQUIRED", "MISSING_CONSOLIDATION_EVENT_ROUTING_REQUIRED", "KEEP_PRE_EVENT_TEXT", "UNRESOLVED"]},
        "affected_object_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "source_event_object_id": {"type": "string", "minLength": 1},
        "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}},
        "cause_source_id": {"enum": ["HK-LEG-GLD-EGAZETTE", "HK-LEG-HKEL-EDITORIAL-RECORDS"]},
        "publication_date": {"$ref": "#/$defs/nullable_text"},
        "effective_date": {"$ref": "#/$defs/nullable_text"},
        "event_instrument_fingerprint": {"$ref": "#/$defs/sha256"},
        "event_evidence_fingerprints": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}},
        "operation_set_fingerprint": {"$ref": "#/$defs/sha256"},
        "event_operative_at_cutoff": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "affected_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "affected_location_scope": {"enum": ["WHOLE_INSTRUMENT", "EXACT_LOCATIONS"]},
        "prior_event_history_fingerprint": {"$ref": "#/$defs/sha256"},
        "event_history_action": {"enum": ["APPEND_EVENT", "PRESERVE_UNCHANGED"]},
        "identity_or_continuity_inference": {"const": "NONE"},
        "official_version_output": {"const": "NONE"},
        "record_output": {"const": "NONE"},
        "next_action": {
          "enum": [
            "RUN_HKLEG_CURRENT_EVID_001", "RUN_HKLEG_CURRENT_EVENT_001", "KEEP_PRE_EVENT_TEXT",
            "RESOLVE_TEXT_EVENT_EVIDENCE", "COMPLETE_OPERATION_MAPPING",
            "QUARANTINE_BILINGUAL_OPERATION_CONFLICT", "QUARANTINE_RESULTING_TEXT",
            "QUARANTINE_TEXT_EVENT_EVIDENCE", "QUARANTINE_AFFECTED_SET"
          ]
        }
      }
    }
  }
}
