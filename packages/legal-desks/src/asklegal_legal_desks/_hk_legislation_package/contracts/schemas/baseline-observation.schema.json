{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-observation.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_id": {
      "enum": [
        "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95",
        "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e",
        "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"
      ]
    },
    "source_id": {
      "enum": ["HK-LEG-HKEL-CURRENT-INVENTORY", "HK-LEG-GLD-EGAZETTE"]
    },
    "source_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "source_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-observation.source-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "source_codes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "required_for_freeze", "fact_authority"],
            "properties": {
              "code": {"$ref": "#/$defs/source_id"},
              "required_for_freeze": {"const": true},
              "fact_authority": {
                "enum": ["CURRENT_HKEL_INVENTORY_METADATA_ONLY", "GAZETTE_EVENT_OBSERVATION_ONLY"]
              }
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-observation.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome", "coverage_effect"],
            "properties": {
              "code": {
                "enum": [
                  "HKLEG_BASE_OBSERVATION_FROZEN",
                  "HKLEG_BASE_OBSERVATION_REQUIRED_SOURCE_UNAVAILABLE",
                  "HKLEG_BASE_OBSERVATION_CUTOFF_MIXED",
                  "HKLEG_BASE_OBSERVATION_LOCK_MISMATCH",
                  "HKLEG_BASE_OBSERVATION_POST_CUTOFF_CHANGE"
                ]
              },
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK"]},
              "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]}
            }
          }
        }
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rulebook_version", "rulebook_fingerprint",
        "release_scope_registry_fingerprint",
        "publication_specification_version",
        "publication_specification_fingerprint"
      ],
      "properties": {
        "rulebook_version": {"type": "string", "minLength": 1},
        "rulebook_fingerprint": {"$ref": "#/$defs/sha256"},
        "release_scope_registry_fingerprint": {"$ref": "#/$defs/sha256"},
        "publication_specification_version": {"type": "string", "minLength": 1},
        "publication_specification_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "version", "stage", "required_source_ids", "expected_locks",
        "branch_precedence", "successor_rule_id", "forbidden_shortcuts"
      ],
      "properties": {
        "rule_id": {"const": "HKLEG-BASE-OBS-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "FIRST_BASELINE_OBSERVATION_FREEZE"},
        "required_source_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_id"}
        },
        "expected_locks": {"$ref": "#/$defs/locks"},
        "branch_precedence": {
          "const": [
            "REQUIRED_SOURCE_UNAVAILABLE",
            "CUTOFF_MIXED",
            "LOCK_MISMATCH",
            "POST_CUTOFF_CHANGE",
            "FROZEN"
          ]
        },
        "successor_rule_id": {"const": "HKLEG-BASE-INV-001"},
        "forbidden_shortcuts": {
          "const": [
            "MIXED_CUTOFF_EVIDENCE",
            "MISSING_RELEASE_BLOCKING_SOURCE",
            "STALE_RELEASE_BLOCKING_SOURCE",
            "LOCK_DRIFT_ACCEPTED",
            "POST_CUTOFF_CHANGE_MERGED"
          ]
        }
      }
    },
    "source_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id", "observation_id", "cutoff", "complete", "freshness",
        "artifact_fingerprint", "change_observed_at"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "observation_id": {"type": "string", "pattern": "^SYN-HKLEG-OBS-[A-Z]+-[0-9]{3}$"},
        "cutoff": {"type": "string", "format": "date-time"},
        "complete": {"type": "boolean"},
        "freshness": {"enum": ["FRESH", "STALE"]},
        "artifact_fingerprint": {"$ref": "#/$defs/sha256"},
        "change_observed_at": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "format": "date-time"}
          ]
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutoff", "locks", "source_observations"],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "locks": {"$ref": "#/$defs/locks"},
        "source_observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/source_observation"}
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-OBS-FIX-00[1-5]$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "rule_id": {"const": "HKLEG-BASE-OBS-001"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/baseline-observation/HKLEG-BASE-OBS-FIX-00[1-5]\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-observation.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-OBS-FIX-00[1-5]$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-OBS-FIX-00[1-5]\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/baseline-observation/HKLEG-BASE-OBS-FIX-00[1-5]\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id", "rule_id", "processing_outcome", "legal_disposition",
        "coverage_effect", "source_contract_review_required", "reason_codes",
        "rule_trace", "frozen_cutoff", "frozen_source_observation_ids",
        "unresolved_source_ids", "affected_scope_ids", "record_output", "next_action"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-OBS-FIX-00[1-5]$"},
        "rule_id": {"const": "HKLEG-BASE-OBS-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"},
        "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]},
        "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "rule_trace": {"const": ["HKLEG-BASE-OBS-001"]},
        "frozen_cutoff": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
        "frozen_source_observation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unresolved_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "affected_scope_ids": {"type": "array", "minItems": 3, "maxItems": 3, "uniqueItems": true, "items": {"$ref": "#/$defs/scope_id"}},
        "record_output": {"const": "NONE"},
        "next_action": {
          "enum": [
            "RUN_HKLEG_BASE_INV_001",
            "COMPLETE_REQUIRED_OBSERVATIONS",
            "REFREEZE_SINGLE_CUTOFF",
            "USE_EXACT_PACKAGE_LOCKS",
            "REFREEZE_OR_FINISH_THEN_RUN_UPDATE"
          ]
        }
      }
    }
  }
}
