    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-CHANGE-FIX-00[1-7]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"}, "rule_id": {"const": "HKLEG-BASE-CHANGE-001"}, "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"}, "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/baseline-change/HKLEG-BASE-CHANGE-FIX-00[1-7]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}}},
    "fixture_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-change.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false}, "fixtures": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-CHANGE-FIX-00[1-7]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-CHANGE-FIX-00[1-7]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/baseline-change/HKLEG-BASE-CHANGE-FIX-00[1-7]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "baseline_action", "preserved_cutoff", "new_observation_status", "affected_scope_ids", "record_output", "next_action"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-CHANGE-FIX-00[1-7]$"}, "rule_id": {"const": "HKLEG-BASE-CHANGE-001"}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}, "legal_disposition": {"const": "NOT_APPLICABLE"}, "coverage_effect": {"const": "NONE"}, "source_contract_review_required": {"const": false}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"const": ["HKLEG-BASE-CHANGE-001"]}, "baseline_action": {"enum": ["CONTINUE_ORIGINAL", "ABANDON_AND_REFREEZE", "FINISH_ORIGINAL_THEN_UPDATE", "BLOCKED"]}, "preserved_cutoff": {"oneOf": [{"const": "2026-08-17T00:00:00Z"}, {"type": "null"}]}, "new_observation_status": {"enum": ["NOT_APPLICABLE", "NONE", "RECORDED_SEPARATELY"]}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}}, "record_output": {"const": "NONE"}, "next_action": {"enum": ["CONTINUE_ORIGINAL_BASELINE", "REFREEZE_AT_LATER_CUTOFF", "FINISH_ORIGINAL_THEN_RUN_UPDATE", "RESTORE_FROZEN_PACKAGE", "RECORD_SEPARATE_OBSERVATION", "SELECT_PERMITTED_STRATEGY", "REMOVE_UNSUPPORTED_LATER_CURRENCY_CLAIM"]}}}
