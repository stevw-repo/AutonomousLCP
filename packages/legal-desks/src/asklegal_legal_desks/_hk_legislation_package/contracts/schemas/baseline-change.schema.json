    "reason_code_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "reason_codes"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-change.reason-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "reason_codes": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}}}}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "version", "stage", "trigger", "permitted_strategies", "branch_precedence"], "properties": {"rule_id": {"const": "HKLEG-BASE-CHANGE-001"}, "version": {"const": "1.0.0"}, "stage": {"const": "FIRST_BASELINE_POST_CUTOFF_CHANGE"}, "trigger": {"const": "ACCEPTED_SOURCE_CHANGED_AFTER_FROZEN_CUTOFF_WHILE_BASELINE_OPEN"}, "permitted_strategies": {"const": ["ABANDON_AND_REFREEZE", "FINISH_ORIGINAL_THEN_UPDATE"]}, "branch_precedence": {"const": ["NO_POST_CUTOFF_CHANGE", "FROZEN_PACKAGE_NOT_PRESERVED", "NEW_OBSERVATION_NOT_SEPARATE", "MIXED_CUTOFF_FORBIDDEN", "LATER_CURRENCY_CLAIM_FORBIDDEN", "REFREEZE_SELECTED", "FINISH_THEN_UPDATE_SELECTED"]}}},
