{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-plan-validation.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "rpl_id": {
      "type": "string",
      "pattern": "^rpl_[0-9a-f]{48}$"
    },
    "rop_id": {
      "type": "string",
      "pattern": "^rop_[0-9a-f]{48}$"
    },
    "nullable_rpl_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/rpl_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id",
        "fingerprint"
      ],
      "properties": {
        "ref_type": {
          "const": "ARTIFACT"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^art_[0-9a-f]{48}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "legal_item_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id",
        "fingerprint"
      ],
      "properties": {
        "ref_type": {
          "const": "LEGAL_ITEM"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^lit_[0-9a-f]{48}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "official_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id",
        "fingerprint"
      ],
      "properties": {
        "ref_type": {
          "const": "OFFICIAL_VERSION"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^ofv_[0-9a-f]{48}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "legal_location_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id",
        "fingerprint"
      ],
      "properties": {
        "ref_type": {
          "const": "LEGAL_LOCATION"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^loc_[0-9a-f]{48}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "event_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id",
        "fingerprint"
      ],
      "properties": {
        "ref_type": {
          "const": "LEGAL_STATUS_EVENT"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^lse_[0-9a-f]{48}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "decision_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref_type",
        "ref_id",
        "fingerprint"
      ],
      "properties": {
        "ref_type": {
          "const": "DECISION"
        },
        "ref_id": {
          "type": "string",
          "pattern": "^ldd_[0-9a-f]{48}$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "version",
        "fingerprint"
      ],
      "properties": {
        "contract_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_rulebook",
        "operation_registry",
        "source_interpretation",
        "tree",
        "renderer",
        "identity",
        "traceability",
        "execution"
      ],
      "properties": {
        "source_rulebook": {
          "$ref": "#/$defs/contract_ref"
        },
        "operation_registry": {
          "$ref": "#/$defs/contract_ref"
        },
        "source_interpretation": {
          "$ref": "#/$defs/contract_ref"
        },
        "tree": {
          "$ref": "#/$defs/contract_ref"
        },
        "renderer": {
          "$ref": "#/$defs/contract_ref"
        },
        "identity": {
          "$ref": "#/$defs/contract_ref"
        },
        "traceability": {
          "$ref": "#/$defs/contract_ref"
        },
        "execution": {
          "$ref": "#/$defs/contract_ref"
        }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_version_ref",
        "bilingual_tree_ref",
        "en_tree_ref",
        "zh_hant_tree_ref",
        "en_xml_ref",
        "en_copy_ref",
        "zh_hant_xml_ref",
        "zh_hant_copy_ref",
        "evidence_class",
        "source_version_date",
        "applicable_state_decision_ref",
        "base_location_inventory_fingerprint",
        "canonical_bilingual_base_fingerprint"
      ],
      "properties": {
        "official_version_ref": {
          "$ref": "#/$defs/official_version_ref"
        },
        "bilingual_tree_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "en_tree_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "zh_hant_tree_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "en_xml_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "en_copy_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "zh_hant_xml_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "zh_hant_copy_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "evidence_class": {
          "enum": [
            "VERIFIED",
            "ASSISTED"
          ]
        },
        "source_version_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "applicable_state_decision_ref": {
          "$ref": "#/$defs/decision_ref"
        },
        "base_location_inventory_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "canonical_bilingual_base_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authentic_source_units": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh-Hant"
      ],
      "properties": {
        "en": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "zh-Hant": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "event_chain_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "event_ref",
        "event_role",
        "amendment_evidence_refs",
        "effect_evidence_refs",
        "effective_state_decision_ref",
        "affected_location_refs",
        "authentic_language_source_unit_refs",
        "operation_instance_ids"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "event_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "event_role": {
          "enum": [
            "TEXT_AMENDMENT",
            "EDITORIAL_AMENDMENT",
            "TEXT_AMENDMENT_WITH_EFFECT",
            "EDITORIAL_AMENDMENT_WITH_EFFECT",
            "COMMENCEMENT_OR_EFFECT",
            "APPLICABILITY_OR_TRANSITION"
          ]
        },
        "amendment_evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "effect_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "effective_state_decision_ref": {
          "$ref": "#/$defs/decision_ref"
        },
        "affected_location_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "authentic_language_source_unit_refs": {
          "$ref": "#/$defs/authentic_source_units"
        },
        "operation_instance_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/rop_id"
          }
        }
      }
    },
    "dependency_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_affected_location_refs",
        "governing_context_location_refs",
        "dependent_location_refs",
        "independent_sibling_boundary_refs",
        "authentic_language_source_unit_refs",
        "dependency_rule",
        "closure_proof_fingerprint"
      ],
      "properties": {
        "primary_affected_location_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "governing_context_location_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "dependent_location_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "independent_sibling_boundary_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "authentic_language_source_unit_refs": {
          "$ref": "#/$defs/authentic_source_units"
        },
        "dependency_rule": {
          "$ref": "#/$defs/contract_ref"
        },
        "closure_proof_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "target_selector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selector_kind",
        "legal_location_ref",
        "tree_node_id",
        "structural_position",
        "anchor_fingerprint"
      ],
      "properties": {
        "selector_kind": {
          "enum": [
            "EXACT_TEXT_RANGE",
            "CLOSED_SCOPE_OCCURRENCES",
            "PARENT_ORDER_POSITION",
            "COMPLETE_NODE",
            "NEW_PARENT_ORDER",
            "CLOSED_STRUCTURED_REGION"
          ]
        },
        "legal_location_ref": {
          "$ref": "#/$defs/legal_location_ref"
        },
        "tree_node_id": {
          "type": "string",
          "pattern": "^node_[0-9a-f]{24}$"
        },
        "structural_position": {
          "enum": [
            "EXACT_RANGE",
            "CLOSED_SCOPE",
            "BEFORE",
            "AFTER",
            "INSIDE",
            "COMPLETE_NODE",
            "REGION"
          ]
        },
        "anchor_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "before_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_target_count",
        "location_refs",
        "structure_fingerprint",
        "content_fingerprint"
      ],
      "properties": {
        "expected_target_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "location_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "structure_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "content_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "after_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "location_refs",
        "structure_fingerprint",
        "source_unit_ownership_fingerprint",
        "content_fingerprint"
      ],
      "properties": {
        "location_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "structure_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "source_unit_ownership_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "content_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "op001_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_text_source_unit_ref",
        "replacement_source_unit_ref",
        "exact_range_fingerprint"
      ],
      "properties": {
        "old_text_source_unit_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "replacement_source_unit_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "exact_range_fingerprint": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "op002_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_phrase_source_unit_ref",
        "replacement_source_unit_ref",
        "closed_scope_location_refs",
        "expected_match_location_refs",
        "exclusion_location_refs"
      ],
      "properties": {
        "old_phrase_source_unit_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "replacement_source_unit_ref": {
          "$ref": "#/$defs/artifact_ref"
        },
        "closed_scope_location_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "expected_match_location_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        },
        "exclusion_location_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        }
      }
    },
    "op003_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_node_source_unit_refs",
        "parent_location_ref",
        "insertion_anchor"
      ],
      "properties": {
        "new_node_source_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "parent_location_ref": {
          "$ref": "#/$defs/legal_location_ref"
        },
        "insertion_anchor": {
          "enum": [
            "BEFORE",
            "AFTER",
            "FIRST_CHILD",
            "LAST_CHILD"
          ]
        }
      }
    },
    "op004_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed_node_source_unit_refs"
      ],
      "properties": {
        "removed_node_source_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "op005_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement_node_source_unit_refs"
      ],
      "properties": {
        "replacement_node_source_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        }
      }
    },
    "op006_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_source_unit_refs",
        "cross_reference_repairs"
      ],
      "properties": {
        "label_source_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "cross_reference_repairs": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "op007_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moved_node_ref",
        "new_parent_ref",
        "new_position"
      ],
      "properties": {
        "moved_node_ref": {
          "$ref": "#/$defs/legal_location_ref"
        },
        "new_parent_ref": {
          "$ref": "#/$defs/legal_location_ref"
        },
        "new_position": {
          "enum": [
            "BEFORE",
            "AFTER",
            "FIRST_CHILD",
            "LAST_CHILD"
          ]
        }
      }
    },
    "op008_parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replacement_region_source_unit_refs",
        "renderer_contract_ref"
      ],
      "properties": {
        "replacement_region_source_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "renderer_contract_ref": {
          "$ref": "#/$defs/contract_ref"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "operation_instance_id",
        "operation_type_id",
        "atomic_group_id",
        "amendment_event_ref",
        "effect_event_refs",
        "source_unit_refs",
        "target_selector",
        "before_state",
        "parameters",
        "expected_after_state",
        "dependency_location_refs"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "operation_instance_id": {
          "$ref": "#/$defs/rop_id"
        },
        "operation_type_id": {
          "enum": [
            "HKRECON-OP-001",
            "HKRECON-OP-002",
            "HKRECON-OP-003",
            "HKRECON-OP-004",
            "HKRECON-OP-005",
            "HKRECON-OP-006",
            "HKRECON-OP-007",
            "HKRECON-OP-008"
          ]
        },
        "atomic_group_id": {
          "type": "string",
          "pattern": "^atomic-group-[0-9]{4}$"
        },
        "amendment_event_ref": {
          "$ref": "#/$defs/event_ref"
        },
        "effect_event_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/event_ref"
          }
        },
        "source_unit_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/artifact_ref"
          }
        },
        "target_selector": {
          "$ref": "#/$defs/target_selector"
        },
        "before_state": {
          "$ref": "#/$defs/before_state"
        },
        "parameters": {
          "type": "object"
        },
        "expected_after_state": {
          "$ref": "#/$defs/after_state"
        },
        "dependency_location_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/legal_location_ref"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-001"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op001_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-002"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op002_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-003"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op003_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-004"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op004_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-005"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op005_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-006"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op006_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-007"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op007_parameters"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation_type_id": {
                "const": "HKRECON-OP-008"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "#/$defs/op008_parameters"
              }
            }
          }
        }
      ]
    },
    "language_stream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "language_effect",
        "base_language_tree_ref",
        "base_language_tree_fingerprint",
