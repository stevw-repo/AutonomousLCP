{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-execution-report.schema.json",
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "local_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"$ref": "#/$defs/local_id"},
        "ref_id": {"$ref": "#/$defs/local_id"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"const": "RECONSTRUCTION_PLAN"},
        "ref_id": {"type": "string", "pattern": "^rpl_[0-9a-f]{48}$"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "rca_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"const": "RECONSTRUCTED_CONSOLIDATION_ARTIFACT"},
        "ref_id": {"type": "string", "pattern": "^rca_[0-9a-f]{48}$"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "version", "fingerprint"],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,127}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "member_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstructed_consolidation_artifact_ref", "role", "path", "media_type", "byte_size", "fingerprint"],
      "properties": {
        "reconstructed_consolidation_artifact_ref": {"$ref": "#/$defs/rca_ref"},
        "role": {"enum": ["MANIFEST", "TREE_EN", "TREE_ZH_HANT", "SOURCE_UNITS_EN", "SOURCE_UNITS_ZH_HANT", "RECONSTRUCTED_LOCATION_UNITS", "BILINGUAL_ALIGNMENT_MAP", "DEPENDENCY_CLOSURE_PROOF", "SOURCE_UNIT_COVERAGE_PROOF", "DERIVATION_MAP", "IDENTITY_LINEAGE_RESULT"]},
        "path": {"enum": ["manifest.json", "trees/en.json", "trees/zh-Hant.json", "source-units/en.jsonl", "source-units/zh-Hant.jsonl", "reconstructed-location-units.jsonl", "bilingual-alignment-map.json", "dependency-closure-proof.json", "source-unit-coverage-proof.json", "derivation-map.json", "identity-lineage-result.json"]},
        "media_type": {"enum": ["application/json", "application/x-ndjson"]},
        "byte_size": {"type": "integer", "minimum": 1},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "report_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_rulebook", "operation_registry", "source_interpretation", "source_tree", "renderer", "alignment", "identity", "lineage", "traceability", "execution", "artifact", "report"],
      "properties": {
        "source_rulebook": {"$ref": "#/$defs/contract_ref"},
        "operation_registry": {"$ref": "#/$defs/contract_ref"},
        "source_interpretation": {"$ref": "#/$defs/contract_ref"},
        "source_tree": {"$ref": "#/$defs/contract_ref"},
        "renderer": {"$ref": "#/$defs/contract_ref"},
        "alignment": {"$ref": "#/$defs/contract_ref"},
        "identity": {"$ref": "#/$defs/contract_ref"},
        "lineage": {"$ref": "#/$defs/contract_ref"},
        "traceability": {"$ref": "#/$defs/contract_ref"},
        "execution": {"$ref": "#/$defs/contract_ref"},
        "artifact": {"$ref": "#/$defs/contract_ref"},
        "report": {"$ref": "#/$defs/contract_ref"}
      }
    },
    "base_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_version_ref", "canonical_bilingual_base_fingerprint", "source_version_date", "evidence_class", "identity_match", "fingerprint_match", "version_match", "latest_eligible_base", "complete"],
      "properties": {
        "official_version_ref": {"$ref": "#/$defs/reference"},
        "canonical_bilingual_base_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "source_version_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "evidence_class": {"enum": ["VERIFIED", "ASSISTED"]},
        "identity_match": {"type": "boolean"},
        "fingerprint_match": {"type": "boolean"},
        "version_match": {"type": "boolean"},
        "latest_eligible_base": {"type": "boolean"},
        "complete": {"type": "boolean"}
      }
    },
    "event_chain_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_refs", "event_count", "operation_binding_count", "complete", "ordered", "applicability_bound", "operations_bound"],
      "properties": {
        "event_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "event_count": {"type": "integer", "minimum": 1},
        "operation_binding_count": {"type": "integer", "minimum": 1},
        "complete": {"type": "boolean"},
        "ordered": {"type": "boolean"},
        "applicability_bound": {"type": "boolean"},
        "operations_bound": {"type": "boolean"}
      }
    },
    "dependency_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["affected_location_refs", "closure_proof_fingerprint", "artifact_dependency_proof_ref", "complete", "ownership_complete", "overlap_absent", "independence_proved"],
      "properties": {
        "affected_location_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "closure_proof_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "artifact_dependency_proof_ref": {"oneOf": [{"$ref": "#/$defs/member_ref"}, {"type": "null"}]},
        "complete": {"type": "boolean"},
        "ownership_complete": {"type": "boolean"},
        "overlap_absent": {"type": "boolean"},
        "independence_proved": {"type": "boolean"}
      }
    },
    "language_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "operation_results", "final_tree_ref", "final_tree_fingerprint", "final_source_unit_inventory_fingerprint", "complete_source_unit_coverage", "processing_outcome"],
      "properties": {
        "language": {"enum": ["en", "zh-Hant"]},
        "operation_results": {"type": "array", "items": {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-execution.schema.json#/$defs/operation_result"}},
        "final_tree_ref": {"oneOf": [{"$ref": "#/$defs/member_ref"}, {"type": "null"}]},
        "final_tree_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "final_source_unit_inventory_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "complete_source_unit_coverage": {"type": "boolean"},
        "processing_outcome": {"enum": ["PASS", "BLOCK"]}
      }
    },
    "bilingual_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_alignment_map_ref", "final_alignment_map_ref", "final_alignment_fingerprint", "complete", "legal_effect_bound"],
      "properties": {
        "expected_alignment_map_ref": {"$ref": "#/$defs/reference"},
        "final_alignment_map_ref": {"oneOf": [{"$ref": "#/$defs/member_ref"}, {"type": "null"}]},
        "final_alignment_fingerprint": {"oneOf": [{"$ref": "#/$defs/fingerprint"}, {"type": "null"}]},
        "complete": {"type": "boolean"},
        "legal_effect_bound": {"type": "boolean"}
      }
    },
    "success_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstructed_consolidation_artifact_ref", "manifest_ref", "en_final_tree_ref", "zh_hant_final_tree_ref", "canonical_bilingual_output_ref", "bilingual_alignment_map_ref", "dependency_closure_proof_ref", "source_unit_coverage_proof_ref", "affected_legal_location_refs", "affected_location_inventory_fingerprint", "traceability_binding_fingerprint", "record_output"],
      "properties": {
        "reconstructed_consolidation_artifact_ref": {"$ref": "#/$defs/rca_ref"},
        "manifest_ref": {"$ref": "#/$defs/member_ref"},
        "en_final_tree_ref": {"$ref": "#/$defs/member_ref"},
        "zh_hant_final_tree_ref": {"$ref": "#/$defs/member_ref"},
        "canonical_bilingual_output_ref": {"$ref": "#/$defs/member_ref"},
        "bilingual_alignment_map_ref": {"$ref": "#/$defs/member_ref"},
        "dependency_closure_proof_ref": {"$ref": "#/$defs/member_ref"},
        "source_unit_coverage_proof_ref": {"$ref": "#/$defs/member_ref"},
        "affected_legal_location_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "affected_location_inventory_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "traceability_binding_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "record_output": {"const": "NONE"}
      }
    },
    "no_output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_output", "reconstructed_artifact_count", "artifact_refs"],
      "properties": {
        "record_output": {"const": "NONE"},
        "reconstructed_artifact_count": {"const": 0},
        "artifact_refs": {"type": "array", "maxItems": 0}
      }
    },
    "coverage_consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_gap_ref", "disposition", "matching_hkel_consolidation_required", "fallback_selection_ref"],
      "properties": {
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "disposition": {"enum": ["ACTIVE_MISSING_CONSOLIDATION", "EXECUTION_FAILED"]},
        "matching_hkel_consolidation_required": {"const": true},
        "fallback_selection_ref": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]}
      }
    },
    "artifact_build_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstructed_consolidation_artifact_id", "base_language_trees", "coverage_gap_ref", "identity_lineage_decision_ref", "operative_state_decision_ref", "contracts", "authority_note_template_contract_ref", "lineage_links"],
      "properties": {
        "reconstructed_consolidation_artifact_id": {"type": "string", "pattern": "^rca_[0-9a-f]{48}$"},
        "base_language_trees": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-canonical-language-tree.schema.json", "properties": {"language": {"const": "en"}}},
            {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-canonical-language-tree.schema.json", "properties": {"language": {"const": "zh-Hant"}}}
          ],
          "items": false
        },
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "identity_lineage_decision_ref": {"$ref": "#/$defs/reference"},
        "operative_state_decision_ref": {"$ref": "#/$defs/reference"},
        "contracts": {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-reconstructed-consolidation-artifact.schema.json#/$defs/artifact_contracts"},
        "authority_note_template_contract_ref": {"$ref": "#/$defs/contract_ref"},
        "lineage_links": {"type": "array", "items": {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-reconstructed-consolidation-artifact.schema.json#/$defs/lineage_link"}}
      }
    },
    "report_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reconstruction_execution_report_id", "plan", "execution", "engine_build_ref", "contracts", "coverage_gap_ref", "artifact_build", "fallback_selection_ref"],
      "properties": {
        "reconstruction_execution_report_id": {"type": "string", "pattern": "^rex_[0-9a-f]{48}$"},
        "plan": {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-plan-validation.schema.json#/$defs/plan"},
        "execution": {"$ref": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-execution.schema.json#/$defs/execution_result"},
        "engine_build_ref": {"$ref": "#/$defs/reference"},
        "contracts": {"$ref": "#/$defs/report_contracts"},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "artifact_build": {"oneOf": [{"$ref": "#/$defs/artifact_build_input"}, {"type": "null"}]},
        "fallback_selection_ref": {"oneOf": [{"$ref": "#/$defs/reference"}, {"type": "null"}]}
      }
    },
    "reason_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.reconstruction-report.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome"],
            "properties": {
              "code": {"$ref": "#/$defs/local_id"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "OPERATION"]}
            }
          }
        }
      }
    },
    "artifact_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "input_authority", "package_boundary", "derivation_rule", "output_authority", "provider_rule"],
      "properties": {
        "rule_id": {"const": "HKLEG-RECON-ARTIFACT-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "IMMUTABLE_RECONSTRUCTED_CONSOLIDATION_ARTIFACT"},
        "input_authority": {"const": "EXACT_PLAN_AND_SUCCESSFUL_PROVISIONAL_EXECUTION_ONLY"},
        "package_boundary": {"const": "ELEVEN_FIXED_CANONICAL_MEMBERS"},
        "derivation_rule": {"const": "EVERY_FINAL_BYTE_AND_STRUCTURE_HAS_EXACT_BASE_OR_OPERATION_OWNERSHIP"},
        "output_authority": {"const": "INTERNAL_RECONSTRUCTION_ARTIFACT_ONLY"},
        "provider_rule": {"const": "NO_REPORT_RECORD_PROVIDER_OR_EXTERNAL_EFFECT"}
      }
    },
    "report_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "input_authority", "accounting_rule", "success_rule", "failure_rule", "output_authority", "provider_rule"],
      "properties": {
        "rule_id": {"const": "HKLEG-RECON-REPORT-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "IMMUTABLE_RECONSTRUCTION_EXECUTION_REPORT"},
        "input_authority": {"const": "EXACT_PLAN_EXECUTION_AND_OPTIONAL_VALIDATED_ARTIFACT_ONLY"},
        "accounting_rule": {"const": "EVERY_PLAN_OPERATION_REPORTED_ONCE_IN_PLAN_ORDER"},
        "success_rule": {"const": "PASS_REQUIRES_EXACT_RECONSTRUCTION_ARTIFACT"},
        "failure_rule": {"const": "BLOCK_OR_QUARANTINE_EMITS_NO_ARTIFACT_OR_RECORD"},
        "output_authority": {"const": "EVIDENCE_REPORT_ONLY"},
        "provider_rule": {"const": "NO_RECORD_PROVIDER_OR_EXTERNAL_EFFECT"}
      }
    },
    "fixture_id": {"type": "string", "pattern": "^HKLEG-RECON-REPORT-FIX-00[12]$"},
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"$ref": "#/$defs/fixture_id"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "input": {"$ref": "#/$defs/report_request"},
        "expected_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/reconstruction-report/HKLEG-RECON-REPORT-FIX-00[12]\\.json$"},
            "fingerprint": {"$ref": "#/$defs/fingerprint"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.reconstruction-report.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"$ref": "#/$defs/fixture_id"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-RECON-REPORT-FIX-00[12]\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/fingerprint"},
              "expected_path": {"type": "string", "pattern": "^expected/reconstruction-report/HKLEG-RECON-REPORT-FIX-00[12]\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/fingerprint"}
            }
          }
        }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$schema", "contract_version", "reconstruction_execution_report_id", "reconstruction_plan_ref", "engine_build_ref", "contracts", "base_validation", "event_chain_validation", "dependency_validation", "language_results", "bilingual_validation", "processing_outcome", "source_contract_review_required", "reason_codes", "rule_trace", "artifact_output", "coverage_consequence", "selection_consequence", "external_effects"],
      "properties": {
        "$schema": {"const": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-execution-report.schema.json"},
        "contract_version": {"const": "1.0.0"},
        "reconstruction_execution_report_id": {"type": "string", "pattern": "^rex_[0-9a-f]{48}$"},
        "reconstruction_plan_ref": {"$ref": "#/$defs/plan_ref"},
        "engine_build_ref": {"$ref": "#/$defs/reference"},
        "contracts": {"$ref": "#/$defs/report_contracts"},
        "base_validation": {"$ref": "#/$defs/base_validation"},
        "event_chain_validation": {"$ref": "#/$defs/event_chain_validation"},
        "dependency_validation": {"$ref": "#/$defs/dependency_validation"},
        "language_results": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/language_result"}},
        "bilingual_validation": {"$ref": "#/$defs/bilingual_validation"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "source_contract_review_required": {"type": "boolean"},
        "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}},
        "rule_trace": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/local_id"}},
        "artifact_output": {"oneOf": [{"$ref": "#/$defs/success_output"}, {"$ref": "#/$defs/no_output"}]},
        "coverage_consequence": {"$ref": "#/$defs/coverage_consequence"},
        "selection_consequence": {"enum": ["RECONSTRUCTION", "FALLBACK", "NO_RECORD"]},
        "external_effects": {"const": "NONE"}
      },
      "allOf": [
        {
          "if": {"properties": {"processing_outcome": {"const": "PASS"}}, "required": ["processing_outcome"]},
          "then": {
            "properties": {
              "artifact_output": {"$ref": "#/$defs/success_output"},
              "selection_consequence": {"const": "RECONSTRUCTION"},
              "reason_codes": {"contains": {"const": "RECONSTRUCTION_COMPLETE"}},
              "coverage_consequence": {"properties": {"disposition": {"const": "ACTIVE_MISSING_CONSOLIDATION"}, "fallback_selection_ref": {"type": "null"}}}
            }
          },
          "else": {
            "properties": {
              "artifact_output": {"$ref": "#/$defs/no_output"},
              "selection_consequence": {"enum": ["FALLBACK", "NO_RECORD"]},
              "coverage_consequence": {"properties": {"disposition": {"const": "EXECUTION_FAILED"}}}
            }
          }
        }
      ]
    }
  },
  "$ref": "#/$defs/report"
}
