{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-partition.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fixture_id": {
      "enum": [
        "HKLEG-RECON-ORP-FIX-001",
        "HKLEG-RECON-ORP-FIX-002",
        "HKLEG-RECON-ORP-FIX-003",
        "HKLEG-RECON-ORP-FIX-004",
        "HKLEG-RECON-ORP-FIX-005",
        "HKLEG-RECON-ORP-FIX-006",
        "HKLEG-RECON-ORP-FIX-007",
        "HKLEG-RECON-ORP-FIX-008",
        "HKLEG-RECON-ORP-FIX-009",
        "HKLEG-RECON-ORP-FIX-010",
        "HKLEG-RECON-ORP-FIX-011",
        "HKLEG-RECON-ORP-FIX-012",
        "HKLEG-RECON-ORP-FIX-013",
        "HKLEG-RECON-ORP-FIX-014",
        "HKLEG-RECON-ORP-FIX-015",
        "HKLEG-RECON-ORP-FIX-016",
        "HKLEG-RECON-ORP-FIX-017",
        "HKLEG-RECON-ORP-FIX-018",
        "HKLEG-RECON-ORP-FIX-019",
        "HKLEG-RECON-ORP-FIX-020",
        "HKLEG-RECON-ORP-FIX-021",
        "HKLEG-RECON-ORP-FIX-022"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"type": "string", "minLength": 1},
        "ref_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "nullable_reference": {
      "oneOf": [
        {"$ref": "#/$defs/reference"},
        {"type": "null"}
      ]
    },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "serving_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id", "profile_fingerprint", "tokenizer_id", "max_text_tokens",
        "max_metadata_bytes", "country", "jurisdiction", "material_type", "source",
        "authority_note"
      ],
      "properties": {
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9]{2}_[0-9a-f]{48}$"},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"},
        "tokenizer_id": {"const": "TEST_UTF8_BYTES_1.0.0"},
        "max_text_tokens": {"type": "integer", "minimum": 1},
        "max_metadata_bytes": {"type": "integer", "minimum": 1},
        "country": {"const": "Hong Kong"},
        "jurisdiction": {"const": "Hong Kong"},
        "material_type": {"const": "legislation"},
        "source": {"const": "Hong Kong e-Legislation"},
        "authority_note": {"type": "string", "minLength": 1}
      }
    },
    "partition_node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_node_id", "en_tree_node_id", "zh_hant_tree_node_id",
        "primary_alignment_group_ids", "dependency_alignment_group_ids",
        "child_partition_node_ids", "source_contract_state", "indivisible"
      ],
      "properties": {
        "partition_node_id": {"type": "string", "minLength": 1},
        "en_tree_node_id": {"type": "string", "minLength": 1},
        "zh_hant_tree_node_id": {"type": "string", "minLength": 1},
        "primary_alignment_group_ids": {"$ref": "#/$defs/string_array"},
        "dependency_alignment_group_ids": {"$ref": "#/$defs/string_array"},
        "child_partition_node_ids": {"$ref": "#/$defs/string_array"},
        "source_contract_state": {"enum": ["SUPPORTED", "UNKNOWN"]},
        "indivisible": {"type": "boolean"}
      }
    },
    "partition_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legal_location_ref", "en_tree_fingerprint", "zh_hant_tree_fingerprint",
        "alignment_map_fingerprint", "root_partition_node_ids", "nodes"
      ],
      "properties": {
        "legal_location_ref": {"$ref": "#/$defs/reference"},
        "en_tree_fingerprint": {"$ref": "#/$defs/sha256"},
        "zh_hant_tree_fingerprint": {"$ref": "#/$defs/sha256"},
        "alignment_map_fingerprint": {"$ref": "#/$defs/sha256"},
        "root_partition_node_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "nodes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/partition_node"}
        }
      }
    },
    "release_consequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition_result_fingerprint", "new_official_version_ref",
        "previous_official_version_ref", "previous_release_ref", "previous_target_ref",
        "decision", "decision_ref", "decision_evidence_ref", "audit_history_ref",
        "coverage_gap_ref", "decision_reason", "legal_desk_author", "last_verified_at",
        "decided_at", "review_deadline", "continued_serving_supported",
        "affirmative_record_change_proved", "existing_records_materially_misleading",
        "withholding_supported", "selected_release_ref", "withholding_release_ref", "warning"
      ],
      "properties": {
        "partition_result_fingerprint": {"$ref": "#/$defs/sha256"},
        "new_official_version_ref": {"$ref": "#/$defs/reference"},
        "previous_official_version_ref": {"$ref": "#/$defs/reference"},
        "previous_release_ref": {"$ref": "#/$defs/reference"},
        "previous_target_ref": {"$ref": "#/$defs/reference"},
        "decision": {
          "enum": [
            "CARRY_FORWARD_LAST_APPROVED_RELEASE",
            "CREATE_WITHHOLDING_RELEASE",
            "NO_JURISDICTION_REBUILD"
          ]
        },
        "decision_ref": {"$ref": "#/$defs/reference"},
        "decision_evidence_ref": {"$ref": "#/$defs/reference"},
        "audit_history_ref": {"$ref": "#/$defs/reference"},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "decision_reason": {"type": "string", "minLength": 1},
        "legal_desk_author": {"type": "string", "minLength": 1},
        "last_verified_at": {"type": "string", "minLength": 1},
        "decided_at": {"type": "string", "minLength": 1},
        "review_deadline": {"type": "string", "minLength": 1},
        "continued_serving_supported": {"type": "boolean"},
        "affirmative_record_change_proved": {"type": "boolean"},
        "existing_records_materially_misleading": {"type": "boolean"},
        "withholding_supported": {"type": "boolean"},
        "selected_release_ref": {"$ref": "#/$defs/nullable_reference"},
        "withholding_release_ref": {"$ref": "#/$defs/nullable_reference"},
        "warning": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en_tree", "zh_hant_tree", "alignment_map", "partition_request", "serving_profile"],
      "properties": {
        "en_tree": {"type": "object"},
        "zh_hant_tree": {"type": "object"},
        "alignment_map": {"type": "object"},
        "partition_request": {"$ref": "#/$defs/partition_request"},
        "serving_profile": {"$ref": "#/$defs/serving_profile"},
        "release_consequence": {"$ref": "#/$defs/release_consequence"}
      }
    },
    "batch_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locations"],
      "properties": {
        "locations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/input"}
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_bytes", "metadata_limit", "text_limit", "text_tokens"],
      "properties": {
        "metadata_bytes": {"type": "integer", "minimum": 0},
        "metadata_limit": {"type": "integer", "minimum": 1},
        "text_limit": {"type": "integer", "minimum": 1},
        "text_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_alignment_group_ids", "en_dependency_source_unit_ids",
        "en_primary_source_unit_ids", "measurement", "part_number",
        "primary_alignment_group_ids", "primary_partition_node_ids",
        "serving_payload_fingerprint", "text", "text_fingerprint", "total_parts",
        "zh_hant_dependency_source_unit_ids", "zh_hant_primary_source_unit_ids"
      ],
      "properties": {
        "dependency_alignment_group_ids": {"$ref": "#/$defs/string_array"},
        "en_dependency_source_unit_ids": {"$ref": "#/$defs/string_array"},
        "en_primary_source_unit_ids": {"$ref": "#/$defs/string_array"},
        "measurement": {"$ref": "#/$defs/measurement"},
        "part_number": {"type": "integer", "minimum": 1},
        "primary_alignment_group_ids": {"$ref": "#/$defs/string_array"},
        "primary_partition_node_ids": {"$ref": "#/$defs/string_array"},
        "serving_payload_fingerprint": {"$ref": "#/$defs/sha256"},
        "text": {"type": "string", "minLength": 1},
        "text_fingerprint": {"$ref": "#/$defs/sha256"},
        "total_parts": {"type": "integer", "minimum": 1},
        "zh_hant_dependency_source_unit_ids": {"$ref": "#/$defs/string_array"},
        "zh_hant_primary_source_unit_ids": {"$ref": "#/$defs/string_array"}
      }
    },
    "reason": {
      "enum": [
        "BILINGUAL_ALIGNMENT_MISMATCH", "CANONICAL_PARTITION_DEFECT",
        "EXPLICIT_UNSAFE_NEW_VERSION_CONSEQUENCE", "LOCATIONS_PROCESSED_SEPARATELY",
        "PASS_PARTITIONED", "PASS_UNSPLIT",
        "SMALLEST_DEPENDENT_BRANCH_OVER_LIMIT",
        "SOURCE_CONTRACT_REVIEW_REQUIRED", "SOURCE_LOCATION_OWNERSHIP_DEFECT",
        "SOURCE_UNIT_COVERAGE_DEFECT"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alignment_map_fingerprint", "coverage_gap_required", "disposition",
        "en_tree_fingerprint", "external_effects", "parts", "profile_fingerprint",
        "profile_id", "quarantined_partition_node_ids", "reason",
        "search_record_output", "zh_hant_tree_fingerprint"
      ],
      "properties": {
        "alignment_map_fingerprint": {"$ref": "#/$defs/sha256"},
        "coverage_gap_required": {"type": "boolean"},
        "disposition": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "en_tree_fingerprint": {"$ref": "#/$defs/sha256"},
        "external_effects": {"const": "NONE"},
        "parts": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/part"}},
        "profile_fingerprint": {"$ref": "#/$defs/sha256"},
        "profile_id": {"type": "string", "pattern": "^[a-z][a-z0-9]{2}_[0-9a-f]{48}$"},
        "quarantined_partition_node_ids": {"$ref": "#/$defs/string_array"},
        "reason": {"$ref": "#/$defs/reason"},
        "search_record_output": {"const": "NONE"},
        "zh_hant_tree_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "batch_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coverage_gap_required", "cross_location_combination", "disposition",
        "external_effects", "location_results", "parts", "reason",
        "search_record_output"
      ],
      "properties": {
        "coverage_gap_required": {"type": "boolean"},
        "cross_location_combination": {"const": "FORBIDDEN"},
        "disposition": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "external_effects": {"const": "NONE"},
        "location_results": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legal_location_ref", "partition_result"],
            "properties": {
              "legal_location_ref": {"$ref": "#/$defs/reference"},
              "partition_result": {"$ref": "#/$defs/result"}
            }
          }
        },
        "parts": {"type": "array", "maxItems": 0},
        "reason": {"const": "LOCATIONS_PROCESSED_SEPARATELY"},
        "search_record_output": {"const": "NONE"}
      }
    },
    "consequence_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_required", "affirmative_record_change_proved", "audit_history_ref",
        "coverage_gap_ref", "coverage_gap_required", "continued_serving_supported",
        "decided_at", "decision", "decision_evidence_ref", "decision_reason",
        "decision_ref", "disposition", "existing_records_materially_misleading",
        "external_effects", "last_verified_at", "legal_desk_author",
        "new_official_version_ref", "partition_result_fingerprint", "parts",
        "predecessor_retirement", "previous_official_version_ref", "previous_release_ref",
        "previous_target_ref", "reason", "release_action", "review_deadline",
        "routing_action", "search_record_output", "selected_release_ref", "warning",
        "withholding_release_ref", "withholding_supported"
      ],
      "properties": {
        "approval_required": {"type": "boolean"},
        "affirmative_record_change_proved": {"type": "boolean"},
        "audit_history_ref": {"$ref": "#/$defs/reference"},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "coverage_gap_required": {"const": true},
        "continued_serving_supported": {"type": "boolean"},
        "decided_at": {"type": "string", "minLength": 1},
        "decision": {
          "enum": [
            "CARRY_FORWARD_LAST_APPROVED_RELEASE",
            "CREATE_WITHHOLDING_RELEASE",
            "NO_JURISDICTION_REBUILD"
          ]
        },
        "decision_evidence_ref": {"$ref": "#/$defs/reference"},
        "decision_reason": {"type": "string", "minLength": 1},
        "decision_ref": {"$ref": "#/$defs/reference"},
        "disposition": {"const": "PASS"},
        "existing_records_materially_misleading": {"type": "boolean"},
        "external_effects": {"const": "NONE"},
        "last_verified_at": {"type": "string", "minLength": 1},
        "legal_desk_author": {"type": "string", "minLength": 1},
        "new_official_version_ref": {"$ref": "#/$defs/reference"},
        "partition_result_fingerprint": {"$ref": "#/$defs/sha256"},
        "parts": {"type": "array", "maxItems": 0},
        "predecessor_retirement": {"const": "FORBIDDEN"},
        "previous_official_version_ref": {"$ref": "#/$defs/reference"},
        "previous_release_ref": {"$ref": "#/$defs/reference"},
        "previous_target_ref": {"$ref": "#/$defs/reference"},
        "reason": {"const": "EXPLICIT_UNSAFE_NEW_VERSION_CONSEQUENCE"},
        "release_action": {
          "enum": [
            "SELECT_LAST_APPROVED_WITH_WARNING",
            "CREATE_COMPLETE_WITHHOLDING_RELEASE",
            "NO_NEW_DESIRED_STATE"
          ]
        },
        "review_deadline": {"type": "string", "minLength": 1},
        "routing_action": {
          "enum": [
            "BUILD_EXPLICIT_CARRY_FORWARD_TARGET_AFTER_APPROVAL",
            "BUILD_AFTER_EXACT_APPROVAL",
            "RETAIN_PREVIOUS_VERIFIED_TARGET"
          ]
        },
        "search_record_output": {"const": "NONE"},
        "selected_release_ref": {"$ref": "#/$defs/nullable_reference"},
        "warning": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "withholding_release_ref": {"$ref": "#/$defs/nullable_reference"},
        "withholding_supported": {"type": "boolean"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "expected_artifact"],
      "oneOf": [
        {"required": ["input"], "not": {"required": ["batch_input"]}},
        {"required": ["batch_input"], "not": {"required": ["input"]}}
      ],
      "properties": {
        "fixture_id": {"$ref": "#/$defs/fixture_id"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "batch_input": {"$ref": "#/$defs/batch_input"},
        "expected_artifact": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/reconstruction-overlong-partition/HKLEG-RECON-ORP-FIX-[0-9]{3}\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.reconstruction-overlong-partition.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array", "minItems": 22, "maxItems": 22, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"$ref": "#/$defs/fixture_id"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-RECON-ORP-FIX-[0-9]{3}\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/reconstruction-overlong-partition/HKLEG-RECON-ORP-FIX-[0-9]{3}\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.reconstruction-overlong-partition.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome"],
            "properties": {
              "code": {"$ref": "#/$defs/reason"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": [
        "rule_id", "version", "stage", "input_authority", "renderer_contract", "measurement",
        "partition_boundary", "grouping", "dependency_rule", "output_authority",
        "provider_rule", "new_version_failure_consequence"
      ],
      "properties": {
        "rule_id": {"const": "HKLEG-RECON-ORP-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "SOURCE_NEUTRAL_CANONICAL_BILINGUAL_SERVING_PARTITION"},
        "input_authority": {"const": "SEALED_CANONICAL_TREES_ACCEPTED_ALIGNMENT_AND_PINNED_SERVING_PROFILE_ONLY"},
        "renderer_contract": {"const": "asklegal.hk-legislation.canonical-textual-bilingual-renderer/1.1.0"},
        "measurement": {"const": "EXACT_FINAL_TEXT_TOKENS_AND_SIX_FIELD_CANONICAL_METADATA_BYTES"},
        "partition_boundary": {"const": "RECURSIVE_COMPLETE_OFFICIAL_BILINGUAL_CHILDREN_ONLY"},
        "grouping": {"const": "MINIMUM_PARTS_THEN_EARLIEST_FULL_WITH_ACTUAL_LABELS"},
        "dependency_rule": {"const": "REPEAT_ONLY_REQUIRED_COMPLETE_BILINGUAL_CONTEXT"},
        "output_authority": {"const": "EFFECT_FREE_PARTITION_PROOF_OR_FAIL_VISIBLE_DISPOSITION_ONLY"},
        "provider_rule": {"const": "NO_SEARCH_RECORD_TOKENIZER_SELECTION_PROVIDER_OR_EXTERNAL_EFFECT"},
        "new_version_failure_consequence": {"const": "EXPLICIT_ADR_0005_DECISION_REQUIRED_NO_SILENT_REUSE_OR_RETIREMENT"}
      }
    }
  }
}
