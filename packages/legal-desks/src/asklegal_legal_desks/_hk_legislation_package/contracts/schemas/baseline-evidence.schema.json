{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-evidence.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {
      "enum": [
        "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95",
        "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e",
        "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"
      ]
    },
    "source_id": {
      "enum": [
        "HK-LEG-HKEL-CURRENT-DATA",
        "HK-LEG-HKEL-VERIFIED-COPIES",
        "HK-LEG-HKEL-ASSISTED-COPIES",
        "HK-LEG-HKEL-PAST-DATA"
      ]
    },
    "evidence_role": {
      "enum": ["EN_CURRENT_XML", "ZH_HANT_CURRENT_XML", "EN_OFFICIAL_COPY", "ZH_HANT_OFFICIAL_COPY"]
    },
    "source_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "source_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-evidence.source-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "source_codes": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "permitted_evidence_use"],
            "properties": {
              "code": {"$ref": "#/$defs/source_id"},
              "permitted_evidence_use": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-evidence.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome", "coverage_effect"],
            "properties": {
              "code": {"enum": [
                "HKLEG_BASE_EVIDENCE_RECONCILED",
                "HKLEG_BASE_EVIDENCE_REQUIRED_ARTIFACT_MISSING",
                "HKLEG_BASE_EVIDENCE_VERSION_OR_CONTENT_CONFLICT",
                "HKLEG_BASE_EVIDENCE_HISTORICAL_SUBSTITUTION_FORBIDDEN"
              ]},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
              "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "required_evidence_roles", "allowed_copy_statuses", "branch_precedence", "successor_rule_id", "forbidden_shortcuts"],
      "properties": {
        "rule_id": {"const": "HKLEG-BASE-EVID-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "FIRST_BASELINE_CURRENT_BILINGUAL_EVIDENCE"},
        "required_evidence_roles": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_role"}},
        "allowed_copy_statuses": {"const": ["VERIFIED", "ASSISTED"]},
        "branch_precedence": {"const": ["HISTORICAL_SUBSTITUTION_FORBIDDEN", "REQUIRED_ARTIFACT_MISSING", "VERSION_OR_CONTENT_CONFLICT", "EVIDENCE_RECONCILED"]},
        "successor_rule_id": {"const": "HKLEG-BASE-STATE-001"},
        "forbidden_shortcuts": {"const": ["MONOLINGUAL_FALLBACK", "XML_ONLY_PROOF", "COPY_ONLY_PROOF", "HISTORICAL_TEXT_AS_CURRENT", "AI_MISMATCH_CORRECTION"]}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "source_id", "representation", "language", "version_id", "copy_status", "content_fingerprint", "reconciliation"],
      "properties": {
        "artifact_id": {"type": "string", "pattern": "^SYN-HKLEG-EVID-[A-Z0-9-]+$"},
        "source_id": {"$ref": "#/$defs/source_id"},
        "representation": {"enum": ["CURRENT_XML", "OFFICIAL_COPY", "HISTORICAL_XML"]},
        "language": {"enum": ["en", "zh-Hant"]},
        "version_id": {"type": "string", "pattern": "^SYN-HKLEG-VER-[0-9]{3}$"},
        "copy_status": {"enum": ["NOT_APPLICABLE", "VERIFIED", "ASSISTED"]},
        "content_fingerprint": {"$ref": "#/$defs/sha256"},
        "reconciliation": {"enum": ["MATCH", "CONFLICT", "NOT_APPLICABLE"]}
      },
      "allOf": [
        {"if": {"properties": {"source_id": {"const": "HK-LEG-HKEL-CURRENT-DATA"}}}, "then": {"properties": {"representation": {"const": "CURRENT_XML"}, "copy_status": {"const": "NOT_APPLICABLE"}}}},
        {"if": {"properties": {"source_id": {"const": "HK-LEG-HKEL-VERIFIED-COPIES"}}}, "then": {"properties": {"representation": {"const": "OFFICIAL_COPY"}, "copy_status": {"const": "VERIFIED"}}}},
        {"if": {"properties": {"source_id": {"const": "HK-LEG-HKEL-ASSISTED-COPIES"}}}, "then": {"properties": {"representation": {"const": "OFFICIAL_COPY"}, "copy_status": {"const": "ASSISTED"}}}},
        {"if": {"properties": {"source_id": {"const": "HK-LEG-HKEL-PAST-DATA"}}}, "then": {"properties": {"representation": {"const": "HISTORICAL_XML"}, "copy_status": {"const": "NOT_APPLICABLE"}, "reconciliation": {"const": "NOT_APPLICABLE"}}}}
      ]
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["cutoff", "legal_object_id", "scope_id", "official_version_id", "artifacts"],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "legal_object_id": {"const": "SYN-HKLEG-OBJ-001"},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "official_version_id": {"const": "SYN-HKLEG-VER-001"},
        "artifacts": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/artifact"}}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-EVID-FIX-00[1-5]$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "rule_id": {"const": "HKLEG-BASE-EVID-001"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/baseline-evidence/HKLEG-BASE-EVID-FIX-00[1-5]\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-evidence.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-EVID-FIX-00[1-5]$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-EVID-FIX-00[1-5]\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/baseline-evidence/HKLEG-BASE-EVID-FIX-00[1-5]\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "evidence_mode", "accepted_artifact_ids", "unresolved_evidence_roles", "affected_scope_ids", "record_output", "next_action"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-EVID-FIX-00[1-5]$"},
        "rule_id": {"const": "HKLEG-BASE-EVID-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"},
        "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]},
        "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string"}},
        "rule_trace": {"const": ["HKLEG-BASE-EVID-001"]},
        "evidence_mode": {"enum": ["VERIFIED", "ASSISTED", "MIXED", "NONE"]},
        "accepted_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unresolved_evidence_roles": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/evidence_role"}},
        "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}},
        "record_output": {"const": "NONE"},
        "next_action": {"enum": ["RUN_HKLEG_BASE_STATE_001", "COMPLETE_CURRENT_BILINGUAL_EVIDENCE", "QUARANTINE_EVIDENCE_CONFLICT", "REJECT_HISTORICAL_SUBSTITUTION"]}
      }
    }
  }
}
