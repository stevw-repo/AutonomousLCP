{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-history.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {"enum": ["rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95", "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e", "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"]},
    "source_id": {"enum": ["HK-LEG-HKEL-PAST-INVENTORY", "HK-LEG-HKEL-PAST-DATA", "HK-LEG-OFFICIAL-GAZETTE-ARCHIVE", "HK-LEG-HKEL-GAZETTE-BACKCAPTURE"]},
    "fact_code": {"enum": ["IDENTITY_OR_CONTINUITY", "PRESENT_OPERATIVE_STATUS", "OWNERSHIP_REPLACEMENT_OR_CESSATION", "SOURCE_CONFLICT_RESOLUTION", "EARLIER_ARTIFACT_FACT"]},
    "reason_code": {"enum": ["HKLEG_BASE_HIST_PERMITTED_FACT_ESTABLISHED", "HKLEG_BASE_HIST_CURRENT_EVIDENCE_SUBSTITUTION_FORBIDDEN", "HKLEG_BASE_HIST_SIMILARITY_ONLY_FORBIDDEN", "HKLEG_BASE_HIST_REQUESTED_EVIDENCE_UNAVAILABLE", "HKLEG_BASE_HIST_EVIDENCE_CONFLICT", "HKLEG_BASE_HIST_EVIDENCE_INSUFFICIENT"]},
    "reason_code_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "reason_codes"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-history.reason-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "reason_codes": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}}}}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "version", "stage", "predecessor_rule_id", "branch_precedence", "permitted_source_ids", "discovery_only_source_ids"], "properties": {"rule_id": {"const": "HKLEG-BASE-HIST-001"}, "version": {"const": "1.0.0"}, "stage": {"const": "FIRST_BASELINE_BOUNDED_HISTORICAL_EVIDENCE"}, "predecessor_rule_id": {"const": "HKLEG-BASE-REVIEW-001"}, "branch_precedence": {"const": ["CURRENT_EVIDENCE_SUBSTITUTION_FORBIDDEN", "REQUESTED_EVIDENCE_UNAVAILABLE", "SIMILARITY_ONLY_FORBIDDEN", "EVIDENCE_CONFLICT", "EVIDENCE_INSUFFICIENT", "PERMITTED_FACT_ESTABLISHED"]}, "permitted_source_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}}, "discovery_only_source_ids": {"const": ["HK-LEG-HKEL-PAST-INVENTORY", "HK-LEG-HKEL-GAZETTE-BACKCAPTURE"]}}},
    "review_task": {"type": "object", "additionalProperties": false, "required": ["review_task_id", "requested_source_ids", "permitted_fact_code"], "properties": {"review_task_id": {"type": "string", "minLength": 1}, "requested_source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}}, "permitted_fact_code": {"$ref": "#/$defs/fact_code"}}},
    "historical_evidence": {"type": "object", "additionalProperties": false, "required": ["source_id", "availability", "evidence_result", "proof_basis"], "properties": {"source_id": {"$ref": "#/$defs/source_id"}, "availability": {"enum": ["AVAILABLE", "UNAVAILABLE"]}, "evidence_result": {"enum": ["PROVES_PERMITTED_FACT", "SIMILARITY_ONLY", "CONFLICT", "INSUFFICIENT"]}, "proof_basis": {"enum": ["EXPLICIT_OFFICIAL_EVIDENCE", "SIMILARITY_ONLY", "NONE"]}}},
    "input": {"type": "object", "additionalProperties": false, "required": ["cutoff", "scope_id", "affected_object_ids", "review_task", "historical_evidence", "proposed_fact_code", "attempted_current_evidence_substitution", "attempted_reconstruction", "scope_completeness_impossible"], "properties": {"cutoff": {"const": "2026-08-17T00:00:00Z"}, "scope_id": {"$ref": "#/$defs/scope_id"}, "affected_object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "review_task": {"$ref": "#/$defs/review_task"}, "historical_evidence": {"$ref": "#/$defs/historical_evidence"}, "proposed_fact_code": {"$ref": "#/$defs/fact_code"}, "attempted_current_evidence_substitution": {"type": "boolean"}, "attempted_reconstruction": {"type": "boolean"}, "scope_completeness_impossible": {"type": "boolean"}}},
    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-HIST-FIX-00[1-6]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"}, "rule_id": {"const": "HKLEG-BASE-HIST-001"}, "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"}, "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/baseline-history/HKLEG-BASE-HIST-FIX-00[1-6]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}}},
    "fixture_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-history.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false}, "fixtures": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-HIST-FIX-00[1-6]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-HIST-FIX-00[1-6]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/baseline-history/HKLEG-BASE-HIST-FIX-00[1-6]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "established_fact_code", "affected_object_ids", "unaffected_work_may_continue", "affected_scope_ids", "record_output", "next_action"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-HIST-FIX-00[1-6]$"}, "rule_id": {"const": "HKLEG-BASE-HIST-001"}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}, "legal_disposition": {"const": "NOT_APPLICABLE"}, "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]}, "source_contract_review_required": {"const": false}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"const": ["HKLEG-BASE-HIST-001"]}, "established_fact_code": {"oneOf": [{"$ref": "#/$defs/fact_code"}, {"type": "null"}]}, "affected_object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "unaffected_work_may_continue": {"type": "boolean"}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}}, "record_output": {"const": "NONE"}, "next_action": {"enum": ["RESUME_BASELINE_DECISION", "USE_CURRENT_EVIDENCE_OR_SEPARATE_RECONSTRUCTION_PATH", "BLOCK_AFFECTED_DECISION", "REQUIRE_EXPLICIT_OFFICIAL_EVIDENCE", "QUARANTINE_AFFECTED_DECISION"]}}}
  }
}
