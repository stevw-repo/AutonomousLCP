    "fixture":{"type":"object","additionalProperties":false,"required":["fixture_id","title","synthetic","status","input_fingerprint","input","expected_artifact"],"properties":{"fixture_id":{"type":"string","pattern":"^HKLEG-CURRENT-CAUSE-FIX-00[1-6]$"},"title":{"type":"string","minLength":1},"synthetic":{"const":true},"status":{"const":"FROZEN_PARTIAL"},"input_fingerprint":{"$ref":"#/$defs/sha256"},"input":{"$ref":"#/$defs/input"},"expected_artifact":{"type":"object","additionalProperties":false,"required":["path","fingerprint"],"properties":{"path":{"type":"string","pattern":"^expected/current-cause/HKLEG-CURRENT-CAUSE-FIX-00[1-6]\\.json$"},"fingerprint":{"$ref":"#/$defs/sha256"}}}}},
    "fixture_catalogue":{"type":"object","additionalProperties":false,"required":["catalogue_id","version","status","accepted_complete_universe","fixtures"],"properties":{"catalogue_id":{"const":"asklegal.hk-legislation.current-cause.fixtures"},"version":{"const":"1.0.0"},"status":{"const":"FROZEN_PARTIAL"},"accepted_complete_universe":{"const":false},"fixtures":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["fixture_id","path","fixture_fingerprint","expected_path","expected_fingerprint"],"properties":{"fixture_id":{"type":"string","pattern":"^HKLEG-CURRENT-CAUSE-FIX-00[1-6]$"},"path":{"type":"string","pattern":"^fixtures/deterministic/HKLEG-CURRENT-CAUSE-FIX-00[1-6]\\.json$"},"fixture_fingerprint":{"$ref":"#/$defs/sha256"},"expected_path":{"type":"string","pattern":"^expected/current-cause/HKLEG-CURRENT-CAUSE-FIX-00[1-6]\\.json$"},"expected_fingerprint":{"$ref":"#/$defs/sha256"}}}}}},
    "decision":{"type":"object","additionalProperties":false,"required":["fixture_id","rule_id","processing_outcome","legal_disposition","coverage_effect","source_contract_review_required","reason_codes","rule_trace","cause_class","affected_object_ids","affected_scope_ids","affected_location_ids","publication_date","effective_date","identity_or_status_inference","record_output","next_action"],"properties":{"fixture_id":{"type":"string","pattern":"^HKLEG-CURRENT-CAUSE-FIX-00[1-6]$"},"rule_id":{"$ref":"#/$defs/rule_id"},"processing_outcome":{"enum":["PASS","BLOCK","QUARANTINE"]},"legal_disposition":{"const":"NOT_APPLICABLE"},"coverage_effect":{"const":"NONE"},"source_contract_review_required":{"type":"boolean"},"reason_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/reason_code"}},"rule_trace":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/rule_id"}},"cause_class":{"oneOf":[{"enum":["GAZETTE_EVENT","EDITORIAL_RECORD","NON_SERVING_TECHNICAL_REPUBLICATION"]},{"type":"null"}]},"affected_object_ids":{"type":"array","minItems":1,"maxItems":1,"items":{"type":"string","minLength":1}},"affected_scope_ids":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/scope_id"}},"affected_location_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"publication_date":{"$ref":"#/$defs/nullable_text"},"effective_date":{"$ref":"#/$defs/nullable_text"},"identity_or_status_inference":{"const":"NONE"},"record_output":{"const":"NONE"},"next_action":{"enum":["RUN_HKLEG_CURRENT_DISP_001","RUN_HKLEG_CURRENT_REL_001","OPEN_SOURCE_CONTRACT_REVIEW","QUARANTINE_UNEXPLAINED_CHANGE"]}}}
