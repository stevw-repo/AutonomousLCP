    "reason_code_catalogue":{"type":"object","additionalProperties":false,"required":["catalogue_id","version","status","reason_codes"],"properties":{"catalogue_id":{"const":"asklegal.hk-legislation.current-cause.reason-codes"},"version":{"const":"1.0.0"},"status":{"const":"FROZEN_PARTIAL"},"reason_codes":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["code","meaning","processing_outcome"],"properties":{"code":{"$ref":"#/$defs/reason_code"},"meaning":{"type":"string","minLength":1},"processing_outcome":{"enum":["PASS","BLOCK","QUARANTINE"]}}}}}},
