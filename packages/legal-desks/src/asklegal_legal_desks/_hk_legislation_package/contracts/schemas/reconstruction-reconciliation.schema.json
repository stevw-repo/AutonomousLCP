{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-reconstruction-reconciliation.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"type": "string", "minLength": 1},
        "ref_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "monitoring_state": {
      "enum": [
        "AWAITING_HKEL_CONSOLIDATION", "HKEL_CANDIDATE_OBSERVED", "COMPARISON_DEFERRED",
        "MATCH_CONFIRMED", "MISMATCH_CONFIRMED", "SUPERSEDED_BY_HKEL",
        "SUSPENDED_PENDING_REVALIDATION", "REVALIDATED"
      ]
    },
    "comparison_class": {
      "enum": [
        "NONE", "EXACT_CANONICAL_MATCH", "PRESENTATION_ONLY_MATCH", "MATERIAL_MISMATCH",
        "COMPARISON_NOT_ISOLATABLE", "HKEL_CANDIDATE_INVALID"
      ]
    },
    "attribution_class": {
      "enum": [
        "BASE_SELECTION_DEFECT", "SOURCE_INTERPRETATION_DEFECT", "EVENT_CHAIN_DEFECT",
        "APPLICABILITY_DEFECT", "OPERATION_MAPPING_DEFECT", "OPERATION_EXECUTION_DEFECT",
        "BILINGUAL_OR_DEPENDENCY_DEFECT", "RENDERING_OR_PARTITION_DEFECT",
        "IDENTITY_OR_LINEAGE_DEFECT", "SOURCE_EVIDENCE_DEFECT",
        "UNRESOLVED_RECONSTRUCTION_MISMATCH"
      ]
    },
    "reason_code": {
      "enum": [
        "HKLEG_RECON_RECONCILE_UNCHANGED_SIGNAL", "HKLEG_RECON_RECONCILE_CANDIDATE_OBSERVED",
        "HKLEG_RECON_RECONCILE_HKEL_CANDIDATE_INVALID", "HKLEG_RECON_RECONCILE_MATCH_CONFIRMED",
        "HKLEG_RECON_RECONCILE_COMPARISON_NOT_ISOLATABLE", "HKLEG_RECON_RECONCILE_MATERIAL_MISMATCH",
        "HKLEG_RECON_RECONCILE_LOCATION_ACCOUNTING_INCOMPLETE", "HKLEG_RECON_RECONCILE_COMPONENT_SUSPENDED",
        "HKLEG_RECON_RECONCILE_COMPONENT_REVALIDATED"
      ]
    },
    "comparison_result": {
      "type": "object", "additionalProperties": false,
      "required": ["location_id", "comparison_class", "attribution_classes"],
      "properties": {
        "location_id": {"type": "string", "minLength": 1},
        "comparison_class": {"enum": ["EXACT_CANONICAL_MATCH", "PRESENTATION_ONLY_MATCH", "MATERIAL_MISMATCH", "COMPARISON_NOT_ISOLATABLE"]},
        "attribution_classes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/attribution_class"}}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": [
        "cutoff", "reconciliation_id", "reconstruction_artifact_ref", "coverage_gap_ref",
        "current_monitoring_state", "changed_signal", "hkel_candidate_state", "common_basis",
        "ordinary_hkel_selection", "reconstructed_location_ids", "comparison_results",
        "complete_comparison_accounting", "reconstruction_integrity_defect",
        "declared_impact_scope", "revalidation_complete"
      ],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "reconciliation_id": {"type": "string", "pattern": "^rrc_[0-9a-f]{48}$"},
        "reconstruction_artifact_ref": {"$ref": "#/$defs/reference"},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "current_monitoring_state": {"$ref": "#/$defs/monitoring_state"},
        "changed_signal": {"enum": ["UNCHANGED", "CHANGED"]},
        "hkel_candidate_state": {"enum": ["NOT_OBSERVED", "VALIDATION_RUNNING", "INVALID", "VALID"]},
        "common_basis": {"enum": ["NOT_APPLICABLE", "EXACT", "NOT_ISOLATABLE"]},
        "ordinary_hkel_selection": {"enum": ["NOT_READY", "CANDIDATE_READY", "SELECTED_APPROVED"]},
        "reconstructed_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "comparison_results": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/comparison_result"}},
        "complete_comparison_accounting": {"type": "boolean"},
        "reconstruction_integrity_defect": {"type": "boolean"},
        "declared_impact_scope": {"enum": ["NONE", "BOUNDED_COMPONENT", "RULEBOOK_AND_BUILD"]},
        "revalidation_complete": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": [
        "fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect",
        "source_contract_review_required", "reason_codes", "rule_trace", "prior_monitoring_state",
        "next_monitoring_state", "comparison_class", "accounted_location_ids",
        "mismatch_attribution_classes", "suspension_scope", "serving_consequence",
        "coverage_gap_consequence", "artifact_mutation", "record_output", "external_effects", "next_action"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-RECON-RCN-FIX-0(0[1-9]|1[0-2])$"},
        "rule_id": {"const": "HKLEG-RECON-RECONCILE-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"},
        "coverage_effect": {"const": "COVERAGE_GAP"},
        "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}},
        "rule_trace": {"const": ["HKLEG-RECON-RECONCILE-001"]},
        "prior_monitoring_state": {"$ref": "#/$defs/monitoring_state"},
        "next_monitoring_state": {"$ref": "#/$defs/monitoring_state"},
        "comparison_class": {"$ref": "#/$defs/comparison_class"},
        "accounted_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "mismatch_attribution_classes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/attribution_class"}},
        "suspension_scope": {"enum": ["NONE", "BOUNDED_COMPONENT", "RULEBOOK_AND_BUILD"]},
        "serving_consequence": {
          "enum": [
            "RETAIN_ELIGIBLE_RECONSTRUCTION", "ORDINARY_HKEL_CANDIDATE_NOT_YET_APPROVED",
            "SELECT_ORDINARY_HKEL_WHEN_APPROVED", "ORDINARY_HKEL_SELECTED",
            "SELECT_VALIDATED_FALLBACK_OR_NO_RECORD"
          ]
        },
        "coverage_gap_consequence": {"enum": ["RETAIN_ACTIVE", "RESOLVE_AFTER_COMPLETE_RECONCILIATION"]},
        "artifact_mutation": {"const": "NONE"},
        "record_output": {"const": "NONE"},
        "external_effects": {"const": "NONE"},
        "next_action": {
          "enum": [
            "CONTINUE_LIGHTWEIGHT_MONITORING", "COMPLETE_BOUNDED_HKEL_VALIDATION",
            "RETAIN_GAP_AND_CONTINUE_MONITORING", "COMPLETE_COMPARISON_LOCATION_ACCOUNTING",
            "PRESERVE_DEFERRED_COMPARISON_EVIDENCE", "SUSPEND_AND_REPROCESS_COMPLETE_IMPACT_SET",
            "BUILD_COMPLETE_ORDINARY_HKEL_RELEASE", "PRESERVE_RECONSTRUCTION_AND_SERVING_HISTORY",
            "REPROCESS_DECLARED_IMPACT_SET", "REPROCESS_COMPLETE_IMPACT_SET"
          ]
        }
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-RECON-RCN-FIX-0(0[1-9]|1[0-2])$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/reconstruction-reconciliation/HKLEG-RECON-RCN-FIX-0(0[1-9]|1[0-2])\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.reconstruction-reconciliation.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-RECON-RCN-FIX-0(0[1-9]|1[0-2])$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-RECON-RCN-FIX-0(0[1-9]|1[0-2])\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/reconstruction-reconciliation/HKLEG-RECON-RCN-FIX-0(0[1-9]|1[0-2])\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.reconstruction-reconciliation.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array", "minItems": 9, "maxItems": 9, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome"],
            "properties": {
              "code": {"$ref": "#/$defs/reason_code"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "establishes", "valid_hkel_precedence", "artifact_mutation", "record_output", "external_effects"],
      "properties": {
        "rule_id": {"const": "HKLEG-RECON-RECONCILE-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "ACTIVE_RECONSTRUCTION_LATER_HKEL_MONITORING"},
        "establishes": {"const": "APPEND_ONLY_MONITORING_COMPARISON_AND_IMPACT_CONSEQUENCE"},
        "valid_hkel_precedence": {"const": "REPLACE_WHEN_ORDINARY_RELEASE_APPROVED_REGARDLESS_OF_COMPARISON"},
        "artifact_mutation": {"const": "NONE"},
        "record_output": {"const": "NONE"},
        "external_effects": {"const": "NONE"}
      }
    }
  }
}
