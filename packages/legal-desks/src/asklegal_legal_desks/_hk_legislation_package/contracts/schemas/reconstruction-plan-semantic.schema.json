{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://contracts.asklegal.local/v1/hk-legislation-reconstruction-plan-semantic.schema.json",
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "nullable_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
    "reason_code":{"enum":[
      "HKLEG_RECON_PLAN_SEMANTIC_CANDIDATE_CONFIRMED",
      "HKLEG_RECON_PLAN_SEMANTIC_PROFILE_NOT_ADMITTED",
      "HKLEG_RECON_PLAN_SEMANTIC_DECISION_RESULT_MISSING",
      "HKLEG_RECON_PLAN_SEMANTIC_CHALLENGE_RESULT_MISSING",
      "HKLEG_RECON_PLAN_SEMANTIC_DECISION_CONTRACT_INVALID",
      "HKLEG_RECON_PLAN_SEMANTIC_CHALLENGE_CONTRACT_INVALID",
      "HKLEG_RECON_PLAN_SEMANTIC_EVIDENCE_BINDING_INCOMPLETE",
      "HKLEG_RECON_PLAN_SEMANTIC_UNSUPPORTED_OPERATION",
      "HKLEG_RECON_PLAN_SEMANTIC_FINAL_TEXT_OVERREACH",
      "HKLEG_RECON_PLAN_SEMANTIC_CHALLENGE_OBJECTION",
      "HKLEG_RECON_PLAN_SEMANTIC_CHALLENGE_UNRESOLVED",
      "HKLEG_RECON_PLAN_SEMANTIC_RESULT_CONFLICT",
      "HKLEG_RECON_PLAN_SEMANTIC_DETERMINISTIC_PRECHECK_FAILED"
    ]},
    "reason_code_catalogue":{"type":"object","additionalProperties":false,"required":["catalogue_id","version","status","reason_codes"],"properties":{
      "catalogue_id":{"const":"asklegal.hk-legislation.reconstruction-plan-semantic.reason-codes"},"version":{"const":"1.0.0"},"status":{"const":"FROZEN_PARTIAL"},
      "reason_codes":{"type":"array","minItems":13,"maxItems":13,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["code","meaning","processing_outcome"],"properties":{"code":{"$ref":"#/$defs/reason_code"},"meaning":{"type":"string","minLength":1},"processing_outcome":{"enum":["PASS","BLOCK","QUARANTINE"]}}}}
    }},
    "rule":{"type":"object","additionalProperties":false,"required":["rule_id","version","stage","input_authority","candidate_output","executable_plan_output","text_output","provider_rule"],"properties":{
      "rule_id":{"const":"HKLEG-RECON-PLAN-SEMANTIC-001"},"version":{"const":"1.0.0"},"stage":{"const":"RECONSTRUCTION_PLAN_SEMANTIC_DECISION_AND_CHALLENGE"},
      "input_authority":{"const":"EXACT_EVIDENCE_BOUND_ADMITTED_DECISION_AND_CHALLENGE_RESULTS"},
      "candidate_output":{"const":"UNTRUSTED_STRUCTURED_CANDIDATE_ONLY"},"executable_plan_output":{"const":"NONE"},"text_output":{"const":"NONE"},
      "provider_rule":{"const":"NO_PROVIDER_CALL_OR_PROFILE_ADMISSION_IN_THIS_RULE"}
    }},
    "input":{"type":"object","additionalProperties":false,"required":[
      "decision_task","challenge_task","evidence_bundle_fingerprint","operation_registry_fingerprint","plan_contract_fingerprint",
      "decision_profile_fingerprint","challenge_profile_fingerprint","decision_result_fingerprint","challenge_result_fingerprint","candidate_mapping_fingerprint",
      "task_profiles_admitted","decision_result_contract_valid","challenge_result_contract_valid","decision_evidence_bindings_complete","challenge_evidence_bindings_complete",
      "candidate_operations_closed_registry_only","candidate_source_spans_complete","candidate_contains_final_text","challenge_outcome","semantic_result_conflicts",
      "event_chain_mapping_complete","applicability_mapping_complete","dependency_mapping_complete","bilingual_stream_mapping_complete","deterministic_prechecks_passed"
    ],"properties":{
      "decision_task":{"const":"RECONSTRUCTION_PLAN_DECISION"},"challenge_task":{"const":"RECONSTRUCTION_PLAN_CHALLENGE"},
      "evidence_bundle_fingerprint":{"$ref":"#/$defs/sha256"},"operation_registry_fingerprint":{"$ref":"#/$defs/sha256"},"plan_contract_fingerprint":{"$ref":"#/$defs/sha256"},
      "decision_profile_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"challenge_profile_fingerprint":{"$ref":"#/$defs/nullable_sha256"},
      "decision_result_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"challenge_result_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"candidate_mapping_fingerprint":{"$ref":"#/$defs/nullable_sha256"},
      "task_profiles_admitted":{"type":"boolean"},"decision_result_contract_valid":{"type":"boolean"},"challenge_result_contract_valid":{"type":"boolean"},
      "decision_evidence_bindings_complete":{"type":"boolean"},"challenge_evidence_bindings_complete":{"type":"boolean"},
      "candidate_operations_closed_registry_only":{"type":"boolean"},"candidate_source_spans_complete":{"type":"boolean"},"candidate_contains_final_text":{"type":"boolean"},
      "challenge_outcome":{"enum":["CONFIRMED","OBJECTION","UNRESOLVED"]},"semantic_result_conflicts":{"type":"boolean"},
      "event_chain_mapping_complete":{"type":"boolean"},"applicability_mapping_complete":{"type":"boolean"},"dependency_mapping_complete":{"type":"boolean"},
      "bilingual_stream_mapping_complete":{"type":"boolean"},"deterministic_prechecks_passed":{"type":"boolean"}
    }},
    "fixture":{"type":"object","additionalProperties":false,"required":["fixture_id","title","synthetic","status","input_fingerprint","input","expected_artifact"],"properties":{
      "fixture_id":{"type":"string","pattern":"^HKLEG-RECON-PLAN-SEM-FIX-(00[1-9]|01[0-3])$"},"title":{"type":"string","minLength":1},"synthetic":{"const":true},"status":{"const":"FROZEN_PARTIAL"},
      "input_fingerprint":{"$ref":"#/$defs/sha256"},"input":{"$ref":"#/$defs/input"},
      "expected_artifact":{"type":"object","additionalProperties":false,"required":["path","fingerprint"],"properties":{"path":{"type":"string","pattern":"^expected/reconstruction-plan-semantic/HKLEG-RECON-PLAN-SEM-FIX-(00[1-9]|01[0-3])\\.json$"},"fingerprint":{"$ref":"#/$defs/sha256"}}}
    }},
    "fixture_catalogue":{"type":"object","additionalProperties":false,"required":["catalogue_id","version","status","accepted_complete_universe","fixtures"],"properties":{
      "catalogue_id":{"const":"asklegal.hk-legislation.reconstruction-plan-semantic.fixtures"},"version":{"const":"1.0.0"},"status":{"const":"FROZEN_PARTIAL"},"accepted_complete_universe":{"const":false},
      "fixtures":{"type":"array","minItems":13,"maxItems":13,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["fixture_id","path","fixture_fingerprint","expected_path","expected_fingerprint"],"properties":{
        "fixture_id":{"type":"string","pattern":"^HKLEG-RECON-PLAN-SEM-FIX-(00[1-9]|01[0-3])$"},"path":{"type":"string","pattern":"^fixtures/deterministic/HKLEG-RECON-PLAN-SEM-FIX-(00[1-9]|01[0-3])\\.json$"},
        "fixture_fingerprint":{"$ref":"#/$defs/sha256"},"expected_path":{"type":"string","pattern":"^expected/reconstruction-plan-semantic/HKLEG-RECON-PLAN-SEM-FIX-(00[1-9]|01[0-3])\\.json$"},"expected_fingerprint":{"$ref":"#/$defs/sha256"}
      }}}
    }},
    "decision":{"type":"object","additionalProperties":false,"required":[
      "fixture_id","rule_id","processing_outcome","legal_disposition","coverage_effect","source_contract_review_required","reason_codes","rule_trace",
      "decision_task","challenge_task","candidate_output","challenge_outcome","evidence_bundle_fingerprint","operation_registry_fingerprint","plan_contract_fingerprint",
      "decision_profile_fingerprint","challenge_profile_fingerprint","decision_result_fingerprint","challenge_result_fingerprint","candidate_mapping_fingerprint",
      "deterministic_precheck_result","executable_plan_output","reconstructed_text_output","operation_execution","record_output","external_effects","next_action"
    ],"properties":{
      "fixture_id":{"type":"string","pattern":"^HKLEG-RECON-PLAN-SEM-FIX-(00[1-9]|01[0-3])$"},"rule_id":{"const":"HKLEG-RECON-PLAN-SEMANTIC-001"},
      "processing_outcome":{"enum":["PASS","BLOCK","QUARANTINE"]},"legal_disposition":{"enum":["NOT_APPLICABLE","QUARANTINE"]},"coverage_effect":{"const":"COVERAGE_GAP"},"source_contract_review_required":{"const":false},
      "reason_codes":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"#/$defs/reason_code"}},"rule_trace":{"const":["HKLEG-RECON-PLAN-SEMANTIC-001"]},
      "decision_task":{"const":"RECONSTRUCTION_PLAN_DECISION"},"challenge_task":{"const":"RECONSTRUCTION_PLAN_CHALLENGE"},"candidate_output":{"enum":["NONE","UNTRUSTED_STRUCTURED_PLAN_CANDIDATE"]},"challenge_outcome":{"enum":["CONFIRMED","OBJECTION","UNRESOLVED"]},
      "evidence_bundle_fingerprint":{"$ref":"#/$defs/sha256"},"operation_registry_fingerprint":{"$ref":"#/$defs/sha256"},"plan_contract_fingerprint":{"$ref":"#/$defs/sha256"},
      "decision_profile_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"challenge_profile_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"decision_result_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"challenge_result_fingerprint":{"$ref":"#/$defs/nullable_sha256"},"candidate_mapping_fingerprint":{"$ref":"#/$defs/nullable_sha256"},
      "deterministic_precheck_result":{"enum":["PASS","FAIL","NOT_PERFORMED"]},"executable_plan_output":{"const":"NONE"},"reconstructed_text_output":{"const":"NONE"},"operation_execution":{"const":"NONE"},"record_output":{"const":"NONE"},"external_effects":{"const":"NONE"},
      "next_action":{"enum":["RUN_DETERMINISTIC_RECONSTRUCTION_PLAN_VALIDATION","ADMIT_RECONSTRUCTION_PLAN_TASK_PROFILES","OBTAIN_RECONSTRUCTION_PLAN_DECISION_RESULT","OBTAIN_RECONSTRUCTION_PLAN_CHALLENGE_RESULT","REJECT_INVALID_RECONSTRUCTION_PLAN_DECISION","REJECT_INVALID_RECONSTRUCTION_PLAN_CHALLENGE","COMPLETE_RECONSTRUCTION_PLAN_EVIDENCE_BINDINGS","USE_FALLBACK_FOR_UNSUPPORTED_RECONSTRUCTION_OPERATION","QUARANTINE_MODEL_FINAL_TEXT_OVERREACH","REVISE_RECONSTRUCTION_CANDIDATE_OR_USE_FALLBACK","ROUTE_EXCEPTIONAL_RECONSTRUCTION_PLAN_TO_LEGAL_DESK","QUARANTINE_RECONSTRUCTION_PLAN_SEMANTIC_RESULTS","USE_FALLBACK_AFTER_RECONSTRUCTION_PRECHECK_FAILURE"]}
    }}
  }
}
