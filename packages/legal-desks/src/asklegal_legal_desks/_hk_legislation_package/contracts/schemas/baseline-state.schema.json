{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-state.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {
      "enum": [
        "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95",
        "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e",
        "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"
      ]
    },
    "source_id": {
      "enum": [
        "HK-LEG-HKEL-CURRENT-INVENTORY",
        "HK-LEG-HKEL-CURRENT-DATA",
        "HK-LEG-GLD-EGAZETTE",
        "HK-LEG-HKEL-EDITORIAL-RECORDS",
        "HK-LEG-HKEL-PUBLICATION-SPECIFICATIONS",
        "HK-LEG-BASIC-LAW-PORTAL",
        "HK-LEG-NPC-NATIONAL-LAWS-DATABASE",
        "HK-LEG-NPC-NPCSC-OFFICIAL-MATERIALS"
      ]
    },
    "reason_code": {
      "enum": [
        "HKLEG_BASE_STATE_PRESENT_OPERATIVE_ESTABLISHED",
        "HKLEG_BASE_STATE_REQUIRED_SIGNAL_MISSING",
        "HKLEG_BASE_STATE_STATUS_OR_STRUCTURE_AMBIGUOUS",
        "HKLEG_BASE_STATE_ACCEPTED_SIGNAL_CONFLICT",
        "HKLEG_BASE_STATE_SOURCE_SEMANTICS_UNKNOWN",
        "HKLEG_BASE_STATE_OPERATIVE_EFFECT_NOT_PROVED",
        "HKLEG_BASE_STATE_RULEBOOK_SUPPORT_MISSING"
      ]
    },
    "unresolved_fact_code": {
      "enum": [
        "ACCEPTED_SIGNAL_SET",
        "ACCEPTED_SIGNAL_CONFLICT",
        "ITEM_STATUS",
        "PROVISION_STATUS",
        "STRUCTURE_STATUS",
        "STATUS_LOCATION_MAPPING",
        "COMMENCEMENT_SUPPORT",
        "OFFICIAL_VERSION",
        "SOURCE_SEMANTICS",
        "RULEBOOK_OWNERSHIP",
        "RULEBOOK_DISPOSITION"
      ]
    },
    "source_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "source_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-state.source-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "source_codes": {
          "type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "permitted_state_use"],
            "properties": {
              "code": {"$ref": "#/$defs/source_id"},
              "permitted_state_use": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-state.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome", "coverage_effect", "source_contract_review_required"],
            "properties": {
              "code": {"$ref": "#/$defs/reason_code"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
              "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]},
              "source_contract_review_required": {"type": "boolean"}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "predecessor_rule_ids", "accepted_signal_source_ids", "branch_precedence", "successor_rule_id", "forbidden_shortcuts"],
      "properties": {
        "rule_id": {"const": "HKLEG-BASE-STATE-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "FIRST_BASELINE_PRESENT_OPERATIVE_STATE"},
        "predecessor_rule_ids": {"const": ["HKLEG-BASE-INV-001", "HKLEG-BASE-EVID-001"]},
        "accepted_signal_source_ids": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "branch_precedence": {"const": ["SOURCE_SEMANTICS_UNKNOWN", "REQUIRED_SIGNAL_MISSING", "ACCEPTED_SIGNAL_CONFLICT", "STATUS_OR_STRUCTURE_AMBIGUOUS", "OPERATIVE_EFFECT_NOT_PROVED", "RULEBOOK_SUPPORT_MISSING", "PRESENT_OPERATIVE_STATE_ESTABLISHED"]},
        "successor_rule_id": {"const": "HKLEG-BASE-LIMIT-001"},
        "forbidden_shortcuts": {"const": ["IN_EFFECT_SIGNAL_ALONE", "LIST_ENTRY_ALONE", "VERSION_DATE_ALONE", "STATUS_CODE_ALONE", "CURRENT_COPY_LABEL_ALONE", "SILENT_CONFLICT_PREFERENCE", "HISTORICAL_EVENT_INFERENCE"]}
      }
    },
    "predecessor_results": {
      "const": [
        {"rule_id": "HKLEG-BASE-INV-001", "processing_outcome": "PASS"},
        {"rule_id": "HKLEG-BASE-EVID-001", "processing_outcome": "PASS"}
      ]
    },
    "state_facts": {
      "type": "object", "additionalProperties": false,
      "required": ["accepted_signal_set_complete", "semantics_status", "item_status", "provision_status", "structure_status", "status_mapping", "commencement_support", "status_version_id"],
      "properties": {
        "accepted_signal_set_complete": {"type": "boolean"},
        "semantics_status": {"enum": ["KNOWN", "UNKNOWN"]},
        "item_status": {"enum": ["CURRENT", "PARTIAL", "AMBIGUOUS", "MISSING"]},
        "provision_status": {"enum": ["OPERATIVE", "OPERATIVE_SIGNAL_ONLY", "PARTIAL", "AMBIGUOUS", "MISSING"]},
        "structure_status": {"enum": ["COMPLETE", "PARTIAL", "AMBIGUOUS", "MISSING"]},
        "status_mapping": {"enum": ["COMPLETE", "PARTIAL", "AMBIGUOUS", "MISSING"]},
        "commencement_support": {"enum": ["PROVED", "UNPROVED", "CONFLICTING"]},
        "status_version_id": {"type": "string", "pattern": "^SYN-HKLEG-VER-[0-9]{3}$"}
      }
    },
    "rulebook_support": {
      "type": "object", "additionalProperties": false,
      "required": ["ownership_supported", "operative_disposition_supported"],
      "properties": {
        "ownership_supported": {"type": "boolean"},
        "operative_disposition_supported": {"type": "boolean"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["cutoff", "legal_object_id", "legal_location_id", "scope_id", "official_version_id", "predecessor_results", "state_facts", "unresolved_source_ids", "conflicting_source_ids", "rulebook_support"],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "legal_object_id": {"const": "SYN-HKLEG-OBJ-001"},
        "legal_location_id": {"const": "SYN-HKLEG-LOC-001"},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "official_version_id": {"const": "SYN-HKLEG-VER-001"},
        "predecessor_results": {"$ref": "#/$defs/predecessor_results"},
        "state_facts": {"$ref": "#/$defs/state_facts"},
        "unresolved_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "conflicting_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "rulebook_support": {"$ref": "#/$defs/rulebook_support"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-STATE-FIX-00[1-7]$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "rule_id": {"const": "HKLEG-BASE-STATE-001"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/baseline-state/HKLEG-BASE-STATE-FIX-00[1-7]\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-state.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-STATE-FIX-00[1-7]$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-STATE-FIX-00[1-7]\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/baseline-state/HKLEG-BASE-STATE-FIX-00[1-7]\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "present_state", "historical_assertion_scope", "conflicting_source_ids", "unresolved_source_ids", "unresolved_fact_codes", "affected_scope_ids", "record_output", "next_action"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-STATE-FIX-00[1-7]$"},
        "rule_id": {"const": "HKLEG-BASE-STATE-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"},
        "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]},
        "source_contract_review_required": {"type": "boolean"},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}},
        "rule_trace": {"const": ["HKLEG-BASE-STATE-001"]},
        "present_state": {"enum": ["OPERATIVE_CURRENT", "UNRESOLVED"]},
        "historical_assertion_scope": {"enum": ["PENDING_LIMIT_RULE", "NONE"]},
        "conflicting_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "unresolved_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "unresolved_fact_codes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/unresolved_fact_code"}},
        "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}},
        "record_output": {"const": "NONE"},
        "next_action": {"enum": ["RUN_HKLEG_BASE_LIMIT_001", "COMPLETE_REQUIRED_STATE_SIGNALS", "OPEN_TARGETED_STATE_REVIEW", "QUARANTINE_PRESENT_STATE_CONFLICT", "OPEN_SOURCE_CONTRACT_REVIEW", "OPEN_TARGETED_COMMENCEMENT_REVIEW", "COMPLETE_RULEBOOK_STATE_SUPPORT"]}
      }
    }
  }
}
