{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-current-disposition.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {"const": "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95"},
    "basis": {"enum": ["PRESENT_OPERATIVE_SUPPORTED", "VALIDLY_MADE_NOT_PROVED_OPERATIVE", "PRESENT_EFFECT_REPRESENTED_ELSEWHERE", "ENDED_OR_SUPERSEDED_PROVED", "UNRESOLVED_MATERIAL_FACT", "UNSUPPORTED_SIGNAL_ONLY"]},
    "reason_code": {"enum": ["HKLEG_CURRENT_DISP_SEARCHABLE_CURRENT_SUPPORTED", "HKLEG_CURRENT_DISP_WAITING_ROOM_SUPPORTED", "HKLEG_CURRENT_DISP_EVIDENCE_ONLY_SUPPORTED", "HKLEG_CURRENT_DISP_HISTORICAL_SUPPORTED", "HKLEG_CURRENT_DISP_QUARANTINE_REQUIRED", "HKLEG_CURRENT_DISP_UPSTREAM_BLOCKED", "HKLEG_CURRENT_DISP_SINGLE_SIGNAL_INSUFFICIENT"]},
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-disposition.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}}}}
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false, "required": ["rule_id", "version", "stage", "ordinary_path_only", "predecessor_rule_ids", "successor_rule_id", "primary_dispositions", "record_output"],
      "properties": {
        "rule_id": {"const": "HKLEG-CURRENT-DISP-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "ORDINARY_CURRENT_PRIMARY_DISPOSITION"},
        "ordinary_path_only": {"const": true},
        "predecessor_rule_ids": {"const": ["HKLEG-CURRENT-DIFF-001", "HKLEG-CURRENT-CAUSE-001", "HKLEG-CURRENT-CAUSE-002"]},
        "successor_rule_id": {"const": "HKLEG-CURRENT-REC-001"},
        "primary_dispositions": {"const": ["SEARCHABLE_CURRENT", "WAITING_ROOM", "EVIDENCE_ONLY", "HISTORICAL", "QUARANTINE"]},
        "record_output": {"const": "NONE"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["cutoff", "scope_id", "object_id", "location_id", "upstream_checkpoint", "status_coverage_complete", "disposition_basis"],
      "properties": {
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "object_id": {"type": "string", "minLength": 1},
        "location_id": {"type": "string", "minLength": 1},
        "upstream_checkpoint": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "status_coverage_complete": {"type": "boolean"},
        "disposition_basis": {"$ref": "#/$defs/basis"}
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-DISP-FIX-00[1-7]$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/current-disposition/HKLEG-CURRENT-DISP-FIX-00[1-7]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.current-disposition.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-DISP-FIX-00[1-7]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-CURRENT-DISP-FIX-00[1-7]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/current-disposition/HKLEG-CURRENT-DISP-FIX-00[1-7]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "affected_object_ids", "affected_scope_ids", "affected_location_ids", "record_output", "next_action"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-CURRENT-DISP-FIX-00[1-7]$"},
        "rule_id": {"const": "HKLEG-CURRENT-DISP-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"enum": ["SEARCHABLE_CURRENT", "WAITING_ROOM", "EVIDENCE_ONLY", "HISTORICAL", "QUARANTINE", "NOT_APPLICABLE"]},
        "coverage_effect": {"const": "NONE"},
        "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}},
        "rule_trace": {"const": ["HKLEG-CURRENT-DISP-001"]},
        "affected_object_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}},
        "affected_location_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "string", "minLength": 1}},
        "record_output": {"const": "NONE"},
        "next_action": {"enum": ["RUN_HKLEG_CURRENT_REC_001", "PRESERVE_NON_SEARCHABLE_ACCOUNTING", "PRESERVE_QUARANTINE", "RESOLVE_UPSTREAM_CHECKPOINT", "COMPLETE_LEGAL_TESTS"]}
      }
    }
  }
}
