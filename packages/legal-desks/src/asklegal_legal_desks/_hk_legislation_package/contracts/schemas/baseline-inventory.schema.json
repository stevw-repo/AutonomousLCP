{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-baseline-inventory.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "scope_id": {
      "enum": [
        "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95",
        "rsc_1cdf5a558e8286dadf84f819de1d48168d455cd457fcf30e",
        "rsc_4708261daa351aa91a1511674b94bced0a9c2eaa817770ea"
      ]
    },
    "source_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "source_codes", "legal_nature_scope_bindings"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-inventory.source-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "source_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "fact_authority", "allowed_rule_ids"],
            "properties": {
              "code": {"const": "HK-LEG-HKEL-CURRENT-INVENTORY"},
              "fact_authority": {"const": "CURRENT_HKEL_INVENTORY_METADATA_ONLY"},
              "allowed_rule_ids": {
                "const": ["HKLEG-BASE-INV-001"]
              }
            }
          }
        },
        "legal_nature_scope_bindings": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legal_nature", "scope_id"],
            "properties": {
              "legal_nature": {
                "enum": ["ORDINANCE", "SUBSIDIARY_LEGISLATION", "CONSTITUTIONAL_OR_OTHER_INSTRUMENT"]
              },
              "scope_id": {"$ref": "#/$defs/scope_id"}
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-inventory.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome", "coverage_effect"],
            "properties": {
              "code": {
                "enum": [
                  "HKLEG_BASE_INVENTORY_ACCOUNTED",
                  "HKLEG_BASE_INVENTORY_OBJECT_OR_RESOURCE_UNACCOUNTED",
                  "HKLEG_BASE_INVENTORY_OWNERSHIP_AMBIGUOUS",
                  "HKLEG_BASE_INVENTORY_SCOPE_MISASSIGNED"
                ]
              },
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
              "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id", "version", "stage", "source_id", "applicable_scope_ids",
        "branch_precedence", "result_dimensions", "forbidden_shortcuts"
      ],
      "properties": {
        "rule_id": {"const": "HKLEG-BASE-INV-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "FIRST_BASELINE_INVENTORY_ACCOUNTING"},
        "source_id": {"const": "HK-LEG-HKEL-CURRENT-INVENTORY"},
        "applicable_scope_ids": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scope_id"}
        },
        "branch_precedence": {
          "const": [
            "OWNERSHIP_AMBIGUOUS",
            "OBJECT_OR_RESOURCE_UNACCOUNTED",
            "SCOPE_MISASSIGNED",
            "ACCOUNTED"
          ]
        },
        "result_dimensions": {
          "const": [
            "processing_outcome", "legal_disposition", "coverage_effect",
            "source_contract_review_required", "reason_codes", "rule_trace",
            "record_output"
          ]
        },
        "forbidden_shortcuts": {
          "const": [
            "FILE_LOCATION_AS_LEGAL_NATURE",
            "A_NUMBER_AS_LEGAL_NATURE",
            "UNACCOUNTED_OBJECT_IGNORED",
            "DUPLICATE_OWNERSHIP_COLLAPSED",
            "PASS_AS_SEARCHABILITY"
          ]
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "language", "version_signal", "status_signal", "locator", "declared_sha256"],
      "properties": {
        "resource_id": {"type": "string", "pattern": "^SYN-HKLEG-RES-[0-9]{3}-[A-Z]+$"},
        "language": {"enum": ["en", "zh-Hant", "bilingual", "not-applicable"]},
        "version_signal": {"type": "string", "minLength": 1},
        "status_signal": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "pattern": "^SYNTHETIC_LOCATOR_[A-Z0-9_]+$"},
        "declared_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_observation", "observed_legal_objects", "accounting_claims"],
      "properties": {
        "source_observation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_id", "cutoff", "complete"],
          "properties": {
            "source_id": {"const": "HK-LEG-HKEL-CURRENT-INVENTORY"},
            "cutoff": {"const": "2026-08-17T00:00:00Z"},
            "complete": {"const": true}
          }
        },
        "observed_legal_objects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["inventory_item_id", "legal_object_id", "legal_nature", "resources"],
            "properties": {
              "inventory_item_id": {"type": "string", "pattern": "^SYN-HKLEG-ITEM-[0-9]{3}$"},
              "legal_object_id": {"type": "string", "pattern": "^SYN-HKLEG-OBJ-[0-9]{3}$"},
              "legal_nature": {
                "enum": ["ORDINANCE", "SUBSIDIARY_LEGISLATION", "CONSTITUTIONAL_OR_OTHER_INSTRUMENT"]
              },
              "resources": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "#/$defs/resource"}
              }
            }
          }
        },
        "accounting_claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["legal_object_id", "scope_id", "resource_ids"],
            "properties": {
              "legal_object_id": {"type": "string", "pattern": "^SYN-HKLEG-OBJ-[0-9]{3}$"},
              "scope_id": {"$ref": "#/$defs/scope_id"},
              "resource_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "pattern": "^SYN-HKLEG-RES-[0-9]{3}-[A-Z]+$"}
              }
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-INV-FIX-00[1-4]$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "rule_id": {"const": "HKLEG-BASE-INV-001"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/baseline-inventory/HKLEG-BASE-INV-FIX-00[1-4]\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.baseline-inventory.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-INV-FIX-00[1-4]$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-INV-FIX-00[1-4]\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/baseline-inventory/HKLEG-BASE-INV-FIX-00[1-4]\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id", "rule_id", "processing_outcome", "legal_disposition",
        "coverage_effect", "source_contract_review_required", "reason_codes",
        "rule_trace", "accounted_object_ids", "unresolved_object_ids",
        "affected_scope_ids", "scope_inventory_results", "record_output"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-INV-FIX-00[1-4]$"},
        "rule_id": {"const": "HKLEG-BASE-INV-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"},
        "coverage_effect": {"enum": ["NONE", "COVERAGE_GAP"]},
        "source_contract_review_required": {"const": false},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "rule_trace": {"const": ["HKLEG-BASE-INV-001"]},
        "accounted_object_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "unresolved_object_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "affected_scope_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope_id"}},
        "scope_inventory_results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope_id", "result"],
            "properties": {
              "scope_id": {"$ref": "#/$defs/scope_id"},
              "result": {"enum": ["COMPLETE", "INCOMPLETE"]}
            }
          }
        },
        "record_output": {"const": "NONE"}
      }
    }
  }
}
