{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.asklegal.local/v1/hk-legislation-known-stale-fallback.schema.json",
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "scope_id": {"const": "rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95"},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref_type", "ref_id", "fingerprint"],
      "properties": {
        "ref_type": {"type": "string", "minLength": 1},
        "ref_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "reason_code": {
      "enum": [
        "HKLEG_KNOWN_STALE_VERIFIED_TEXT_SELECTED",
        "HKLEG_KNOWN_STALE_NEWER_ASSISTED_TEXT_SELECTED",
        "HKLEG_KNOWN_STALE_NO_VALID_APPLICABLE_TEXT",
        "HKLEG_KNOWN_STALE_CURRENT_CONSOLIDATION_AVAILABLE",
        "HKLEG_KNOWN_STALE_RECONSTRUCTION_ELIGIBLE",
        "HKLEG_KNOWN_STALE_EVENT_EVIDENCE_INCOMPLETE",
        "HKLEG_KNOWN_STALE_EVENT_EVIDENCE_CONFLICT",
        "HKLEG_KNOWN_STALE_AFFECTED_SET_UNBOUNDED",
        "HKLEG_KNOWN_STALE_IDENTITY_MAPPING_UNPROVED",
        "HKLEG_KNOWN_STALE_RELEASE_ACCOUNTING_INCOMPLETE",
        "HKLEG_KNOWN_STALE_LATEST_APPLICABLE_TEXT_INVALID",
        "HKLEG_KNOWN_STALE_LATEST_VERSION_CONFLICT"
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_version_ref", "version_date", "evidence_class", "applicable",
        "accepted", "independently_verifiable", "integrity_valid", "bilingual_complete",
        "xml_copy_reconciled", "source_text_unchanged", "source_text_fingerprints"
      ],
      "properties": {
        "official_version_ref": {"$ref": "#/$defs/reference"},
        "version_date": {"type": "string", "format": "date"},
        "evidence_class": {"enum": ["VERIFIED", "ASSISTED"]},
        "applicable": {"type": "boolean"},
        "accepted": {"type": "boolean"},
        "independently_verifiable": {"type": "boolean"},
        "integrity_valid": {"type": "boolean"},
        "bilingual_complete": {"type": "boolean"},
        "xml_copy_reconciled": {"type": "boolean"},
        "source_text_unchanged": {"type": "boolean"},
        "source_text_fingerprints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "zh-Hant"],
          "properties": {"en": {"$ref": "#/$defs/sha256"}, "zh-Hant": {"$ref": "#/$defs/sha256"}}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selection_id", "cutoff", "scope_id", "object_id", "coverage_gap_ref",
        "event_evidence_complete", "event_evidence_authentic", "event_evidence_conflicts",
        "event_operative_at_cutoff", "matching_current_consolidation_available",
        "reconstruction_disposition", "affected_location_ids", "affected_location_scope",
        "identity_mapping_proved", "release_accounting_complete", "candidate_versions"
      ],
      "properties": {
        "selection_id": {"type": "string", "pattern": "^ksf_[0-9a-f]{48}$"},
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "object_id": {"type": "string", "minLength": 1},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "event_evidence_complete": {"type": "boolean"},
        "event_evidence_authentic": {"type": "boolean"},
        "event_evidence_conflicts": {"type": "boolean"},
        "event_operative_at_cutoff": {"type": "boolean"},
        "matching_current_consolidation_available": {"type": "boolean"},
        "reconstruction_disposition": {"enum": ["INELIGIBLE_OR_FAILED", "SUSPENDED", "ELIGIBLE"]},
        "affected_location_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "affected_location_scope": {"enum": ["EXACT", "BOUNDED_PARENT", "UNBOUNDED"]},
        "identity_mapping_proved": {"type": "boolean"},
        "release_accounting_complete": {"type": "boolean"},
        "candidate_versions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/candidate"}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id", "schema_version", "selection_id", "serving_mode", "object_id",
        "scope_id", "cutoff", "coverage_gap_ref", "selected_official_version_ref",
        "base_version_date", "base_evidence_class", "source_text_fingerprints",
        "affected_location_ids", "warning_scope", "authority_note_template_id",
        "source_text_action", "reconstruction_disposition", "fingerprint"
      ],
      "properties": {
        "schema_id": {"const": "asklegal.hk-legislation-known-stale-fallback-selection"},
        "schema_version": {"const": "1.0.0"},
        "selection_id": {"type": "string", "pattern": "^ksf_[0-9a-f]{48}$"},
        "serving_mode": {"const": "KNOWN_STALE_ANALYTICAL_CARRY_FORWARD"},
        "object_id": {"type": "string", "minLength": 1},
        "scope_id": {"$ref": "#/$defs/scope_id"},
        "cutoff": {"const": "2026-08-17T00:00:00Z"},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "selected_official_version_ref": {"$ref": "#/$defs/reference"},
        "base_version_date": {"type": "string", "format": "date"},
        "base_evidence_class": {"enum": ["VERIFIED", "ASSISTED"]},
        "source_text_fingerprints": {
          "type": "object", "additionalProperties": false, "required": ["en", "zh-Hant"],
          "properties": {"en": {"$ref": "#/$defs/sha256"}, "zh-Hant": {"$ref": "#/$defs/sha256"}}
        },
        "affected_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "warning_scope": {"enum": ["EXACT", "BOUNDED_PARENT"]},
        "authority_note_template_id": {"const": "HKLEG-KNOWN-STALE-WARNING-1.0.0"},
        "source_text_action": {"const": "REUSE_BYTE_EXACT_SOURCE_TEXT"},
        "reconstruction_disposition": {"enum": ["INELIGIBLE_OR_FAILED", "SUSPENDED"]},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect",
        "source_contract_review_required", "reason_codes", "rule_trace", "selection_result",
        "coverage_gap_ref", "affected_scope_ids", "affected_location_ids", "warning_scope",
        "fallback_selection", "official_version_output", "record_output", "external_effects", "next_action"
      ],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-KNOWN-STALE-FIX-0(0[1-9]|1[0-2])$"},
        "rule_id": {"const": "HKLEG-KNOWN-STALE-FALLBACK-001"},
        "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]},
        "legal_disposition": {"const": "NOT_APPLICABLE"},
        "coverage_effect": {"const": "COVERAGE_GAP"},
        "source_contract_review_required": {"const": false},
        "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}},
        "rule_trace": {"const": ["HKLEG-KNOWN-STALE-FALLBACK-001"]},
        "selection_result": {"enum": ["KNOWN_STALE_ANALYTICAL_CARRY_FORWARD", "NO_RECORD"]},
        "coverage_gap_ref": {"$ref": "#/$defs/reference"},
        "affected_scope_ids": {"const": ["rsc_fa928755a873dbf8df5f4f2d333b672cd1d935af9bf99b95"]},
        "affected_location_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "warning_scope": {"enum": ["EXACT", "BOUNDED_PARENT", "NONE"]},
        "fallback_selection": {"oneOf": [{"$ref": "#/$defs/selection"}, {"type": "null"}]},
        "official_version_output": {"const": "NONE"},
        "record_output": {"const": "NONE"},
        "external_effects": {"const": "NONE"},
        "next_action": {
          "enum": [
            "BUILD_WARNED_ANALYTICAL_RECORD_CANDIDATE", "ACCOUNT_NO_RECORD_COVERAGE_GAP",
            "USE_ORDINARY_CURRENT_HKEL_PATH", "SELECT_RECONSTRUCTED_CONSOLIDATION",
            "COMPLETE_OPERATIVE_EVENT_EVIDENCE", "QUARANTINE_EVENT_EVIDENCE",
            "PROVE_SMALLEST_COMPLETE_PARENT_SET", "RESOLVE_IDENTITY_AND_PREDECESSOR_MAPPING",
            "COMPLETE_AFFECTED_AND_UNAFFECTED_ACCOUNTING", "QUARANTINE_PRIOR_HKEL_TEXT"
          ]
        }
      }
    },
    "fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["fixture_id", "title", "synthetic", "status", "input_fingerprint", "input", "expected_artifact"],
      "properties": {
        "fixture_id": {"type": "string", "pattern": "^HKLEG-KNOWN-STALE-FIX-0(0[1-9]|1[0-2])$"},
        "title": {"type": "string", "minLength": 1},
        "synthetic": {"const": true},
        "status": {"const": "FROZEN_PARTIAL"},
        "input_fingerprint": {"$ref": "#/$defs/sha256"},
        "input": {"$ref": "#/$defs/input"},
        "expected_artifact": {
          "type": "object", "additionalProperties": false, "required": ["path", "fingerprint"],
          "properties": {
            "path": {"type": "string", "pattern": "^expected/known-stale-fallback/HKLEG-KNOWN-STALE-FIX-0(0[1-9]|1[0-2])\\.json$"},
            "fingerprint": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "fixture_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.known-stale-fallback.fixtures"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "accepted_complete_universe": {"const": false},
        "fixtures": {
          "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"],
            "properties": {
              "fixture_id": {"type": "string", "pattern": "^HKLEG-KNOWN-STALE-FIX-0(0[1-9]|1[0-2])$"},
              "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-KNOWN-STALE-FIX-0(0[1-9]|1[0-2])\\.json$"},
              "fixture_fingerprint": {"$ref": "#/$defs/sha256"},
              "expected_path": {"type": "string", "pattern": "^expected/known-stale-fallback/HKLEG-KNOWN-STALE-FIX-0(0[1-9]|1[0-2])\\.json$"},
              "expected_fingerprint": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      }
    },
    "reason_code_catalogue": {
      "type": "object", "additionalProperties": false,
      "required": ["catalogue_id", "version", "status", "reason_codes"],
      "properties": {
        "catalogue_id": {"const": "asklegal.hk-legislation.known-stale-fallback.reason-codes"},
        "version": {"const": "1.0.0"},
        "status": {"const": "FROZEN_PARTIAL"},
        "reason_codes": {
          "type": "array", "minItems": 12, "maxItems": 12, "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["code", "meaning", "processing_outcome"],
            "properties": {
              "code": {"$ref": "#/$defs/reason_code"},
              "meaning": {"type": "string", "minLength": 1},
              "processing_outcome": {"enum": ["PASS", "BLOCK", "QUARANTINE"]}
            }
          }
        }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "version", "stage", "establishes", "serving_mode", "selection_order", "record_output", "external_effects"],
      "properties": {
        "rule_id": {"const": "HKLEG-KNOWN-STALE-FALLBACK-001"},
        "version": {"const": "1.0.0"},
        "stage": {"const": "RECONSTRUCTION_INELIGIBLE_OR_SUSPENDED_WITH_ACTIVE_COVERAGE_GAP"},
        "establishes": {"const": "EXACT_WARNED_OLD_HKEL_SELECTION_OR_NO_RECORD"},
        "serving_mode": {"const": "KNOWN_STALE_ANALYTICAL_CARRY_FORWARD"},
        "selection_order": {"const": ["LATEST_APPLICABLE_HKEL_VERSION", "VERIFIED_IF_SAME_EXACT_VERSION", "NO_RECORD"]},
        "record_output": {"const": "NONE"},
        "external_effects": {"const": "NONE"}
      }
    }
  }
}
