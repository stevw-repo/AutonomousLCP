    "source_id": {"enum": ["HK-LEG-HKEL-PAST-INVENTORY", "HK-LEG-HKEL-PAST-DATA", "HK-LEG-OFFICIAL-GAZETTE-ARCHIVE", "HK-LEG-HKEL-GAZETTE-BACKCAPTURE"]},
