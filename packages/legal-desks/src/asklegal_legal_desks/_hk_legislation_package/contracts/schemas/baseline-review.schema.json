    "source_code_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "source_codes"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-review.source-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "source_codes": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "permitted_use"], "properties": {"code": {"$ref": "#/$defs/source_id"}, "permitted_use": {"type": "string", "minLength": 1}}}}}},
    "reason_code_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "reason_codes"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-review.reason-codes"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "reason_codes": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["code", "meaning", "processing_outcome"], "properties": {"code": {"$ref": "#/$defs/reason_code"}, "meaning": {"type": "string", "minLength": 1}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}}}}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["rule_id", "version", "stage", "branch_precedence", "successor_rule_id", "permitted_source_ids", "trigger_fact_bindings"], "properties": {"rule_id": {"const": "HKLEG-BASE-REVIEW-001"}, "version": {"const": "1.0.0"}, "stage": {"const": "FIRST_BASELINE_TARGETED_HISTORICAL_REVIEW"}, "branch_precedence": {"const": ["NO_MATERIAL_UNCERTAINTY", "BROAD_HISTORY_FORBIDDEN", "SOURCE_NOT_PERMITTED", "FACT_SCOPE_MISMATCH", "TARGETED_INVESTIGATION_OPENED"]}, "successor_rule_id": {"const": "HKLEG-BASE-HIST-001"}, "permitted_source_ids": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}}, "trigger_fact_bindings": {"const": {"POSSIBLE_DUPLICATE_OR_CONTINUITY": "IDENTITY_OR_CONTINUITY", "PARTIAL_OR_UNCLEAR_PRESENT_STATUS": "PRESENT_OPERATIVE_STATUS", "UNPROVED_OWNERSHIP_REPLACEMENT_OR_CESSATION": "OWNERSHIP_REPLACEMENT_OR_CESSATION", "ACCEPTED_SOURCE_CONFLICT": "SOURCE_CONFLICT_RESOLUTION", "RULEBOOK_REQUIRES_EARLIER_ARTIFACT": "EARLIER_ARTIFACT_FACT"}}}},
