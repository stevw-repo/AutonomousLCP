    "fixture": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "title", "synthetic", "status", "rule_id", "input_fingerprint", "input", "expected_artifact"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-REVIEW-FIX-00[1-5]$"}, "title": {"type": "string", "minLength": 1}, "synthetic": {"const": true}, "status": {"const": "FROZEN_PARTIAL"}, "rule_id": {"const": "HKLEG-BASE-REVIEW-001"}, "input_fingerprint": {"$ref": "#/$defs/sha256"}, "input": {"$ref": "#/$defs/input"}, "expected_artifact": {"type": "object", "additionalProperties": false, "required": ["path", "fingerprint"], "properties": {"path": {"type": "string", "pattern": "^expected/baseline-review/HKLEG-BASE-REVIEW-FIX-00[1-5]\\.json$"}, "fingerprint": {"$ref": "#/$defs/sha256"}}}}},
    "fixture_catalogue": {"type": "object", "additionalProperties": false, "required": ["catalogue_id", "version", "status", "accepted_complete_universe", "fixtures"], "properties": {"catalogue_id": {"const": "asklegal.hk-legislation.baseline-review.fixtures"}, "version": {"const": "1.0.0"}, "status": {"const": "FROZEN_PARTIAL"}, "accepted_complete_universe": {"const": false}, "fixtures": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "path", "fixture_fingerprint", "expected_path", "expected_fingerprint"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-REVIEW-FIX-00[1-5]$"}, "path": {"type": "string", "pattern": "^fixtures/deterministic/HKLEG-BASE-REVIEW-FIX-00[1-5]\\.json$"}, "fixture_fingerprint": {"$ref": "#/$defs/sha256"}, "expected_path": {"type": "string", "pattern": "^expected/baseline-review/HKLEG-BASE-REVIEW-FIX-00[1-5]\\.json$"}, "expected_fingerprint": {"$ref": "#/$defs/sha256"}}}}}},
    "decision": {"type": "object", "additionalProperties": false, "required": ["fixture_id", "rule_id", "processing_outcome", "legal_disposition", "coverage_effect", "source_contract_review_required", "reason_codes", "rule_trace", "review_task", "affected_scope_ids", "record_output", "next_action"], "properties": {"fixture_id": {"type": "string", "pattern": "^HKLEG-BASE-REVIEW-FIX-00[1-5]$"}, "rule_id": {"const": "HKLEG-BASE-REVIEW-001"}, "processing_outcome": {"enum": ["PASS", "BLOCK"]}, "legal_disposition": {"const": "NOT_APPLICABLE"}, "coverage_effect": {"const": "NONE"}, "source_contract_review_required": {"const": false}, "reason_codes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/reason_code"}}, "rule_trace": {"const": ["HKLEG-BASE-REVIEW-001"]}, "review_task": {"oneOf": [{"$ref": "#/$defs/review_task"}, {"type": "null"}]}, "affected_scope_ids": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/scope_id"}}, "record_output": {"const": "NONE"}, "next_action": {"enum": ["RUN_HKLEG_BASE_HIST_001", "CONTINUE_CLEAR_BASELINE", "NARROW_INVESTIGATION", "USE_REGISTERED_HISTORICAL_SOURCES", "ALIGN_FACT_SCOPE"]}}}
