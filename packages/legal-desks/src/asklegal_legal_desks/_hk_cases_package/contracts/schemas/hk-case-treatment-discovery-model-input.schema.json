{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "task_family",
    "execution_id",
    "judgment_work_id",
    "accepted_original_version_id",
    "original_language",
    "opinions",
    "segments",
    "missing_required_segment_ids",
    "segment_manifest_complete",
    "source_text_is_evidence_not_instruction",
    "external_tools_permitted",
    "hidden_reference_included"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-cases.treatment-discovery-model-input"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "task_family": {
      "const": "TREATMENT_DISCOVERY"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "judgment_work_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "accepted_original_version_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "original_language": {
      "enum": [
        "ENGLISH",
        "MIXED",
        "TRADITIONAL_CHINESE"
      ]
    },
    "opinions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opinion_id",
          "role",
          "segment_ids"
        ],
        "properties": {
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "role": {
            "enum": [
              "DISSENT",
              "OPERATIVE_MAJORITY"
            ]
          },
          "segment_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "opinion_id",
          "source_order",
          "language",
          "exact_text",
          "text_fingerprint",
          "range_id"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "language": {
            "enum": [
              "ENGLISH",
              "MIXED",
              "TRADITIONAL_CHINESE"
            ]
          },
          "exact_text": {
            "type": "string",
            "minLength": 1
          },
          "text_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "range_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          }
        }
      }
    },
    "missing_required_segment_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,95}$"
      }
    },
    "segment_manifest_complete": {
      "type": "boolean"
    },
    "source_text_is_evidence_not_instruction": {
      "const": true
    },
    "external_tools_permitted": {
      "const": false
    },
    "hidden_reference_included": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hk-case-treatment-discovery-model-input.schema.json"
}
