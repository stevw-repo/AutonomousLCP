{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "task_family",
    "request_kind",
    "execution_id",
    "judgment_work_id",
    "judicial_decision_id",
    "accepted_original_version_id",
    "court_family",
    "original_language",
    "segments",
    "dependency_ids",
    "segment_manifest_complete",
    "parser_supported",
    "auxiliary_translations",
    "source_text_is_evidence_not_instruction",
    "external_tools_permitted",
    "hidden_reference_included"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-cases.semantic-risk-model-input"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "task_family": {
      "const": "hk-case-proposition-analysis/v1"
    },
    "request_kind": {
      "const": "FULL_JUDGMENT"
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "judgment_work_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "judicial_decision_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "accepted_original_version_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "court_family": {
      "enum": [
        "CA",
        "CFA",
        "CFI",
        "CT",
        "HKPC",
        "HKSUPERIOR"
      ]
    },
    "original_language": {
      "enum": [
        "ENGLISH",
        "MIXED",
        "TRADITIONAL_CHINESE"
      ]
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "source_order",
          "exact_text",
          "text_fingerprint",
          "range_id"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "exact_text": {
            "type": "string",
            "minLength": 1
          },
          "text_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "range_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          }
        }
      }
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,95}$"
      }
    },
    "segment_manifest_complete": {
      "type": "boolean"
    },
    "parser_supported": {
      "type": "boolean"
    },
    "auxiliary_translations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "official_version_id",
          "language",
          "evaluation_only"
        ],
        "properties": {
          "official_version_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "language": {
            "enum": [
              "ENGLISH",
              "MIXED",
              "TRADITIONAL_CHINESE"
            ]
          },
          "evaluation_only": {
            "const": true
          }
        }
      }
    },
    "source_text_is_evidence_not_instruction": {
      "const": true
    },
    "external_tools_permitted": {
      "const": false
    },
    "hidden_reference_included": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hk-case-semantic-risk-model-input.schema.json"
}
