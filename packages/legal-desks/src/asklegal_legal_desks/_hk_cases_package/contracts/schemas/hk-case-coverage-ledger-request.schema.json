{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hk-case-coverage-ledger-request.schema.json",
  "title": "Hong Kong Case Proposition Coverage Ledger request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "rule_id",
    "judicial_decision_id",
    "official_version_id",
    "artifact_fingerprint",
    "parser_fingerprint",
    "rulebook_fingerprint",
    "cutoff",
    "source_support_available",
    "source_support_refs",
    "semantic_resolution_complete",
    "opinions",
    "units",
    "segments",
    "candidates"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-cases.coverage-ledger-request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "const": "HKCASE-PROP-COVERAGE-LEDGER-001"
    },
    "judicial_decision_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "official_version_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "artifact_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parser_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "rulebook_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cutoff": {
      "type": "string",
      "minLength": 1
    },
    "source_support_available": {
      "type": "boolean"
    },
    "source_support_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,95}$"
      }
    },
    "semantic_resolution_complete": {
      "type": "boolean"
    },
    "opinions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opinion_id",
          "role",
          "judge_ids"
        ],
        "properties": {
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "role": {
            "enum": [
              "AGREEMENT_ONLY",
              "CONCURRENCE",
              "COURT",
              "DISSENT",
              "JOINT",
              "LEAD",
              "OTHER"
            ]
          },
          "judge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "opinion_id",
          "source_order",
          "kind",
          "source_range_id",
          "text_fingerprint",
          "resolutions",
          "primary_uses",
          "evidence_roles",
          "non_propositional_reason",
          "citation_or_treatment_lead",
          "screening_handoff_ids"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "APPEARANCE",
              "APPENDIX",
              "COVER",
              "DISPOSITION",
              "FOOTNOTE",
              "HEADING",
              "ORDER",
              "PARAGRAPH",
              "QUOTED_BLOCK",
              "SCHEDULE",
              "TABLE"
            ]
          },
          "source_range_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "text_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "resolutions": {
            "type": "array",
            "items": {
              "enum": [
                "BLOCKED",
                "QUARANTINED",
                "RESOLVED"
              ]
            }
          },
          "primary_uses": {
            "type": "array",
            "items": {
              "enum": [
                "CONTEXT_EVIDENCE",
                "NON_PROPOSITIONAL",
                "PROPOSITION_EVIDENCE"
              ]
            }
          },
          "evidence_roles": {
            "type": "array",
            "items": {
              "enum": [
                "ANSWER",
                "APPLICATION",
                "ATTRIBUTION",
                "CONTEXT",
                "ISSUE",
                "QUALIFICATION",
                "QUOTATION",
                "RESULT",
                "SUPPLEMENTARY"
              ]
            }
          },
          "non_propositional_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "AGREEMENT_ONLY_OPINION",
              "NON_MATERIAL_DISCUSSION",
              "OUTCOME_WITHOUT_LEGAL_ANSWER",
              "SOURCE_SCAFFOLDING",
              "TREATMENT_ONLY_REASONING",
              "UNADOPTED_CITATION_OR_QUOTATION",
              "UNADOPTED_PARTY_POSITION",
              "UNUSED_PROCEDURAL_OR_FACTUAL_NARRATIVE"
            ]
          },
          "citation_or_treatment_lead": {
            "type": "boolean"
          },
          "screening_handoff_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id",
          "opinion_id",
          "primary_unit_ids",
          "dependencies"
        ],
        "properties": {
          "segment_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "primary_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "primary_unit_id",
                "primary_text_fingerprint",
                "kind",
                "adoption_range_ids"
              ],
              "properties": {
                "primary_unit_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                },
                "primary_text_fingerprint": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "kind": {
                  "enum": [
                    "CONTEXT",
                    "CROSS_OPINION_ADOPTION"
                  ]
                },
                "adoption_range_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,95}$"
                  }
                }
              }
            }
          }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "outcome",
          "evidence_unit_ids"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "outcome": {
            "enum": [
              "ACCEPTED",
              "BLOCKED",
              "MERGED",
              "QUARANTINED",
              "REJECTED",
              "SPLIT"
            ]
          },
          "evidence_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          }
        }
      }
    }
  }
}
