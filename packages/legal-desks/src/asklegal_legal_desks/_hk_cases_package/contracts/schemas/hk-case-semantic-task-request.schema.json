{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hk-case-semantic-task-request.schema.json",
  "title": "Hong Kong Case semantic task request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "rule_id",
    "task_family",
    "request_kind",
    "execution_id",
    "attempt_id",
    "packet_id",
    "judgment_work_id",
    "workflow_components",
    "judicial_decision_id",
    "official_version_id",
    "artifact_fingerprint",
    "source_snapshot_fingerprint",
    "cutoff",
    "court",
    "decision_date",
    "citation",
    "original_language",
    "opinions",
    "units",
    "assigned_primary_unit_ids",
    "supplied_units",
    "evidence_ranges",
    "dependencies",
    "allowed_object_ids",
    "required_evidence_role_codes",
    "output_budget_bytes",
    "validated_proposal_fingerprint",
    "reconciled_objection_fingerprint",
    "source_text_is_instruction",
    "external_tools_permitted",
    "hidden_reference_included",
    "confidence_score_requested",
    "source_evidence_available"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-cases.semantic-task-request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "const": "HKCASE-PROP-SEMANTIC-TASK-PREFLIGHT-001"
    },
    "task_family": {
      "enum": [
        "hk-case-proposition-analysis/v1",
        "hk-case-proposition-challenge/v1"
      ]
    },
    "request_kind": {
      "enum": [
        "COVERAGE_PACKET_CHALLENGE",
        "EVIDENCE_PACKET",
        "FINAL_TARGETED_CHALLENGE",
        "FULL_JUDGMENT",
        "FULL_JUDGMENT_CHALLENGE",
        "JUDGMENT_INTEGRATION",
        "JUDGMENT_RESULT_CHALLENGE",
        "TARGETED_REANALYSIS"
      ]
    },
    "execution_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "packet_id": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "judgment_work_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "workflow_components": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_role",
          "fingerprint"
        ],
        "properties": {
          "component_role": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "judicial_decision_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "official_version_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,95}$"
    },
    "artifact_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_snapshot_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "cutoff": {
      "type": "string",
      "format": "date"
    },
    "court": {
      "type": "string",
      "minLength": 1
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "original_language": {
      "enum": [
        "ENGLISH",
        "MIXED",
        "TRADITIONAL_CHINESE"
      ]
    },
    "opinions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "opinion_id",
          "source_order",
          "role",
          "judge_ids"
        ],
        "properties": {
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "role": {
            "enum": [
              "AGREEMENT_ONLY",
              "CONCURRENCE",
              "COURT",
              "DISSENT",
              "JOINT",
              "LEAD",
              "OTHER"
            ]
          },
          "judge_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          }
        }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "opinion_id",
          "source_order",
          "primary",
          "text_fingerprint",
          "required_dependency_unit_ids"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "opinion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "source_order": {
            "type": "integer",
            "minimum": 1
          },
          "primary": {
            "type": "boolean"
          },
          "text_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "required_dependency_unit_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{2,95}$"
            }
          }
        }
      }
    },
    "assigned_primary_unit_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,95}$"
      }
    },
    "supplied_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "exact_text"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "exact_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_ranges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "range_id",
          "unit_id",
          "start_byte",
          "end_byte",
          "exact_text_fingerprint"
        ],
        "properties": {
          "range_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "start_byte": {
            "type": "integer",
            "minimum": 0
          },
          "end_byte": {
            "type": "integer",
            "minimum": 1
          },
          "exact_text_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assigned_unit_id",
          "dependency_unit_id",
          "dependency_text_fingerprint"
        ],
        "properties": {
          "assigned_unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "dependency_unit_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          },
          "dependency_text_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "allowed_object_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{2,95}$"
      }
    },
    "required_evidence_role_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
      }
    },
    "output_budget_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "validated_proposal_fingerprint": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "reconciled_objection_fingerprint": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_text_is_instruction": {
      "type": "boolean"
    },
    "external_tools_permitted": {
      "type": "boolean"
    },
    "hidden_reference_included": {
      "type": "boolean"
    },
    "confidence_score_requested": {
      "type": "boolean"
    },
    "source_evidence_available": {
      "type": "boolean"
    }
  }
}
