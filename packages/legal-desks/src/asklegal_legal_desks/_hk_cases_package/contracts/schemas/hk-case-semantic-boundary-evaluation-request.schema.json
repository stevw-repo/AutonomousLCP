{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hk-case-semantic-boundary-evaluation-request.schema.json",
  "title": "Hong Kong Case semantic boundary evaluator request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "rule_id",
    "evaluator_fingerprint",
    "reference",
    "observation"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-cases.semantic-boundary-evaluation-request"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "const": "HKCASE-PROP-SEM-BOUNDARY-EVALUATOR-001"
    },
    "evaluator_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "rule_id",
        "reference_map_id",
        "model_input_fingerprint",
        "opinions",
        "propositions",
        "units",
        "expected_disposition",
        "expected_selected_reference_proposition_ids",
        "adjudication_complete",
        "unresolved_reference_ambiguity"
      ],
      "properties": {
        "schema_id": {
          "const": "asklegal.hk-cases.semantic-boundary-reference"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "rule_id": {
          "const": "HKCASE-PROP-SEM-BOUNDARY-EVALUATOR-001"
        },
        "reference_map_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,95}$"
        },
        "model_input_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "opinions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "opinion_id",
              "role",
              "judge_ids",
              "joined_opinion_id",
              "expressly_adopted_opinion_ids"
            ],
            "properties": {
              "opinion_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "role": {
                "enum": [
                  "AGREEMENT_ONLY",
                  "CONCURRENCE",
                  "COURT",
                  "DISSENT",
                  "JOINT",
                  "LEAD",
                  "OTHER"
                ]
              },
              "judge_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              },
              "joined_opinion_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,95}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expressly_adopted_opinion_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              }
            }
          }
        },
        "propositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reference_proposition_id",
              "expected_resolution",
              "issue_code",
              "authority_role",
              "opinion_path_ids",
              "required_meaning_codes",
              "required_boundary_codes",
              "forbidden_boundary_codes",
              "required_range_ids"
            ],
            "properties": {
              "reference_proposition_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "expected_resolution": {
                "enum": [
                  "ACCEPTED",
                  "QUARANTINED"
                ]
              },
              "issue_code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
              },
              "authority_role": {
                "enum": [
                  "ADOPTED_OPERATIVE",
                  "CONCURRENCE",
                  "DISSENT",
                  "OBITER",
                  "OPERATIVE",
                  "PLURALITY"
                ]
              },
              "opinion_path_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              },
              "required_meaning_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                }
              },
              "required_boundary_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                }
              },
              "forbidden_boundary_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                }
              },
              "required_range_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              }
            }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "opinion_id",
              "use",
              "reference_proposition_ids"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "opinion_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "use": {
                "enum": [
                  "AGREEMENT_ONLY",
                  "NON_PROPOSITIONAL",
                  "PROPOSITION_EVIDENCE"
                ]
              },
              "reference_proposition_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              }
            }
          }
        },
        "expected_disposition": {
          "enum": [
            "ACCOUNTED_WITH_QUARANTINE",
            "COMPLETE_WITH_PROPOSITIONS"
          ]
        },
        "expected_selected_reference_proposition_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          }
        },
        "adjudication_complete": {
          "type": "boolean"
        },
        "unresolved_reference_ambiguity": {
          "type": "boolean"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "rule_id",
        "model_input_fingerprint",
        "workflow_result_fingerprint",
        "opinions",
        "propositions",
        "units",
        "disposition",
        "selected_candidate_ids",
        "complete_ledger",
        "source_text_treated_as_instruction",
        "hidden_reference_received_by_workflow"
      ],
      "properties": {
        "schema_id": {
          "const": "asklegal.hk-cases.semantic-boundary-observation"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "rule_id": {
          "const": "HKCASE-PROP-SEM-BOUNDARY-EVALUATOR-001"
        },
        "model_input_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "workflow_result_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "opinions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "opinion_id",
              "role",
              "judge_ids",
              "joined_opinion_id",
              "expressly_adopted_opinion_ids"
            ],
            "properties": {
              "opinion_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "role": {
                "enum": [
                  "AGREEMENT_ONLY",
                  "CONCURRENCE",
                  "COURT",
                  "DISSENT",
                  "JOINT",
                  "LEAD",
                  "OTHER"
                ]
              },
              "judge_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              },
              "joined_opinion_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,95}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expressly_adopted_opinion_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              }
            }
          }
        },
        "propositions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "mapped_reference_proposition_id",
              "resolution",
              "issue_code",
              "authority_role",
              "opinion_path_ids",
              "meaning_codes",
              "boundary_codes",
              "range_ids",
              "derived_statement"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "mapped_reference_proposition_id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{2,95}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "resolution": {
                "enum": [
                  "ACCEPTED",
                  "QUARANTINED"
                ]
              },
              "issue_code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
              },
              "authority_role": {
                "enum": [
                  "ADOPTED_OPERATIVE",
                  "CONCURRENCE",
                  "DISSENT",
                  "OBITER",
                  "OPERATIVE",
                  "PLURALITY"
                ]
              },
              "opinion_path_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              },
              "meaning_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                }
              },
              "boundary_codes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
                }
              },
              "range_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              },
              "derived_statement": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        },
        "units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "unit_id",
              "opinion_id",
              "use",
              "candidate_ids"
            ],
            "properties": {
              "unit_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "opinion_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{2,95}$"
              },
              "use": {
                "enum": [
                  "AGREEMENT_ONLY",
                  "NON_PROPOSITIONAL",
                  "PROPOSITION_EVIDENCE"
                ]
              },
              "candidate_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{2,95}$"
                }
              }
            }
          }
        },
        "disposition": {
          "enum": [
            "ACCOUNTED_WITH_QUARANTINE",
            "COMPLETE_WITH_PROPOSITIONS"
          ]
        },
        "selected_candidate_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{2,95}$"
          }
        },
        "complete_ledger": {
          "type": "boolean"
        },
        "source_text_treated_as_instruction": {
          "type": "boolean"
        },
        "hidden_reference_received_by_workflow": {
          "type": "boolean"
        }
      }
    }
  }
}
