            "pattern": "^rec_[0-9a-f]{48}$"
          },
          "uniqueItems": true
        },
        "predecessor_search_record_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^rec_[0-9a-f]{48}$"
          },
          "uniqueItems": true
        },
        "register_allocation_count": {
          "type": "integer",
          "minimum": 0
