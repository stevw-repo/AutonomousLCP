              "additionalProperties": false,
              "required": [
                "last_approved_status",
                "last_verified_at",
                "coverage_gap_id",
                "warning_code",
                "next_due_at",
                "support_ref"
              ],
              "properties": {
                "last_approved_status": {
                  "type": "string",
                  "minLength": 1
                },
                "last_verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverage_gap_id": {
                  "type": "string",
                  "minLength": 1
                },
                "warning_code": {
                  "type": "string",
