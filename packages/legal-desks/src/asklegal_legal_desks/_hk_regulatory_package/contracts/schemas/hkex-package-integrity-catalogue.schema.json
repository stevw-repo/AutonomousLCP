{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-package-integrity-catalogue.schema.json",
  "title": "HKEX package-integrity executable checkpoint catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "status",
    "case_count",
    "primary_coverage_cell_count",
    "high_risk_pair_ids",
    "entries",
    "checkpoint_complete",
    "full_conformance_suite_complete",
    "activation_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.package-integrity-catalogue"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "catalogue_id": {
      "const": "hk-regulatory-package-integrity"
    },
    "catalogue_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "FROZEN_EXECUTABLE_CHECKPOINT"
    },
    "case_count": {
      "const": 38
    },
    "primary_coverage_cell_count": {
      "const": 38
    },
    "high_risk_pair_ids": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "primary_coverage_cell_id",
          "pair_membership",
          "assertion_scope",
          "expected_outcome",
          "expected_reason",
          "fixture_path",
          "fixture_fingerprint",
          "expected_path",
          "expected_fingerprint"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "primary_coverage_cell_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_membership": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pair_id",
                  "role"
                ],
                "properties": {
                  "pair_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "POSITIVE",
                      "NEAR_MISS"
                    ]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "assertion_scope": {
            "enum": [
              "COMPLETE_PACKAGE",
              "CLOSED_SCHEMA",
              "ARTIFACT_HASH",
              "DECLARED_ACCESS",
              "REQUIRED_FILE",
              "ABSOLUTE_PATH",
              "NORMALIZED_PATH",
              "SYMLINK",
              "REMOTE_RESOURCE",
              "EXPLICIT_INVENTORY",
              "AVAILABLE_INPUT",
              "DELIBERATE_ABSENCE",
              "UNREADABLE_INPUT",
              "AVAILABLE_FACT_CONDITION",
              "EXACT_OUTPUT",
              "ZERO_OUTPUT",
              "NOT_APPLICABLE_OUTPUT",
              "MATRIX_COMPLETENESS",
              "PAIR_COMPLETENESS",
              "PROPOSAL_ISOLATION",
              "IMMUTABLE_FINGERPRINT",
              "REPRODUCIBILITY",
              "HOSTILE_SOURCE_TEXT",
              "LOCAL_CAPABILITY_DENIAL",
              "EXTERNAL_CAPABILITY_DENIAL",
              "AUTHORITY_CONTAINMENT",
              "ATTESTATION_COMPATIBILITY",
              "MEDIA_AND_PERMISSION"
            ]
          },
          "expected_outcome": {
            "enum": [
              "ACCEPTED",
              "REJECTED"
            ]
          },
          "expected_reason": {
            "enum": [
              "PACKAGE_VALID",
              "CLOSED_SCHEMA_VIOLATION",
              "ARTIFACT_HASH_MISMATCH",
              "UNDECLARED_FILE_ACCESS",
              "REQUIRED_FILE_ABSENT",
              "PATH_CONTAINMENT_INVALID",
              "SYMLINK_FORBIDDEN",
              "REMOTE_RESOURCE_FORBIDDEN",
              "DYNAMIC_DISCOVERY_FORBIDDEN",
              "INPUT_AVAILABLE_ADMITTED",
              "INPUT_AVAILABLE_INVALID",
              "DELIBERATE_ABSENCE_ADMITTED",
              "UNREADABLE_CONDITION_ADMITTED",
              "AVAILABLE_FACT_CONDITION_ADMITTED",
              "EXACT_ARTIFACT_MATCHED",
              "EXPECTED_EXACT_INVALID",
              "ZERO_OUTPUT_PROVED",
              "ZERO_OUTPUT_PROOF_INVALID",
              "NOT_APPLICABLE_PROVED",
              "NOT_APPLICABLE_INVALID",
              "MATRIX_COMPLETE",
              "MATRIX_INCOMPLETE",
              "PAIR_COMPLETE",
              "PAIR_INCOMPLETE",
              "PROPOSAL_PACKET_CLEAN",
              "PROPOSAL_TRUTH_LEAKAGE",
              "FINGERPRINT_OR_TRUTH_MUTATION",
              "REPRODUCIBLE",
              "REPRODUCIBILITY_FAILURE",
              "HOSTILE_TEXT_INERT",
              "HOSTILE_INPUT_CONTROL_BREACH",
              "FORBIDDEN_CAPABILITY_ATTEMPT",
              "PACKAGE_VALIDITY_ONLY",
              "BUILD_COMPATIBILITY_ONLY",
              "AUTHORITY_BROADENING",
              "ATTESTATION_MISMATCH",
              "MEDIA_OR_PERMISSION_INVALID"
            ]
          },
          "fixture_path": {
            "type": "string",
            "minLength": 1
          },
          "fixture_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expected_path": {
            "type": "string",
            "minLength": 1
          },
          "expected_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "checkpoint_complete": {
      "const": true
    },
    "full_conformance_suite_complete": {
      "const": false
    },
    "activation_authorized": {
      "const": false
    },
    "external_effects": {
      "const": "NONE"
    }
  }
}
