{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-boundary-decision-report.schema.json",
  "title": "HKEX record-boundary decision conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "rule_id",
    "case_id",
    "assertion_scope",
    "observed_decision",
    "expected_decision",
    "conformance_status",
    "source_authorized",
    "provider_authorized",
    "release_authorized",
    "serving_authorized",
    "deployment_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.boundary-decision-report"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "const": "HKREG-BOUNDARY-DECISION-001"
    },
    "case_id": {
      "type": "string",
      "pattern": "^HKREG-DEC-BND-(0[0-2][0-9]|030)$"
    },
    "assertion_scope": {
      "enum": [
        "NORMAL_UNIT",
        "GOVERNING_DEPENDENCY",
        "DEFINITION",
        "LEGAL_STRUCTURE",
        "CROSS_REFERENCE"
      ]
    },
    "observed_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "rule_id",
        "case_id",
        "outcome",
        "reason",
        "responsibilities",
        "dependency_owners",
        "references",
        "excluded_background_unit_ids",
        "quarantined_unit_ids",
        "rejected_candidate",
        "source_contract_review_required",
        "quarantined_branch",
        "presentation_identity_rejected",
        "relationship_revision_only",
        "referring_payload_change_required",
        "search_record_authorized",
        "embedding_authorized",
        "release_authorized",
        "serving_authorized",
        "external_effects"
      ],
      "properties": {
        "schema_id": {
          "const": "asklegal.hk-regulatory.boundary-decision-result"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "rule_id": {
          "const": "HKREG-BOUNDARY-DECISION-001"
        },
        "case_id": {
          "type": "string",
          "pattern": "^HKREG-DEC-BND-(0[0-2][0-9]|030)$"
        },
        "outcome": {
          "enum": [
            "PASS",
            "BLOCK",
            "QUARANTINE"
          ]
        },
        "reason": {
          "enum": [
            "ONE_COMPLETE_NORMAL_UNIT",
            "INDEPENDENT_CHILDREN_SELECTED",
            "INSEPARABLE_GROUP_PRESERVED",
            "REQUIRED_DEPENDENCIES_PRESERVED",
            "UNSAFE_CHILD_BOUNDARY_REJECTED",
            "NOTE_OWNER_PRESERVED",
            "NOTE_OWNERSHIP_REJECTED",
            "TERM_DEFINITIONS_SELECTED",
            "GLOBAL_DEFINITION_SELECTED",
            "GLOBAL_DEFINITION_DUPLICATION_REJECTED",
            "PRESENTATION_IDENTITY_REJECTED",
            "SOURCE_STRUCTURE_REVIEW_REQUIRED",
            "BACKGROUND_EXCLUDED",
            "DEPENDENCY_OWNER_LINKED",
            "CROSS_REFERENCE_PRESERVED",
            "RECURSIVE_TARGET_COPY_REJECTED",
            "REFERENCE_CHAIN_PRESERVED",
            "TARGET_RESOLUTION_REQUIRED",
            "CROSS_BOARD_REFERENCE_PRESERVED",
            "RELATIONSHIP_REVISION_ONLY",
            "COMPLETE_UNIT_OVER_LIMIT",
            "UNRELATED_PACKING_REJECTED"
          ]
        },
        "responsibilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "record_unit_id",
              "kind",
              "primary_source_unit_ids",
              "dependency_source_unit_ids"
            ],
            "properties": {
              "record_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "NORMAL",
                  "INSEPARABLE_GROUP",
                  "DEFINITION",
                  "APPENDIX",
                  "PRACTICE_NOTE",
                  "PARENT_FALLBACK"
                ]
              },
              "primary_source_unit_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "dependency_source_unit_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "dependency_owners": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_unit_id",
              "owner_record_unit_id",
              "content_fingerprint"
            ],
            "properties": {
              "source_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "owner_record_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "content_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "referring_unit_id",
              "referring_words",
              "referring_scope_id",
              "target_locator",
              "target_heading",
              "target_scope_id",
              "resolution",
              "target_text_included"
            ],
            "properties": {
              "referring_unit_id": {
                "type": "string",
                "minLength": 1
              },
              "referring_words": {
                "type": "string",
                "minLength": 1
              },
              "referring_scope_id": {
                "enum": [
                  "HK-REG-HKEX-GEM",
                  "HK-REG-HKEX-MAIN-BOARD"
                ]
              },
              "target_locator": {
                "type": "string",
                "minLength": 1
              },
              "target_heading": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "target_scope_id": {
                "enum": [
                  "HK-REG-HKEX-GEM",
                  "HK-REG-HKEX-MAIN-BOARD"
                ]
              },
              "resolution": {
                "enum": [
                  "RESOLVED",
                  "UNRESOLVED"
                ]
              },
              "target_text_included": {
                "const": false
              }
            }
          }
        },
        "excluded_background_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "quarantined_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_candidate": {
          "type": "boolean"
        },
        "source_contract_review_required": {
          "type": "boolean"
        },
        "quarantined_branch": {
          "type": "boolean"
        },
        "presentation_identity_rejected": {
          "type": "boolean"
        },
        "relationship_revision_only": {
          "type": "boolean"
        },
        "referring_payload_change_required": {
          "type": "boolean"
        },
        "search_record_authorized": {
          "const": false
        },
        "embedding_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "serving_authorized": {
          "const": false
        },
        "external_effects": {
          "const": "NONE"
        }
      }
    },
