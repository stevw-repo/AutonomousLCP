{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-state-decision-catalogue.schema.json",
  "title": "HKEX effective-state executable checkpoint catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "status",
    "case_count",
    "primary_coverage_cell_count",
    "high_risk_pair_ids",
    "entries",
    "checkpoint_complete",
    "full_conformance_suite_complete",
    "activation_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.state-decision-catalogue"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "catalogue_id": {
      "const": "hk-regulatory-state-decision"
    },
    "catalogue_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "FROZEN_EXECUTABLE_CHECKPOINT"
    },
    "case_count": {
      "const": 51
    },
    "primary_coverage_cell_count": {
      "const": 51
    },
    "high_risk_pair_ids": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 51,
      "maxItems": 51,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "primary_coverage_cell_id",
          "pair_memberships",
          "assertion_scope",
          "expected_outcome",
          "expected_reason",
          "fixture_path",
          "fixture_fingerprint",
          "expected_path",
          "expected_fingerprint"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "primary_coverage_cell_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_memberships": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pair_id",
                "role"
              ],
              "properties": {
                "pair_id": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "POSITIVE",
                    "NEAR_MISS"
                  ]
                }
              }
            }
          },
          "assertion_scope": {
            "enum": [
              "ATOMIC_STATE",
              "COMPONENT_SUMMARY",
              "BRANCH_SET",
              "RECORD_RESPONSIBILITY",
              "EFFECTIVE_ORDER",
              "SOURCE_FAILURE",
              "DOWNSTREAM_GATE",
              "UNKNOWN_REPAIR"
            ]
          },
          "expected_outcome": {
            "enum": [
              "PASS",
              "BLOCK",
              "QUARANTINE"
            ]
          },
          "expected_reason": {
            "enum": [
              "ATOMIC_STATE_DECIDED",
              "NON_RULE_NOT_APPLICABLE",
              "COMPONENT_SUMMARIZED",
              "COMPLETE_BRANCH_SET_PRESERVED",
              "SEPARATE_COMPLETE_RECORDS_REQUIRED",
              "ONE_LIMITED_RECORD_ELIGIBLE",
              "EFFECTIVE_FACT_ORDER_APPLIED",
              "LAST_APPROVED_CARRY_FORWARD",
              "AFFECTED_RECORDS_WITHHELD",
              "NO_NEW_TARGET",
              "OTHER_REQUIRED_GATE_FAILED",
              "UNKNOWN_REPAIR_REJECTED"
            ]
          },
          "fixture_path": {
            "type": "string",
            "minLength": 1
          },
          "fixture_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expected_path": {
            "type": "string",
            "minLength": 1
          },
          "expected_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "checkpoint_complete": {
      "const": true
    },
    "full_conformance_suite_complete": {
      "const": false
    },
    "activation_authorized": {
      "const": false
    },
    "external_effects": {
      "const": "NONE"
    }
  }
}
