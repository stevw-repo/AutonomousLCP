{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-state-decision-case.schema.json",
  "title": "HKEX effective-state evidence-to-decision conformance case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "package_contract_version",
    "case_id",
    "suite_layer",
    "primary_checkpoint",
    "frozen",
    "synthetic_evidence_class",
    "contract_bindings",
    "synthetic_cutoff",
    "scope_id",
    "prior_state",
    "primary_coverage_cell_ids",
    "secondary_coverage_cell_ids",
    "pair_memberships",
    "declared_input_inventory",
    "declared_reference_inventory",
    "declared_expected_inventory",
    "assertion_scope",
    "required_result_dimensions",
    "evidence_packet_fields",
    "supporting_evidence_ranges",
    "rule_trace",
    "established_facts",
    "unresolved_facts",
    "permitted_equivalent_results",
    "critical_error_codes",
    "package_fingerprint",
    "title",
    "purpose",
    "expected_decision",
    "evidence_packet",
    "facts",
    "case_fingerprint"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.state-decision-case"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_contract_version": {
      "const": "1.0.0"
    },
    "case_id": {
      "type": "string",
      "pattern": "^HKREG-DEC-STA-(0[0-4][0-9]|05[01])$"
    },
    "suite_layer": {
      "const": "EVIDENCE_TO_DECISION"
    },
    "primary_checkpoint": {
      "const": "EFFECTIVE_STATE"
    },
    "frozen": {
      "const": true
    },
    "synthetic_evidence_class": {
      "const": "SYNTHETIC_NO_REAL_AUTHORITY"
    },
    "contract_bindings": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract_id",
          "version",
          "fingerprint"
        ],
        "properties": {
          "contract_id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "synthetic_cutoff": {
      "const": "2026-08-24T00:00:00Z"
    },
    "scope_id": {
      "const": "HKEX_CROSS_BOARD"
    },
    "prior_state": {
      "const": "SYNTHETIC_ACCEPTED_PREDECESSOR"
    },
    "primary_coverage_cell_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "string",
        "pattern": "^HKREG-COV-DSTA-(0[0-4][0-9]|05[01])$"
      }
    },
    "secondary_coverage_cell_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "pair_memberships": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "role"
        ],
        "properties": {
          "pair_id": {
            "type": "string",
            "pattern": "^HKREG-PAIR-0(1[6-9]|2[0-4])$"
          },
          "role": {
            "enum": [
              "POSITIVE",
              "NEAR_MISS"
            ]
          }
        }
      }
    },
    "declared_input_inventory": {
      "const": [
        "state-evidence"
      ]
    },
    "declared_reference_inventory": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "declared_expected_inventory": {
      "const": [
        "STATE_DECISION_REPORT"
      ]
    },
    "assertion_scope": {
      "enum": [
        "ATOMIC_STATE",
        "COMPONENT_SUMMARY",
        "BRANCH_SET",
        "RECORD_RESPONSIBILITY",
        "EFFECTIVE_ORDER",
        "SOURCE_FAILURE",
        "DOWNSTREAM_GATE",
        "UNKNOWN_REPAIR"
      ]
    },
    "required_result_dimensions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_packet_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "supporting_evidence_ranges": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rule_trace": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "established_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_facts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "permitted_equivalent_results": {
      "type": "array",
      "maxItems": 0
    },
    "critical_error_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "package_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "expected_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_version",
        "rule_id",
        "case_id",
        "outcome",
        "reason",
        "not_applicable",
        "branch_decisions",
        "component_state",
        "record_responsibility",
        "ordered_branch_ids",
        "source_failure_choice",
        "carry_forward_support",
        "rebuild_target_authorized",
        "repair_rejected",
        "search_record_authorized",
        "embedding_authorized",
        "release_authorized",
        "serving_authorized",
        "external_effects"
      ],
      "properties": {
        "schema_id": {
          "const": "asklegal.hk-regulatory.state-decision-result"
        },
        "schema_version": {
          "const": "1.0.0"
        },
        "rule_id": {
          "const": "HKREG-STATE-DECISION-001"
        },
        "case_id": {
          "type": "string",
          "pattern": "^HKREG-DEC-STA-(0[0-4][0-9]|05[01])$"
        },
        "outcome": {
          "enum": [
            "PASS",
            "BLOCK",
            "QUARANTINE"
          ]
        },
        "reason": {
          "enum": [
            "ATOMIC_STATE_DECIDED",
            "NON_RULE_NOT_APPLICABLE",
            "COMPONENT_SUMMARIZED",
            "COMPLETE_BRANCH_SET_PRESERVED",
            "SEPARATE_COMPLETE_RECORDS_REQUIRED",
            "ONE_LIMITED_RECORD_ELIGIBLE",
            "EFFECTIVE_FACT_ORDER_APPLIED",
            "LAST_APPROVED_CARRY_FORWARD",
            "AFFECTED_RECORDS_WITHHELD",
            "NO_NEW_TARGET",
            "OTHER_REQUIRED_GATE_FAILED",
            "UNKNOWN_REPAIR_REJECTED"
          ]
        },
        "not_applicable": {
          "type": "boolean"
        },
        "branch_decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch_id",
              "state",
              "disposition",
              "processing_outcome",
              "reason",
              "applicability_context"
            ],
            "properties": {
              "branch_id": {
                "type": "string",
                "minLength": 1
              },
              "state": {
                "enum": [
                  "CURRENT",
                  "TRANSITIONAL_CURRENT",
                  "FUTURE_FIXED_DATE",
                  "FUTURE_CONDITIONAL",
                  "SUPERSEDED",
                  "WITHDRAWN",
                  "UNKNOWN"
                ]
              },
              "disposition": {
                "enum": [
                  "SEARCHABLE_CURRENT_RULE_COMPONENT",
                  "REGULATORY_WAITING_ROOM",
                  "HISTORICAL",
                  "QUARANTINE"
                ]
              },
              "processing_outcome": {
                "enum": [
                  "PASS",
                  "BLOCK",
                  "QUARANTINE"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "applicability_context": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "component_state": {
          "enum": [
            null,
            "CURRENT",
            "TRANSITIONAL_CURRENT",
            "FUTURE_FIXED_DATE",
            "FUTURE_CONDITIONAL",
            "SUPERSEDED",
            "WITHDRAWN",
            "UNKNOWN"
          ]
        },
        "record_responsibility": {
          "enum": [
            "NONE",
            "SEPARATE_COMPLETE_RECORDS",
            "ONE_LIMITED_RECORD_ELIGIBLE"
          ]
        },
        "ordered_branch_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_failure_choice": {
          "enum": [
            "NONE",
            "CARRY_FORWARD_LAST_APPROVED",
            "WITHHOLD",
            "NO_REBUILD"
          ]
        },
        "carry_forward_support": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "last_approved_status",
                "last_verified_at",
                "coverage_gap_id",
                "warning_code",
                "next_due_at",
                "support_ref"
              ],
              "properties": {
                "last_approved_status": {
                  "type": "string",
                  "minLength": 1
                },
                "last_verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverage_gap_id": {
                  "type": "string",
                  "minLength": 1
                },
                "warning_code": {
                  "type": "string",
                  "minLength": 1
                },
                "next_due_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "support_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "rebuild_target_authorized": {
          "const": false
        },
        "repair_rejected": {
          "type": "boolean"
        },
        "search_record_authorized": {
          "const": false
        },
        "embedding_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "serving_authorized": {
          "const": false
        },
        "external_effects": {
          "const": "NONE"
        }
      }
    },
    "evidence_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "state",
        "path",
        "role",
        "media_type",
        "content_fingerprint"
      ],
      "properties": {
        "slot_id": {
          "const": "state-evidence"
        },
        "state": {
          "const": "AVAILABLE"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "ORDINARY"
        },
        "media_type": {
          "const": "application/json"
        },
        "content_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branches",
        "carry_forward_support",
        "complete_branch_set",
        "effective_order_facts",
        "limitation_metadata_complete",
        "membership",
        "other_required_gates_passed",
        "repair_attempt",
        "unsupported_retirement_basis",
        "wording_relationship"
      ],
      "properties": {
        "membership": {
          "enum": [
            "RULE_COMPONENT",
            "EVIDENCE_ONLY",
            "EXCLUDED_NON_RULE",
            "UNRESOLVED_MEMBERSHIP"
          ]
        },
        "branches": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "applicability_context",
              "basis",
              "branch_id",
              "component_id",
              "condition_operator",
              "conditions",
              "current_product_ranges",
              "current_product_reconciliation",
              "cutoff",
              "decision_id",
              "effective_at",
              "evidence_fingerprint",
              "evidence_refs",
              "finality",
              "legal_location_id",
              "predecessor_branch_id",
              "retirement_evidence",
              "scope_id",
              "source_failure_choice",
              "source_failure_impact",
              "source_rule_id",
              "successor_branch_ids",
              "transition_state",
              "uncertainty_codes",
              "update_part_id",
              "update_source_ranges"
            ],
            "properties": {
              "decision_id": {
                "type": "string",
                "minLength": 1
              },
              "branch_id": {
                "type": "string",
                "minLength": 1
              },
              "component_id": {
                "type": "string",
                "minLength": 1
              },
              "scope_id": {
                "enum": [
                  "HK-REG-HKEX-GEM",
                  "HK-REG-HKEX-MAIN-BOARD"
                ]
              },
              "legal_location_id": {
                "type": "string",
                "minLength": 1
              },
              "cutoff": {
                "type": "string",
                "format": "date-time"
              },
              "update_part_id": {
                "type": "string",
                "minLength": 1
              },
              "update_source_ranges": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "current_product_ranges": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "basis": {
                "enum": [
                  "ORDINARY",
                  "FIXED_DATE",
                  "CONDITIONAL"
                ]
              },
              "finality": {
                "enum": [
                  "FINAL_PUBLICATION_APPROVAL_INFERRED",
                  "FINAL_DIRECT_APPROVAL_PROVED",
                  "CONSULTATION_OR_PROPOSAL",
                  "APPROVAL_PENDING",
                  "DIRECT_APPROVAL_REQUIRED_MISSING",
                  "CONFLICTING"
                ]
              },
              "effective_at": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "condition_operator": {
                "enum": [
                  null,
                  "ALL_OF",
                  "ANY_OF"
                ]
              },
              "conditions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "condition_id",
                    "registered_source_id",
                    "state",
                    "evidence_refs"
                  ],
                  "properties": {
                    "condition_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "registered_source_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "state": {
                      "enum": [
                        "OCCURRED",
                        "NOT_OCCURRED_FRESH",
                        "UNRESOLVED"
                      ]
                    },
                    "evidence_refs": {
                      "type": "array",
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              },
              "transition_state": {
                "enum": [
                  "ORDINARY",
                  "MATERIALLY_LIMITED_CURRENT",
                  "PROVED_ENDED"
                ]
              },
              "applicability_context": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "retirement_evidence": {
                "enum": [
                  "NONE",
                  "COMPLETE_SUCCESSOR",
                  "PARTIAL_SUCCESSOR",
                  "OFFICIAL_WITHDRAWAL_NO_SUCCESSOR",
                  "DISAPPEARANCE_ONLY",
                  "CONFLICTING"
                ]
              },
              "predecessor_branch_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "successor_branch_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "current_product_reconciliation": {
                "enum": [
                  "MATCH",
                  "CONFLICT",
                  "MISSING_STALE_OR_INCOMPLETE",
                  "NOT_YET_REQUIRED"
                ]
              },
              "uncertainty_codes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "source_failure_impact": {
                "enum": [
                  "NONE",
                  "COULD_CHANGE_CURRENT"
                ]
              },
              "source_failure_choice": {
                "enum": [
                  "NONE",
                  "CARRY_FORWARD_LAST_APPROVED",
                  "WITHHOLD",
                  "NO_REBUILD"
                ]
              },
              "source_rule_id": {
                "const": "HKREG-EFFECTIVE-STATE-001"
              },
              "evidence_refs": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_fingerprint": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              }
            }
          }
        },
        "complete_branch_set": {
          "type": "boolean"
        },
        "wording_relationship": {
          "enum": [
            "NOT_EVALUATED",
            "MATERIAL_DIFFERENCE",
            "SAME_WORDING"
          ]
        },
        "limitation_metadata_complete": {
          "type": "boolean"
        },
        "effective_order_facts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "branch_id",
              "supported_effective_at",
              "update_number"
            ],
            "properties": {
              "branch_id": {
                "type": "string",
                "minLength": 1
              },
              "supported_effective_at": {
                "type": "string",
                "format": "date-time"
              },
              "update_number": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "carry_forward_support": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "last_approved_status",
                "last_verified_at",
                "coverage_gap_id",
                "warning_code",
                "next_due_at",
                "support_ref"
              ],
              "properties": {
                "last_approved_status": {
                  "type": "string",
                  "minLength": 1
                },
                "last_verified_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "coverage_gap_id": {
                  "type": "string",
                  "minLength": 1
                },
                "warning_code": {
                  "type": "string",
                  "minLength": 1
                },
                "next_due_at": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "support_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "other_required_gates_passed": {
          "type": "boolean"
        },
        "repair_attempt": {
          "enum": [
            "NONE",
            "AUTHORITY_NOTE",
            "CONFIDENCE",
            "PROSE"
          ]
        },
        "unsupported_retirement_basis": {
          "enum": [
            "NONE",
            "SIMILARITY_REUSED_NUMBER_OR_HIGHER_UPDATE"
          ]
        }
      }
    },
    "case_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
