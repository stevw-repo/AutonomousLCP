{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-source-decision-catalogue.schema.json",
  "title": "HKEX source-decision executable checkpoint catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "status",
    "case_count",
    "primary_coverage_cell_count",
    "high_risk_pair_ids",
    "entries",
    "checkpoint_complete",
    "full_conformance_suite_complete",
    "activation_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.source-decision-catalogue"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "catalogue_id": {
      "const": "hk-regulatory-source-decision"
    },
    "catalogue_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "FROZEN_EXECUTABLE_CHECKPOINT"
    },
    "case_count": {
      "const": 62
    },
    "primary_coverage_cell_count": {
      "const": 62
    },
    "high_risk_pair_ids": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entries": {
      "type": "array",
      "minItems": 62,
      "maxItems": 62,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "primary_coverage_cell_id",
          "pair_membership",
          "assertion_scope",
          "expected_outcome",
          "expected_reason",
          "fixture_path",
          "fixture_fingerprint",
          "expected_path",
          "expected_fingerprint"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "primary_coverage_cell_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_membership": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pair_id",
                  "role"
                ],
                "properties": {
                  "pair_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "POSITIVE",
                      "NEAR_MISS"
                    ]
                  }
                }
              }
            ]
          },
          "assertion_scope": {
            "enum": [
              "FACT_AUTHORITY",
              "SOURCE_UNION",
              "SOURCE_CONTRACT",
              "APPROVAL",
              "NO_CHANGE",
              "OUTAGE_SCOPE",
              "HISTORICAL_INVESTIGATION",
              "MEMBERSHIP",
              "OWNERSHIP",
              "LANGUAGE"
            ]
          },
          "expected_outcome": {
            "enum": [
              "PASS",
              "BLOCK",
              "QUARANTINE"
            ]
          },
          "expected_reason": {
            "enum": [
              "ASSIGNED_FACTS_ACCEPTED",
              "OUT_OF_ROLE_FACT_REJECTED",
              "COMPLETE_UNION_ACCEPTED",
              "UNIVERSE_INCOMPLETE",
              "PRESENTATION_DISCREPANCY_PRESERVED",
              "SOURCE_CONTRACT_REVIEW_REQUIRED",
              "SOURCE_CONTRACT_ASSERTION_UNSUPPORTED",
              "APPROVAL_SATISFIED_BY_FINAL_PUBLICATION",
              "APPROVAL_NOT_PROVED",
              "DIRECT_APPROVAL_EVIDENCE_MISSING",
              "SUPPORTED_NO_CHANGE",
              "NO_CHANGE_UNPROVED",
              "BOARD_SPECIFIC_GAP",
              "SHARED_UNBOUNDED_GAP",
              "BOUNDED_HISTORICAL_GAP",
              "RULE_COMPONENT_CLASSIFIED",
              "EXCLUDED_NON_RULE_CLASSIFIED",
              "EVIDENCE_ONLY_CLASSIFIED",
              "MEMBERSHIP_UNRESOLVED",
              "OWNER_ASSIGNED",
              "SHARED_ARTIFACT_INSTANCES_ASSIGNED",
              "MULTI_COMPONENTS_ACCOUNTED",
              "SEPARATE_IDENTITIES_REQUIRED",
              "PLACEMENT_DISCREPANCY_PRESERVED",
              "OWNER_MISSING",
              "OWNER_CONFLICT",
              "DOUBLE_OWNED_INSTANCE",
              "ORPHAN_COMPONENT",
              "DUPLICATE_COMPONENT",
              "CRITICAL_WRONG_BOARD",
              "ENGLISH_COMPLETE_CHINESE_OPTIONAL",
              "REQUIRED_ENGLISH_MISSING",
              "CHINESE_DISCREPANCY_NONBLOCKING",
              "CHINESE_ENGLISH_DEFECT_SIGNAL",
              "CHINESE_ONLY_NO_SERVING_CHANGE",
              "PROHIBITED_SOURCE_REPAIR",
              "OPTIONAL_CHINESE_TRACEABILITY_ONLY"
            ]
          },
          "fixture_path": {
            "type": "string",
            "minLength": 1
          },
          "fixture_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expected_path": {
            "type": "string",
            "minLength": 1
          },
          "expected_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "checkpoint_complete": {
      "const": true
    },
    "full_conformance_suite_complete": {
      "const": false
    },
    "activation_authorized": {
      "const": false
    },
    "external_effects": {
      "const": "NONE"
    }
  }
}
