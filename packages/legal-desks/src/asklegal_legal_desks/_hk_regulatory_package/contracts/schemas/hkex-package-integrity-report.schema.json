{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-package-integrity-report.schema.json",
  "title": "HKEX package-integrity conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "rule_id",
    "case_id",
    "assertion_scope",
    "observed_outcome",
    "observed_reason",
    "expected_outcome",
    "expected_reason",
    "conformance_status",
    "package_valid",
    "external_state_mutated",
    "authority_grants",
    "source_authorized",
    "provider_authorized",
    "release_authorized",
    "serving_authorized",
    "deployment_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.package-integrity-report"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "rule_id": {
      "const": "HKREG-PACKAGE-INTEGRITY-001"
    },
    "case_id": {
      "type": "string",
      "pattern": "^HKREG-DET-PKG-(0[0-2][0-9]|03[0-8])$"
    },
    "assertion_scope": {
      "enum": [
        "COMPLETE_PACKAGE",
        "CLOSED_SCHEMA",
        "ARTIFACT_HASH",
        "DECLARED_ACCESS",
        "REQUIRED_FILE",
        "ABSOLUTE_PATH",
        "NORMALIZED_PATH",
        "SYMLINK",
        "REMOTE_RESOURCE",
        "EXPLICIT_INVENTORY",
        "AVAILABLE_INPUT",
        "DELIBERATE_ABSENCE",
        "UNREADABLE_INPUT",
        "AVAILABLE_FACT_CONDITION",
        "EXACT_OUTPUT",
        "ZERO_OUTPUT",
        "NOT_APPLICABLE_OUTPUT",
        "MATRIX_COMPLETENESS",
        "PAIR_COMPLETENESS",
        "PROPOSAL_ISOLATION",
        "IMMUTABLE_FINGERPRINT",
        "REPRODUCIBILITY",
        "HOSTILE_SOURCE_TEXT",
        "LOCAL_CAPABILITY_DENIAL",
        "EXTERNAL_CAPABILITY_DENIAL",
        "AUTHORITY_CONTAINMENT",
        "ATTESTATION_COMPATIBILITY",
        "MEDIA_AND_PERMISSION"
      ]
    },
    "observed_outcome": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "observed_reason": {
      "enum": [
        "PACKAGE_VALID",
        "CLOSED_SCHEMA_VIOLATION",
        "ARTIFACT_HASH_MISMATCH",
        "UNDECLARED_FILE_ACCESS",
        "REQUIRED_FILE_ABSENT",
        "PATH_CONTAINMENT_INVALID",
        "SYMLINK_FORBIDDEN",
        "REMOTE_RESOURCE_FORBIDDEN",
        "DYNAMIC_DISCOVERY_FORBIDDEN",
        "INPUT_AVAILABLE_ADMITTED",
        "INPUT_AVAILABLE_INVALID",
        "DELIBERATE_ABSENCE_ADMITTED",
        "UNREADABLE_CONDITION_ADMITTED",
        "AVAILABLE_FACT_CONDITION_ADMITTED",
        "EXACT_ARTIFACT_MATCHED",
        "EXPECTED_EXACT_INVALID",
        "ZERO_OUTPUT_PROVED",
        "ZERO_OUTPUT_PROOF_INVALID",
        "NOT_APPLICABLE_PROVED",
        "NOT_APPLICABLE_INVALID",
        "MATRIX_COMPLETE",
        "MATRIX_INCOMPLETE",
        "PAIR_COMPLETE",
        "PAIR_INCOMPLETE",
        "PROPOSAL_PACKET_CLEAN",
        "PROPOSAL_TRUTH_LEAKAGE",
        "FINGERPRINT_OR_TRUTH_MUTATION",
        "REPRODUCIBLE",
        "REPRODUCIBILITY_FAILURE",
        "HOSTILE_TEXT_INERT",
        "HOSTILE_INPUT_CONTROL_BREACH",
        "FORBIDDEN_CAPABILITY_ATTEMPT",
        "PACKAGE_VALIDITY_ONLY",
        "BUILD_COMPATIBILITY_ONLY",
        "AUTHORITY_BROADENING",
        "ATTESTATION_MISMATCH",
        "MEDIA_OR_PERMISSION_INVALID"
      ]
    },
    "expected_outcome": {
      "enum": [
        "ACCEPTED",
        "REJECTED"
      ]
    },
    "expected_reason": {
      "enum": [
        "PACKAGE_VALID",
        "CLOSED_SCHEMA_VIOLATION",
        "ARTIFACT_HASH_MISMATCH",
        "UNDECLARED_FILE_ACCESS",
        "REQUIRED_FILE_ABSENT",
        "PATH_CONTAINMENT_INVALID",
        "SYMLINK_FORBIDDEN",
        "REMOTE_RESOURCE_FORBIDDEN",
        "DYNAMIC_DISCOVERY_FORBIDDEN",
        "INPUT_AVAILABLE_ADMITTED",
        "INPUT_AVAILABLE_INVALID",
        "DELIBERATE_ABSENCE_ADMITTED",
        "UNREADABLE_CONDITION_ADMITTED",
        "AVAILABLE_FACT_CONDITION_ADMITTED",
        "EXACT_ARTIFACT_MATCHED",
        "EXPECTED_EXACT_INVALID",
        "ZERO_OUTPUT_PROVED",
        "ZERO_OUTPUT_PROOF_INVALID",
        "NOT_APPLICABLE_PROVED",
        "NOT_APPLICABLE_INVALID",
        "MATRIX_COMPLETE",
        "MATRIX_INCOMPLETE",
        "PAIR_COMPLETE",
        "PAIR_INCOMPLETE",
        "PROPOSAL_PACKET_CLEAN",
        "PROPOSAL_TRUTH_LEAKAGE",
        "FINGERPRINT_OR_TRUTH_MUTATION",
        "REPRODUCIBLE",
        "REPRODUCIBILITY_FAILURE",
        "HOSTILE_TEXT_INERT",
        "HOSTILE_INPUT_CONTROL_BREACH",
        "FORBIDDEN_CAPABILITY_ATTEMPT",
        "PACKAGE_VALIDITY_ONLY",
        "BUILD_COMPATIBILITY_ONLY",
        "AUTHORITY_BROADENING",
        "ATTESTATION_MISMATCH",
        "MEDIA_OR_PERMISSION_INVALID"
      ]
    },
    "conformance_status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "package_valid": {
      "type": "boolean"
    },
    "external_state_mutated": {
      "type": "boolean"
    },
    "authority_grants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_authorized": {
      "const": false
    },
    "provider_authorized": {
      "const": false
    },
    "release_authorized": {
      "const": false
    },
    "serving_authorized": {
      "const": false
    },
    "deployment_authorized": {
      "const": false
    },
    "external_effects": {
      "const": "NONE"
    }
  }
}
