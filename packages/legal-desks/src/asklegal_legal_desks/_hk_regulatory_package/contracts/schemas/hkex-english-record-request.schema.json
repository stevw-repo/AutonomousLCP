{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/contracts/hk-regulatory/hkex-english-record-request/1.0.0",
  "title": "HKEX English record construction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tree", "profile", "effective_context"],
  "properties": {
    "effective_context": {"type": ["string", "null"], "minLength": 1},
    "profile": {"$ref": "#/$defs/profile"},
    "tree": {"$ref": "#/$defs/tree"}
  },
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_fingerprint",
        "tokenizer_id",
        "max_text_tokens",
        "max_metadata_bytes",
        "country",
        "jurisdiction",
        "material_type",
        "source",
        "authority_note"
      ],
      "properties": {
        "profile_id": {"$ref": "#/$defs/nonempty"},
        "profile_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "tokenizer_id": {"$ref": "#/$defs/nonempty"},
        "max_text_tokens": {"type": "integer", "minimum": 1},
        "max_metadata_bytes": {"type": "integer", "minimum": 1},
        "country": {"$ref": "#/$defs/nonempty"},
        "jurisdiction": {"$ref": "#/$defs/nonempty"},
        "material_type": {"$ref": "#/$defs/nonempty"},
        "source": {"$ref": "#/$defs/nonempty"},
        "authority_note": {"$ref": "#/$defs/nonempty"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "official_heading"],
      "properties": {
        "locator": {"$ref": "#/$defs/nonempty"},
        "official_heading": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "record_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_unit_id",
        "primary_source_unit_ids",
        "dependency_source_unit_ids",
        "referenced_locations",
        "child_record_unit_ids",
        "source_contract_state",
        "indivisible"
      ],
      "properties": {
        "record_unit_id": {"$ref": "#/$defs/nonempty"},
        "primary_source_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "dependency_source_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "referenced_locations": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "child_record_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "source_contract_state": {"enum": ["SUPPORTED", "UNKNOWN"]},
        "indivisible": {"type": "boolean"}
      }
    },
    "source_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_unit_id",
        "parent_source_unit_id",
        "child_source_unit_ids",
        "source_order",
        "kind",
        "role",
        "text",
        "source_range",
        "required_context_unit_ids",
        "meaning_bearing",
        "content_fingerprint"
      ],
      "properties": {
        "source_unit_id": {"$ref": "#/$defs/nonempty"},
        "parent_source_unit_id": {"type": ["string", "null"], "minLength": 1},
        "child_source_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "source_order": {"type": "integer", "minimum": 0},
        "kind": {
          "enum": [
            "HEADING",
            "LOCATOR",
            "BODY_TEXT",
            "LEAD_IN",
            "DEFINITION_TERM",
            "DEFINITION_TEXT",
            "QUALIFICATION",
            "EXCEPTION",
            "PROVISO",
            "TRANSITION_TEXT",
            "SCOPE_TEXT",
            "INCORPORATED_NOTE",
            "TABLE_CAPTION",
            "TABLE_HEADER",
            "TABLE_ROW",
            "TABLE_UNIT",
            "TABLE_NOTE",
            "FORM_INSTRUCTION",
            "FORM_LABEL",
            "FORM_CONTROL",
            "FORM_DECLARATION",
            "FEE_CATEGORY",
            "FEE_AMOUNT",
            "FEE_BASIS",
            "FEE_TIMING",
            "CROSS_REFERENCE",
            "PRESENTATION"
          ]
        },
        "role": {"enum": ["PRIMARY", "CONTEXT_ONLY", "PRESENTATION_ONLY"]},
        "text": {"$ref": "#/$defs/nonempty"},
        "source_range": {"$ref": "#/$defs/nonempty"},
        "required_context_unit_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "meaning_bearing": {"type": "boolean"},
        "content_fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "tree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tree_id",
        "component_id",
        "scope_id",
        "branch_id",
        "branch_state",
        "component_class",
        "component_label",
        "location_label",
        "official_heading",
        "root_source_unit_id",
        "source_units",
        "root_record_unit_ids",
        "record_units",
        "source_rule_id",
        "source_artifact_fingerprints"
      ],
      "properties": {
        "tree_id": {"$ref": "#/$defs/nonempty"},
        "component_id": {"$ref": "#/$defs/nonempty"},
        "scope_id": {"enum": ["HK-REG-HKEX-GEM", "HK-REG-HKEX-MAIN-BOARD"]},
        "branch_id": {"$ref": "#/$defs/nonempty"},
        "branch_state": {
          "enum": [
            "CURRENT",
            "TRANSITIONAL_CURRENT",
            "FUTURE_FIXED_DATE",
            "FUTURE_CONDITIONAL",
            "SUPERSEDED",
            "WITHDRAWN",
            "UNKNOWN"
          ]
        },
        "component_class": {
          "enum": [
            "ORDINARY_RULE",
            "DEFINITION_RULE",
            "APPENDIX",
            "PRACTICE_NOTE",
            "TABLE",
            "FEES_RULE",
            "REGULATORY_FORM"
          ]
        },
        "component_label": {"$ref": "#/$defs/nonempty"},
        "location_label": {"$ref": "#/$defs/nonempty"},
        "official_heading": {"type": ["string", "null"], "minLength": 1},
        "root_source_unit_id": {"$ref": "#/$defs/nonempty"},
        "source_units": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/source_unit"}
        },
        "root_record_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/nonempty"}
        },
        "record_units": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/record_unit"}
        },
        "source_rule_id": {"const": "HKREG-ENGLISH-RECORD-001"},
        "source_artifact_fingerprints": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fingerprint"}
        }
      }
    }
  }
}
