{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ask.legal/schemas/hkex-coverage-decision-catalogue.schema.json",
  "title": "HKEX source-unit coverage executable catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "catalogue_id",
    "catalogue_version",
    "status",
    "case_count",
    "primary_coverage_cell_count",
    "high_risk_pair_ids",
    "entries",
    "checkpoint_complete",
    "full_conformance_suite_complete",
    "activation_authorized",
    "external_effects"
  ],
  "properties": {
    "schema_id": {
      "const": "asklegal.hk-regulatory.coverage-decision-catalogue"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "catalogue_id": {
      "const": "hk-regulatory-coverage-decision"
    },
    "catalogue_version": {
      "const": "1.0.0"
    },
    "status": {
      "const": "FROZEN_EXECUTABLE_CHECKPOINT"
    },
    "case_count": {
      "const": 20
    },
    "primary_coverage_cell_count": {
      "const": 20
    },
    "high_risk_pair_ids": {
      "const": [
        "HKREG-PAIR-041",
        "HKREG-PAIR-042",
        "HKREG-PAIR-043",
        "HKREG-PAIR-044",
        "HKREG-PAIR-045"
      ]
    },
    "entries": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "primary_coverage_cell_id",
          "pair_memberships",
          "assertion_scope",
          "expected_outcome",
          "expected_reason",
          "fixture_path",
          "fixture_fingerprint",
          "expected_path",
          "expected_fingerprint"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "primary_coverage_cell_id": {
            "type": "string",
            "minLength": 1
          },
          "pair_memberships": {
            "type": "array",
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pair_id",
                "role"
              ],
              "properties": {
                "pair_id": {
                  "type": "string",
                  "pattern": "^HKREG-PAIR-0(41|42|43|44|45)$"
                },
                "role": {
                  "enum": [
                    "POSITIVE",
                    "NEAR_MISS"
                  ]
                }
              }
            }
          },
          "assertion_scope": {
            "enum": [
              "PRIMARY_OWNERSHIP",
              "BLOCKED_REQUIRED",
              "REPEATED_DEPENDENCY",
              "EXPLICIT_CLASSIFICATION",
              "COMPLEX_ELEMENTS",
              "NONCURRENT_OUTCOMES",
              "ORDER_AND_BOARD",
              "MISSING_UNIT",
              "DUPLICATE_PRIMARY",
              "REORDERED_PRIMARY",
              "ORPHAN_OUTPUT",
              "WRONG_BOARD",
              "DEPENDENCY_BINDING",
              "SOURCE_FIDELITY",
              "BOARD_READY",
              "QUARANTINED_CURRENT",
              "BOARD_ISOLATION",
              "SHARED_GAP",
              "WEAK_PROXY",
              "ZERO_OUTPUT"
            ]
          },
          "expected_outcome": {
            "enum": [
              "PASS",
              "INVALID",
              "COMPLETE_NOT_READY"
            ]
          },
          "expected_reason": {
            "enum": [
              "COMPLETE_PRIMARY_OWNERSHIP",
              "REQUIRED_UNIT_EXPLICITLY_BLOCKED",
              "DEPENDENCY_REPETITION_ACCOUNTED",
              "CLASSIFICATIONS_ACCOUNTED",
              "COMPLEX_ELEMENTS_ACCOUNTED",
              "NONCURRENT_OUTCOMES_ACCOUNTED",
              "ORDER_AND_BOARD_PROVED",
              "MISSING_SOURCE_UNIT",
              "DUPLICATE_PRIMARY_OWNER",
              "SOURCE_ORDER_CHANGED",
              "ORPHANED_OUTPUT",
              "WRONG_BOARD_OWNER",
              "DEPENDENCY_BINDING_INCOMPLETE",
              "SOURCE_FIDELITY_CHANGED",
              "BOARD_READY_FOR_LATER_GATES",
              "COMPLETE_BUT_BOARD_NOT_READY",
              "BOARDS_INDEPENDENT",
              "SHARED_GAP_BLOCKS_BOTH",
              "WEAK_PROXY_REJECTED",
              "VALID_ZERO_OUTPUT"
            ]
          },
          "fixture_path": {
            "type": "string",
            "minLength": 1
          },
          "fixture_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "expected_path": {
            "type": "string",
            "minLength": 1
          },
          "expected_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    "checkpoint_complete": {
      "const": true
    },
    "full_conformance_suite_complete": {
      "const": false
    },
    "activation_authorized": {
      "const": false
    },
    "external_effects": {
      "const": "NONE"
    }
  }
}
